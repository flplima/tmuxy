#!/bin/sh
set -e

# Pre-commit: format what is staged, and the fast checks. Type checks and
# clippy are the pre-push hook's (once per push, not once per commit), and
# both hooks and CI's lint job run the same list — bin/lint-gate.

# Snapshot what is staged BEFORE any formatter runs, so that what goes back
# into the index is a formatter's rewrite of a file the author staged, and
# nothing else: not an unrelated work in progress elsewhere in the tree, and
# not the hunks the author held back from a file staged in part.
#
# Formatting a staged file creates unstaged changes, after which every file
# would look partially staged, so the lists are taken first. A partially
# staged file's working copy is fingerprinted too: it differs from the index
# already, and only the fingerprint tells a formatter's rewrite from that.
HOOK_TMP=$(mktemp -d)
trap 'rm -rf "$HOOK_TMP"' EXIT
git diff --cached --name-only --diff-filter=ACM | LC_ALL=C sort > "$HOOK_TMP/staged"
git diff --name-only | LC_ALL=C sort > "$HOOK_TMP/unstaged"
LC_ALL=C comm -12 "$HOOK_TMP/staged" "$HOOK_TMP/unstaged" > "$HOOK_TMP/partial"
while IFS= read -r f; do
  printf '%s %s\n' "$(git hash-object -- "$f")" "$f"
done < "$HOOK_TMP/partial" > "$HOOK_TMP/partial-before"

# Prettier, eslint --fix and cargo fmt over everything the gate owns.
bin/lint-gate format

# A fully staged file that differs from the index now was rewritten by a
# formatter: re-stage it. A partially staged one never is — that would commit
# the very hunks the author kept back — so say so instead and let them decide.
git diff --name-only | LC_ALL=C sort > "$HOOK_TMP/rewritten"
LC_ALL=C comm -12 "$HOOK_TMP/staged" "$HOOK_TMP/rewritten" \
  | LC_ALL=C comm -23 - "$HOOK_TMP/partial" \
  | while IFS= read -r f; do git add -- "$f"; done
while read -r hash f; do
  if [ "$(git hash-object -- "$f")" != "$hash" ]; then
    echo "  ! $f is partially staged and was reformatted — left alone."
    echo "    Re-stage the formatting yourself if you want it in this commit."
  fi
done < "$HOOK_TMP/partial-before"

# Run only the unit tests related to the staged tmuxy-ui changes. `vitest
# related` runs a staged test file directly and any tests that transitively
# import a staged source file, so this stays correct while being much faster
# than the full suite. CI still runs the entire suite, so this is purely a
# local speed-up — a miss here is caught there.
CHANGED_UI=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^packages/tmuxy-ui/src/.*\.(ts|tsx)$' \
  | sed 's#^packages/tmuxy-ui/##' || true)
if [ -n "$CHANGED_UI" ]; then
  echo "Running unit tests related to staged changes..."
  # shellcheck disable=SC2086
  (cd packages/tmuxy-ui && npx vitest related --run $CHANGED_UI)
else
  echo "No staged tmuxy-ui source/test changes — skipping unit tests."
fi

# The 5,000-token file cap and the other repo policies, on what is staged.
bin/lint-gate check policy
