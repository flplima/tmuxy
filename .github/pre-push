#!/bin/sh
set -e

# Pre-push: the lint gate, read-only — the same list CI's `lint` job runs
# (bin/lint-gate), so a green hook is a green job.
#
# pre-commit deliberately stays fast — it formats only what is staged and runs
# only the unit tests related to it. Type checks and clippy with -D warnings
# are here: once per push rather than once per commit, and the last moment a
# failure is still cheap. Those two accounted for every avoidable red run
# before the hook existed (clippy 6x, tsc 2x): the work was already pushed
# before anything told the author.
#
# A full `bin/lint-gate check` that passed on a clean tree stamps that tree, so
# a push of a commit whose tree is stamped (the same tree checked earlier, by
# an earlier push or by `npm run check:fast`) skips the gate. Git hands this
# hook the refs being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# TMUXY_SKIP_PREPUSH=1 git push  — escape hatch for a genuine emergency.

if [ -n "$TMUXY_SKIP_PREPUSH" ]; then
  echo "pre-push: skipped (TMUXY_SKIP_PREPUSH set)."
  exit 0
fi

# Run by hand, with no refs on stdin: check the checked-out commit.
if [ -t 0 ]; then
  bin/lint-gate check
  echo "pre-push: OK"
  exit 0
fi

zero=$(printf '%040d' 0)
shas=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # A delete pushes no tree (SHA-256 repos use a longer all-zero id).
  case "$local_sha" in
    "" | "$zero") continue ;;
  esac
  [ "$local_sha" = "$(printf '%064d' 0)" ] && continue
  shas="$shas $local_sha"
done

if [ -z "$shas" ]; then
  echo "pre-push: nothing to check (no commit is being pushed)."
  exit 0
fi

# shellcheck disable=SC2086
if bin/lint-gate stamped $shas; then
  echo "pre-push: lint gate skipped, every pushed tree already passed it."
  exit 0
fi

head_tree=$(git rev-parse 'HEAD^{tree}')
for sha in $shas; do
  if bin/lint-gate stamped "$sha"; then continue; fi
  if [ "$(git rev-parse --verify --quiet "$sha^{tree}")" = "$head_tree" ]; then
    echo "pre-push: running the lint gate on the checked-out tree."
    bin/lint-gate check
  else
    echo "pre-push: running the lint gate on $sha, which is not the checked-out commit."
    bin/lint-gate check-sha "$sha"
  fi
done

echo "pre-push: OK"
