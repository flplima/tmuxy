#!/bin/sh
set -e

# Pre-push: the lint gate, read-only — the same list CI's `lint` job runs
# (bin/lint-gate), so a green hook is a green job.
#
# pre-commit deliberately stays fast — it formats and runs only the unit tests
# related to what is staged. Type checks and clippy with -D warnings are here:
# once per push rather than once per commit, and the last moment a failure is
# still cheap. Those two accounted for every avoidable red run before the hook
# existed (clippy 6x, tsc 2x): the work was already pushed before anything
# told the author.
#
# TMUXY_SKIP_PREPUSH=1 git push  — escape hatch for a genuine emergency.

if [ -n "$TMUXY_SKIP_PREPUSH" ]; then
  echo "pre-push: skipped (TMUXY_SKIP_PREPUSH set)."
  exit 0
fi

bin/lint-gate check

echo "pre-push: OK"
