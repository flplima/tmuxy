#!/usr/bin/env bash
# tmuxy — AI-first noun-verb CLI for tmux
#
# Safety: All mutating commands route through `tmux run-shell` to avoid
# crashing tmux 3.3a–3.5a when control mode is attached.
# Read-only commands run as direct subprocesses (safe with control mode).

set -euo pipefail

SELF="$0"
if [ -L "$SELF" ]; then
  SELF="$(readlink -f "$SELF")"
fi
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")/tmuxy" && pwd)"

TMUXY_VERSION="${TMUXY_VERSION:-}"
if [ -z "$TMUXY_VERSION" ] && [ -f "$REPO_ROOT/package.json" ]; then
  TMUXY_VERSION=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$REPO_ROOT/package.json" 2>/dev/null || true)
fi
TMUXY_VERSION="${TMUXY_VERSION:-0.0.10-alpha.68}"

# --- Helpers ---

# Socket resolution (explicit TMUX_SOCKET, else the socket of the server whose
# pane we are in, else the dedicated `tmuxy` socket — never the user's default
# tmux server), `_tmux`/`_run_safe` and `shquote` are shared with the
# bin/tmuxy scripts, so they live in their `_lib`. Every tmux call in this
# script goes through `_tmux`, every mutation through `_run_safe`. `_lib`
# resolves SCRIPTS_DIR from its own `$0` (this file, not the scripts
# directory), so restore ours afterwards.
source "$SCRIPTS_DIR/_lib"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")/tmuxy" && pwd)"

# Where a target-less command lands. Inside a pane, tmux reads the caller's
# $TMUX_PANE and every `splitw`, `breakp` and `#{pane_id}` resolves from it.
# From OUTSIDE (a script, a test, an SSH agent) an unattached client has no
# pane, and tmux falls back to the session with the LATEST activity — which,
# right after `pane group add` has parked a member in the hidden
# `__tmuxy_stash` session, is the stash: the next `tab create` or `pane
# send` would land where no client can see it. Resolving the pane here,
# once, with the same preference the server has (an attached real session,
# else the first real one) hands tmux an answer it honours for an unattached
# client the way it does for a pane's own — and `_run_safe` passes it on to
# the client it spawns inside run-shell. Read-only, and skipped when there
# is no server to ask.
if [ -z "${TMUX_PANE:-}" ]; then
  _outside_pane="$(_tmux list-panes -a \
    -f '#{&&:#{window_active},#{pane_active}}' \
    -F '#{session_attached}	#{session_name}	#{pane_id}' 2>/dev/null \
    | awk -F'\t' '$2 != "__tmuxy_stash" { if ($1 > 0) { print $3; exit } ; if (!first) first = $3 } END { if (first) print first }' \
    | head -1 || true)"
  if [ -n "$_outside_pane" ]; then
    TMUX_PANE="$_outside_pane"
    export TMUX_PANE
  fi
fi

# --- JSON output helpers ---
#
# Free-text tmux fields (window names, pane commands) can contain commas and
# quotes, so the --json serializers use a tab separator and escape the values.
# `pane_title` is filtered against the host name because tmux seeds every
# pane's title with it — same expression as tmux_formats::APP_PANE_TITLE in
# packages/tmuxy-core/src/constants.rs; keep the two in step.
APP_PANE_TITLE_FMT='#{?#{==:#{pane_title},#{host}},,#{pane_title}}'
LIST_PANES_JSON_FMT=$'#{pane_id}\t#{window_id}\t#{pane_width}\t#{pane_height}\t#{pane_current_command}\t#{pane_active}\t'"$APP_PANE_TITLE_FMT"
LIST_WINDOWS_JSON_FMT=$'#{window_id}\t#{window_index}\t#{window_name}\t#{window_panes}\t#{window_active}\t#{@tmuxy-window-type}'
JSON_ESCAPE_AWK='function jstr(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\n/, "\\n", s); gsub(/\r/, "\\r", s); gsub(/\t/, "\\t", s); return s } '

# Find tmuxy-server binary: PATH first, then cargo target directory
find_server_binary() {
  if command -v tmuxy-server &>/dev/null; then
    echo "tmuxy-server"
  elif [ -x "$REPO_ROOT/target/debug/tmuxy-server" ]; then
    echo "$REPO_ROOT/target/debug/tmuxy-server"
  elif [ -x "$REPO_ROOT/target/release/tmuxy-server" ]; then
    echo "$REPO_ROOT/target/release/tmuxy-server"
  else
    echo "Error: tmuxy-server binary not found. Run 'cargo build -p tmuxy-server' first." >&2
    exit 1
  fi
}

# --- Config ---

# Where tmuxy keeps its config and state. Mirrors tmuxy-core's config_dir().
tmuxy_config_dir() {
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/tmuxy"
}

# Read one boolean out of tmuxy.state.json without a JSON parser: the file is
# written by serde_json's pretty printer, so a key sits on its own line.
state_bool() {
  local key="$1" file
  file="$(tmuxy_config_dir)/tmuxy.state.json"
  [ -f "$file" ] || return 1
  grep -q "\"$key\": true" "$file"
}

cmd_config() {
  local setting="${1:-}"
  case "$setting" in
    use-tmux-conf)
      shift
      cmd_config_use_tmux_conf "$@"
      ;;
    ""|--help|-h)
      cat <<'EOF'
Usage: tmuxy config <setting> [value]

Settings:
  use-tmux-conf [on|off]   Source your own ~/.tmux.conf on tmuxy's socket.
                           With no value, prints the current setting.

With `use-tmux-conf on`, tmuxy sources ~/.tmux.conf and then re-applies
tmuxy.essentials.conf on top: your prefix, status line and plugins win over
tmuxy's defaults, and the settings tmuxy needs to function are restored
afterwards whatever your config did to them.

Takes effect on the next tmux server start for that socket — the config chain
is read when the server starts, so restart tmuxy (or `tmuxy server stop`) after
changing it.
EOF
      ;;
    *)
      echo "Unknown config setting: $setting" >&2
      echo "Hint: tmuxy config --help" >&2
      return 1
      ;;
  esac
}

cmd_config_use_tmux_conf() {
  local dir state_file value="${1:-}"
  dir="$(tmuxy_config_dir)"
  state_file="$dir/tmuxy.state.json"

  if [ -z "$value" ]; then
    if state_bool use_tmux_conf; then
      echo "use-tmux-conf: on  (~/.tmux.conf is sourced, then tmuxy.essentials.conf on top)"
    else
      echo "use-tmux-conf: off (tmuxy uses its own config only)"
    fi
    return 0
  fi

  case "$value" in
    on|true|1) value=true ;;
    off|false|0) value=false ;;
    *)
      echo "Usage: tmuxy config use-tmux-conf [on|off]" >&2
      return 1
      ;;
  esac

  mkdir -p "$dir"
  # Rewrite the one key, preserving everything else in the file. node is not a
  # dependency of the CLI, so this is done with the tools a shell always has.
  if [ -f "$state_file" ]; then
    if grep -q '"use_tmux_conf"' "$state_file"; then
      # -E: BSD sed has no \| alternation in a basic regex, and silently
      # matches nothing rather than erroring — which read as "off does not work".
      sed -i.bak -E "s/(\"use_tmux_conf\": )(true|false)/\1$value/" "$state_file"
      rm -f "$state_file.bak"
    else
      # Insert after the opening brace so the file stays valid JSON.
      sed -i.bak "1s/^{/{\n  \"use_tmux_conf\": $value,/" "$state_file"
      rm -f "$state_file.bak"
    fi
  else
    printf '{\n  "use_tmux_conf": %s\n}\n' "$value" > "$state_file"
  fi

  if [ "$value" = true ]; then
    echo "use-tmux-conf: on — tmuxy will source ~/.tmux.conf, then re-apply its essentials."
  else
    echo "use-tmux-conf: off — tmuxy will use its own config only."
  fi
  echo "Restart tmuxy for this to take effect (the config chain is read at tmux server start)."
}

# --- Info & Skill ---

cmd_info() {
  local json=false
  for arg in "$@"; do
    case "$arg" in
      --help|-h) echo "Usage: tmuxy info [--json]"; return ;;
      --json) json=true ;;
    esac
  done

  local inside=false
  if [ -n "${TMUX:-}" ]; then
    inside=true
  fi

  if ! $inside; then
    local server_running=false
    if _tmux has-session 2>/dev/null; then
      server_running=true
    fi
    if $json; then
      printf '{"inside":false,"socket":"%s","serverRunning":%s,"version":"%s","agentSkillHint":"Run '\''%s skill'\'' to view the agent instruction guide"}\n' \
        "$TMUX_SOCKET" "$server_running" "$TMUXY_VERSION" "tmuxy"
    else
      echo "tmuxy $TMUXY_VERSION"
      if $server_running; then
        echo "  Status: not inside a tmuxy session (server is running on socket '$TMUX_SOCKET')"
      else
        echo "  Status: not inside a tmuxy session (no server on socket '$TMUX_SOCKET')"
      fi
      echo "  Tip:    Run 'tmuxy gui' to open the desktop app, or 'tmuxy connect' to attach."
      echo ""
      echo "Agent Guide:"
      echo "  • Run 'tmuxy skill' to print the full agent instructions & safety rules."
      echo "  • Run 'tmuxy --json' for machine-readable state."
    fi
    return
  fi

  # Inside session — read session, active pane, and active window in one display-message call
  local fmt=$'#{session_name}\t#{pane_id}\t#{window_id}\t#{pane_width}\t#{pane_height}\t#{pane_current_command}\t#{window_index}\t#{window_name}\t#{window_panes}'
  local info_line
  info_line=$(_tmux display-message -p "$fmt" 2>/dev/null || true)

  local session_name pane_id window_id pane_width pane_height pane_cmd window_index window_name window_panes
  IFS=$'\t' read -r session_name pane_id window_id pane_width pane_height pane_cmd window_index window_name window_panes <<< "$info_line"

  if $json; then
    printf '{"inside":true,"socket":"%s","session":"%s","activePane":{"id":"%s","width":%s,"height":%s,"command":"%s"},"activeTab":{"id":"%s","index":%s,"name":"%s","panesCount":%s},"version":"%s","agentSkillHint":"Run '\''%s skill'\'' to view the full agent instruction guide and safety rules"}\n' \
      "$TMUX_SOCKET" "${session_name:-}" "${pane_id:-}" "${pane_width:-0}" "${pane_height:-0}" "${pane_cmd:-}" \
      "${window_id:-}" "${window_index:-0}" "${window_name:-}" "${window_panes:-0}" "$TMUXY_VERSION" "tmuxy"
  else
    echo "tmuxy $TMUXY_VERSION (socket: $TMUX_SOCKET, session: ${session_name:-$TMUX_SOCKET})"
    echo "  Status:  attached (control mode active)"
    echo "  Pane:    ${pane_id:-%0} (${pane_width:-0}x${pane_height:-0}, ${pane_cmd:-shell})"
    echo "  Tab:     ${window_id:-@0} (name: \"${window_name:-tmuxy}\", ${window_panes:-1} pane)"
    echo ""
    echo "Agent Guide:"
    echo "  • Run 'tmuxy skill' to print the full agent instructions & safety rules."
    echo "  • Run 'tmuxy --json' for machine-readable state."
    echo "  • Warning: Do NOT run raw mutating tmux commands (use 'tmuxy pane/tab/run')."
  fi
}

# The one copy of the agent guide. .agents/skills/tmuxy/SKILL.md is this text
# verbatim (a CLI test fails when they differ): an installed CLI has no repo to
# read the skill file from, so the heredoc is the source.
cmd_skill() {
  case "${1:-}" in
    --help|-h) echo "Usage: tmuxy skill"; return ;;
  esac
  cat <<'EOF'
---
name: tmuxy
description: Working inside tmuxy (web/desktop tmux interface). Covers tmuxy CLI, control-mode safety rules (never run mutating raw tmux commands), and pane/tab/widget operations.
---

# tmuxy

tmuxy is a web/desktop UI over a real tmux server. When running inside tmuxy, panes, tabs and floats are real UI surfaces you can drive from the shell, not just tmux abstractions.

## Am I inside tmuxy?

```sh
[ -n "$TMUX" ] && [ "$(basename "${TMUX%%,*}")" = "tmuxy" ]
```

`$TMUX` is `<socket-path>,<server-pid>,<session-id>`; the socket basename is `tmuxy` (or `tmuxy-dev`).

## Hard rules

1. **Never run a mutating raw `tmux` command.** External `tmux` mutations crash tmux
   3.3a–3.5a while control mode is attached. Route everything through the `tmuxy` CLI,
   which wraps mutations in `tmux run-shell`. Escape hatch: `tmuxy run <any tmux cmd>`.
2. **Read-only `tmux` is fine** as a direct subprocess (`display-message -p`,
   `list-panes`, `show-options -qv`).
3. **Never use `new-window`/`neww`** — it crashes tmux 3.5a. `tmuxy tab create` does
   `splitw ; breakp` instead.
4. Kill a stray float with `tmuxy pane kill %id`, never `tmux kill-window`.

## CLI cheat sheet

```sh
tmuxy                           # status and multiplexer info
tmuxy --json                    # machine-readable status
tmuxy skill                     # print this guide
tmuxy pane list --json          # id, tab, width, height, command, active (--all = every tab)
tmuxy pane split [-h|-v] [--json] # split pane (returns %id or JSON)
tmuxy pane float [opts] [cmd]   # open a float
tmuxy pane capture [%id] --json # read what's on a pane's screen
tmuxy pane send ls Enter        # type into a pane
tmuxy pane select -U|-D|-L|-R|%id # select pane
tmuxy pane kill [%id]           # close pane
tmuxy tab list --json           # tabs; also kill/select/next/prev/rename/layout
tmuxy tab create [name] [--json]# create tab (returns @id or JSON)
tmuxy pane group add            # group the current pane (members become header tabs)
tmuxy pane group join %id %m    # put %id in %m's group; also move, leave, switch, next, prev, close
tmuxy ask %id <keys...>         # type into another pane once the user confirms (blocks until answered)
tmuxy session save [name]       # snapshot a session; also restore <name>, snapshots, forget <name>
tmuxy open <file|url|host>      # show an HTML file, a site, a .md file or an image
tmuxy widget browser <file|url> # the same, spelled out
tmuxy queue push <name> <msg|-> # push to a named queue (alias: send; `tmuxy q` = `tmuxy queue`)
tmuxy queue pop <name>          # block and pop oldest message (also: peek, list, clear)
tmuxy run <tmux cmd>            # any tmux command, routed safely through run-shell
```
EOF
}

# --- Help ---

usage() {
  cat <<EOF
tmuxy $TMUXY_VERSION — AI-first terminal multiplexer

Usage: tmuxy <command> [args...]

Commands:
  info        Show multiplexer and session status [--json]
  skill       Show AI agent guide and safety rules
  pane        Manage panes (split, kill, select, resize, group, float)
  ask         Send keys to another pane, once the user has confirmed
  tab         Manage tabs (create, kill, select, rename, layout)
  session     Manage sessions (switch, connect, save, restore, snapshots, forget)
  nav         Navigate across groups, splits, and tabs
  open        Show a page, file or image in a browser pane (alias of widget browser)
  widget      Display widgets (browser, tree, session)
  queue, q    Inter-agent coordination queue (push/send, pop, peek, list, clear)
  tree        Browse tabs and panes as a tree in this terminal
  run         Run any tmux command safely
  browser     Drive a real browser, drawn in the pane (verbs, --repl)
  cleanup     Reap shells left hanging by a pane that died while starting up
  connect     Reconnect the desktop app to a different tmux server (socket)
  server      Production server operations
  trace       Inspect/export a local action-trace file (docs/TELEMETRY.md)
  config      Show or change a setting (use-tmux-conf)
  gui         Open the desktop GUI application

Options:
  -h, --help    Show this help
  -V, --version Show version
  --json        Output as JSON (with info or root command)

Note for AI/LLM agents:
  • Do NOT run raw mutating tmux commands (external new-window/split-window crash control mode).
  • Always route mutations through 'tmuxy pane/tab/run'.
  • Use --json on query commands for unambiguous, parseable output.
  • Run 'tmuxy skill' to print the full agent instruction guide.
EOF
}

usage_tree() {
  cat <<'EOF'
Usage: tmuxy tree

Open an interactive tree view of all tabs and their panes. Navigate with
j/k or the arrow keys, Enter (or a mouse click) to activate a tab/pane.
A standalone browser of tabs/panes, for a plain terminal. The left sidebar
renders the same tree as a React widget — see `tmuxy widget tree`.
EOF
}

usage_pane() {
  cat <<'EOF'
Usage: tmuxy pane <command> [args...]

Commands:
  list          List all panes [--json] [--all]
  split         Split current pane [-h|-v]
  kill          Kill a pane [%id]
  select        Select/focus a pane [-U|-D|-L|-R|%id]
  resize        Resize a pane [-U|-D|-L|-R] [n]
  swap          Swap two panes <src> <dst>
  zoom          Toggle pane zoom
  break         Break pane into own tab
  capture       Capture pane content [%id] [--json]
  send          Send keys to pane <keys...>
  state         Declare what the pane is doing <state> [%id]
  restore-cmd   Say how to bring the pane back after a restore '<command>' [%id]
  paste         Paste text into pane <text>
  float         Create a float pane [cmd args...]
  group         Pane group operations (add, close, switch, next, prev, move, join, leave)

Run 'tmuxy pane <command> --help' for details.
EOF
}

usage_pane_group() {
  cat <<'EOF'
Usage: tmuxy pane group <command> [args...]

Commands:
  add           Add current pane to a group
  close         Close pane from group [%id]
  switch        Switch to pane in group <%id>
  next          Next pane in group
  prev          Previous pane in group
  move          Move a member to another place in its group <%id> <index>
  join          Make a pane a member of another pane's group <%id> <%member> [index]
  leave         Take a member out of its group [%id] [--tab | --beside <%id> <dir>]
EOF
}

