#!/usr/bin/env bash
# tmuxy — AI-first noun-verb CLI for tmux
#
# Safety: All mutating commands route through `tmux run-shell` to avoid
# crashing tmux 3.3a–3.5a when control mode is attached.
# Read-only commands run as direct subprocesses (safe with control mode).

set -euo pipefail

SELF="$0"
if [ -L "$SELF" ]; then
  SELF="$(readlink -f "$SELF")"
fi
# An agent hook runs on every tool call: straight to its script, before any
# of the set-up below.
if [ "${1:-}" = agent ] && [ "${2:-}" = hook ]; then
  shift 2
  exec "${SELF%/*}/tmuxy/agent-hook" "$@"
fi
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")/tmuxy" && pwd)"

TMUXY_VERSION="${TMUXY_VERSION:-}"
if [ -z "$TMUXY_VERSION" ] && [ -f "$REPO_ROOT/package.json" ]; then
  TMUXY_VERSION=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$REPO_ROOT/package.json" 2>/dev/null || true)
fi
TMUXY_VERSION="${TMUXY_VERSION:-0.1.0}"

# --- Helpers ---

# Socket resolution (explicit TMUX_SOCKET, else the socket of the server whose
# pane we are in, else the dedicated `tmuxy` socket — never the user's default
# tmux server), `_tmux`/`_run_safe`, `shquote` and `find_server_cmd` are
# shared with the bin/tmuxy scripts, so they live in their `_lib`. Every tmux call in this
# script goes through `_tmux`, every mutation through `_run_safe`. `_lib`
# resolves SCRIPTS_DIR from its own `$0` (this file, not the scripts
# directory), so restore ours afterwards.
source "$SCRIPTS_DIR/_lib"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")/tmuxy" && pwd)"

# Where a target-less command lands. Inside a pane, tmux reads the caller's
# $TMUX_PANE and every `splitw`, `breakp` and `#{pane_id}` resolves from it.
# From OUTSIDE (a script, a test, an SSH agent) an unattached client has no
# pane, and tmux falls back to the session with the LATEST activity — which,
# right after `pane group add` has parked a member in the hidden
# `__tmuxy_stash` session, is the stash: the next `tab create` or `pane
# send` would land where no client can see it. Resolving the pane here,
# once, with the same preference the server has (an attached real session,
# else the first real one) hands tmux an answer it honours for an unattached
# client the way it does for a pane's own — and `_run_safe` passes it on to
# the client it spawns inside run-shell. Read-only, and skipped when there
# is no server to ask. Never for `tmuxy agent`: an agent hook outside any
# tmuxy pane must change nothing, not some other pane's state.
# The caller's own pane, before that: `pane send` asks the user before typing
# into any other.
export TMUXY_CALLER_PANE="${TMUX_PANE:-}"
if [ -z "${TMUX_PANE:-}" ] && [ "${1:-}" != agent ]; then
  _outside_pane="$(_tmux list-panes -a \
    -f '#{&&:#{window_active},#{pane_active}}' \
    -F '#{session_attached}	#{session_name}	#{pane_id}' 2>/dev/null \
    | awk -F'\t' '$2 != "__tmuxy_stash" { if ($1 > 0) { print $3; exit } ; if (!first) first = $3 } END { if (first) print first }' \
    | head -1 || true)"
  if [ -n "$_outside_pane" ]; then
    TMUX_PANE="$_outside_pane"
    export TMUX_PANE
  fi
fi

# --- JSON output helpers ---
#
# Free-text tmux fields (window names, pane commands) can contain commas and
# quotes, so the --json serializers use a tab separator and escape the values.
# `pane_title` is filtered against the host name because tmux seeds every
# pane's title with it — same expression as tmux_formats::APP_PANE_TITLE in
# packages/tmuxy-core/src/constants.rs; keep the two in step.
APP_PANE_TITLE_FMT='#{?#{==:#{pane_title},#{host}},,#{pane_title}}'
LIST_PANES_JSON_FMT=$'#{pane_id}\t#{window_id}\t#{pane_width}\t#{pane_height}\t#{pane_current_command}\t#{pane_active}\t'"$APP_PANE_TITLE_FMT"
LIST_WINDOWS_JSON_FMT=$'#{window_id}\t#{window_index}\t#{window_name}\t#{window_panes}\t#{window_active}\t#{@tmuxy-window-type}'
JSON_ESCAPE_AWK='function jstr(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\n/, "\\n", s); gsub(/\r/, "\\r", s); gsub(/\t/, "\\t", s); return s } '

# --- Help ---

usage() {
  cat <<EOF
tmuxy $TMUXY_VERSION — AI-first terminal multiplexer

Usage: tmuxy <command> [args...]

Commands:
  info        Show multiplexer and session status [--json]
  skill       Show AI agent guide and safety rules
  agent       Show Claude Code / Codex / Antigravity state in tmuxy (install, uninstall, status)
  pane        Manage panes (split, kill, select, resize, group, float)
  tab         Manage tabs (create, kill, select, rename, layout)
  session     Manage sessions (switch, connect, save, restore, snapshots, forget)
  nav         Navigate across groups, splits, and tabs
  open        Show a page, file or image in a browser pane (alias of widget browser)
  widget      Display widgets (browser, tree, session)
  tree        Browse tabs and panes as a tree in this terminal
  run         Run any tmux command safely
  browser     Turn this pane into a browser: a real engine, drawn in the pane
  cleanup     Reap shells left hanging by a pane that died while starting up
  connect     Reconnect the desktop app to a different tmux server (socket)
  server      Production server operations
  trace       Inspect/export a local action-trace file (docs/TELEMETRY.md)
  config      Re-apply tmuxy.conf (reload) or change a setting (use-tmux-conf)
  gui         Open the desktop GUI application

Options:
  -h, --help    Show this help
  -V, --version Show version
  --json        Output as JSON (with info or root command)

Note for AI/LLM agents:
  • Do NOT run raw mutating tmux commands (external new-window/split-window crash control mode).
  • Always route mutations through 'tmuxy pane/tab/run'.
  • Use --json on query commands for unambiguous, parseable output.
  • Run 'tmuxy skill' to print the full agent instruction guide.
EOF
}

usage_tree() {
  cat <<'EOF'
Usage: tmuxy tree

Open an interactive tree view of all tabs and their panes. Navigate with
j/k or the arrow keys, Enter (or a mouse click) to activate a tab/pane.
A standalone browser of tabs/panes, for a plain terminal. The left sidebar
renders the same tree as a React widget — see `tmuxy widget tree`.
EOF
}

usage_pane() {
  cat <<'EOF'
Usage: tmuxy pane <command> [args...]

Commands:
  list          List all panes [--json] [--all]
  split         Split current pane [-h|-v]
  kill          Kill a pane [%id]
  select        Select/focus a pane [-U|-D|-L|-R|%id]
  resize        Resize a pane [-U|-D|-L|-R] [n]
  swap          Swap two panes <src> <dst>
  zoom          Toggle pane zoom
  break         Break pane into own tab
  capture       Capture pane content [%id] [--json]
  send          Send keys to pane <keys...>
  state         Declare what the pane is doing <state> [%id]
  restore-cmd   Say how to bring the pane back after a restore '<command>' [%id]
  paste         Paste text into pane <text>
  float         Create a float pane [cmd args...]
  group         Pane group operations (add, close, switch, next, prev, move, join, leave)

Run 'tmuxy pane <command> --help' for details.
EOF
}

usage_pane_group() {
  cat <<'EOF'
Usage: tmuxy pane group <command> [args...]

Commands:
  add           Add current pane to a group
  close         Close pane from group [%id]
  switch        Switch to pane in group <%id>
  next          Next pane in group
  prev          Previous pane in group
  move          Move a member to another place in its group <%id> <index>
  join          Make a pane a member of another pane's group <%id> <%member> [index]
  leave         Take a member out of its group [%id] [--tab | --beside <%id> <dir>]
EOF
}

usage_tab() {
  cat <<'EOF'
Usage: tmuxy tab <command> [args...]

Commands:
  list          List all tabs [--json]
  create        Create a new tab [name]
  kill          Kill a tab [@id]
  select        Switch to a tab <index|@id>
  next          Next tab
  prev          Previous tab
  rename        Rename current tab <name>
  layout        Change pane layout [next|even-h|even-v|main-h|main-v|tiled]
EOF
}

usage_widget() {
  cat <<'EOF'
Usage: tmuxy widget <command> [args...]

Commands:
  browser       Show a page: a local HTML file, a URL, a markdown file
                (rendered, with mermaid), or an image. `-` reads markdown
                from stdin. --color-filter recolours a page or an image
                into the theme's colours.
  tree          Display the tabs+panes tree (the left sidebar's content)
  session       Switch, rename, kill or detach the session; connect to
                another tmux socket, locally or over SSH
EOF
}

usage_session() {
  cat <<'EOF'
Usage: tmuxy session <command> [args...]

Commands:
  switch        Interactive session switcher [--float]
  connect       Connect to a server and attach <dest> [--socket NAME]
  save          Snapshot a session now [name] [--scrollback N]
  restore       Rebuild a session from its snapshot <name> [--run]
  snapshots     The sessions that have a snapshot, and whether they run
  forget        Delete a session's snapshots <name> [--force]

A session's shape — tabs, splits, floats, sidebars, groups, each pane's
directory and program — is saved on every change and brought back when the
server starts and the session is gone. Programs come back typed at the
prompt, not run; `--run` runs them. A pane says how to bring itself back with
`tmuxy pane restore-cmd '<command>'`.
EOF
}

usage_nav() {
  cat <<'EOF'
Usage: tmuxy nav <direction>

Directions:
  left        Previous group member → pane to the left → left sidebar
  right       Next group member → pane to the right → right sidebar
  up          Pane splits only (vertical)
  down        Pane splits only (vertical)
  next        Sequential forward (same as right)
  prev        Last pane, fall back to last window
EOF
}

usage_run() {
  cat <<'EOF'
Usage: tmuxy run <tmux-command> [args...]

Run any tmux command safely through run-shell.

Safety features:
  - new-window is intercepted → split-window + break-pane
  - resize-window is blocked (crashes control mode)
  - All other commands route through run-shell

Examples:
  tmuxy run swap-pane -s %0 -t %1
  tmuxy run new-window              # intercepted → safe alternative
  tmuxy run send-keys -t %3 ls Enter
EOF
}

usage_connect() {
  cat <<'EOF'
Usage: tmuxy connect [socket] [session]

With no arguments, opens the "add a server" form (a small TUI) to save a tmux
server — the local machine or a remote SSH host — to the desktop app's sidebar
server picker (stored in ~/.config/tmuxy/servers.json).

With a socket, reconnects the tmuxy DESKTOP APP to a different tmux server
without relaunching. `socket` is a socket name (in tmux's default dir, e.g.
`default` for your everyday tmux server) or a full socket path (containing a
slash). If `session` is omitted, the app attaches to the target server's first
existing session, or creates `tmuxy` if it has none.

This sets a request the running desktop app picks up. It has no effect in the
web UI (the web server's socket is fixed at launch).

Examples:
  tmuxy connect                      # open the add-a-server form
  tmuxy connect default              # attach to your everyday tmux server
  tmuxy connect default work         # ...to its "work" session specifically
  tmuxy connect /tmp/tmux-1000/foo   # attach to a socket by full path
EOF
}

source "$SCRIPTS_DIR/cli-info.sh"
source "$SCRIPTS_DIR/cli-pane.sh"
source "$SCRIPTS_DIR/cli-commands.sh"

# --- Main dispatcher ---

case "${1:-}" in
  pane)
    shift
    cmd_pane "$@"
    ;;
  tab)
    shift
    cmd_tab "$@"
    ;;
  session)
    shift
    cmd_session "$@"
    ;;
  nav)
    shift
    cmd_nav "$@"
    ;;
  widget)
    shift
    cmd_widget "$@"
    ;;
  open)
    shift
    case "${1:-}" in
      --help|-h)
        cat <<'OEOF'
Usage: tmuxy open [--color-filter] <file|url|host|->

Show a page in a browser pane: a local HTML, markdown or image file, a
website, or a host — `localhost:3000`, `192.168.1.10:8080` and
`example.com/docs` are read as addresses when no such file exists. `-`
renders markdown from stdin. The same as `tmuxy widget browser`.

A website opens in `tmuxy browser` — a real engine drawn in the pane, under
an address bar — so a site that refuses to be framed still shows. Files,
markdown and images are drawn by the app, in the theme.

Options:
  --color-filter  Recolour a page or an image into the theme's colours
  --resolve       Print what the target resolves to and open nothing
OEOF
        ;;
      "") echo "Error: file, url or host required" >&2; exit 1 ;;
      *) open_target "$@" ;;
    esac
    ;;
  tree)
    shift
    case "${1:-}" in
      --help|-h) usage_tree ;;
      *)
        # Standalone tree binary (v86 guest and other server-less installs)
        if command -v tmuxy-tree &>/dev/null; then
          exec tmuxy-tree "$@"
        fi
        find_server_cmd
        exec "${SERVER_CMD[@]}" tree "$@"
        ;;
    esac
    ;;
  browser)
    shift
    case "${1:-}" in
      --help | -h)
        cat <<'BEOF'
Usage: tmuxy browser [--session NAME] [--attach[=ENDPOINT]] [--color-filter]
                     [--viewport auto|desktop|mobile] [url]

Turn this pane into a browser: a real engine draws the page IN THE PANE as an
inline image, under the app's address bar (back, forward, refresh, the
address, page size, open externally). The mouse and keyboard reach the page. It shows
sites that refuse to be framed and works the same in the web UI and the
desktop app. `tmuxy open <website>` opens one too.

`:` opens a command line on the bottom row for the verbs below, whose output
prints there. Another pane or an agent drives it with
`tmuxy pane send -t %ID ':goto example.com' Enter` and reads the answer back
with `tmuxy pane capture` — no API needed. ctrl+c leaves.

The engine is your own Chrome/Chromium/Edge/Brave; tmuxy ships none. Set
TMUXY_CHROME to choose one.

Verbs (after `:`):
  goto <url>              navigate (a bare host gets a scheme)
  eval <js>               evaluate in the page and print the result
  click <selector>        click the first match
  type <selector> <text>  focus a selector and type
  wait <selector>         block until a selector exists
  text [selector]         the visible text of the page, or of one element
  title | url             the page's title or current URL
  shot [path]             save a PNG
  back | forward | reload history
  viewport auto|desktop|mobile  lay out for the pane, 1440x900 or 400x800
  repl [on|off]           show the verb log in the pane instead of the picture
                          (the toolbar's REPL button does the same); bare toggles

Options:
  --session NAME     Which session (default: one per pane); names the
                     throwaway profile, so one engine per name
  --attach[=ENDPOINT] Drive a browser that is already running, by DevTools
                     endpoint (`ws://...`, or `http://127.0.0.1:PORT`); bare,
                     it finds one: a profile's DevToolsActivePort, else a
                     listener on 127.0.0.1:9222. For the desktop app's own
                     browser, or for your REAL profile with its logins — which
                     Chrome 144+ exposes after the consent prompt at
                     chrome://inspect/#remote-debugging (older Chrome: start it
                     with --remote-debugging-port and a --user-data-dir). The
                     page is still drawn in the pane and still takes the mouse
                     and keys; the browser is left running when the pane
                     closes. Put the url BEFORE a bare --attach.
                     The picture is only meaningful when the server is the
                     machine with the screen: over SSH the browser is on the
                     server, and this pane is where you see it.
  --color-filter     Recolour the page into the theme's colours
  --viewport SIZE    What the page lays out for: auto (the pane, the
                     default), desktop (1440x900) or mobile (400x800)

In a pane, `TMUXY_CELL_PX=WxH` overrides the cell size used to size the page
when the terminal does not report one.

Examples:
  tmuxy browser localhost:3000
  tmuxy pane float --width 160 --height 48 tmuxy browser github.com
  tmuxy browser --session agent1
  tmuxy browser github.com --attach          # in the browser you are logged in to
  tmuxy browser --attach=http://127.0.0.1:9222
BEOF
        exit 0
        ;;
    esac
    # Straight to the binary: the pane program IS `tmuxy browser`, which draws
    # its own screen. It is told where THIS CLI is, so it can write its
    # restore tag through `tmuxy pane restore-cmd` wherever tmuxy is installed.
    find_server_cmd
    TMUXY_CLI="$SELF" exec "${SERVER_CMD[@]}" browser "$@"
    ;;
  cleanup)
    shift
    case "${1:-}" in
      --help | -h)
        cat <<'CEOF'
Usage: tmuxy cleanup [-n|--dry-run] [-q|--quiet]

Reap shells left hanging in the kernel by a pane that died while its shell was
still starting up. Each one holds a PTY slave open, and enough of them exhaust
the machine's pseudoterminals so that no new pane can be created.

Options:
  -n, --dry-run  List what would be reaped and exit
  -q, --quiet    Print nothing
CEOF
        exit 0
        ;;
    esac
    exec "$SCRIPTS_DIR/reap-orphan-shells" "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  connect)
    shift
    cmd_connect "$@"
    ;;
  server)
    shift
    find_server_cmd
    exec "${SERVER_CMD[@]}" "$@"
    ;;
  trace)
    shift
    # Inspect/export a local action-trace file (docs/TELEMETRY.md).
    if [ "$1" = "check" ] || [ "$1" = "health" ]; then
      shift
      find_server_cmd
      exec "${SERVER_CMD[@]}" trace --health "$@"
    fi
    find_server_cmd
    exec "${SERVER_CMD[@]}" trace "$@"
    ;;
  config)
    shift
    cmd_config "$@"
    ;;
  info)
    shift
    cmd_info "$@"
    ;;
  skill)
    shift
    cmd_skill "$@"
    ;;
  agent)
    shift
    cmd_agent "$@"
    ;;
  --json|-j)
    shift
    cmd_info --json "$@"
    ;;
  --version|-V|version)
    echo "tmuxy $TMUXY_VERSION"
    ;;
  gui)
    shift
    find_server_cmd
    exec "${SERVER_CMD[@]}" gui "$@"
    ;;
  --help|-h)
    usage
    ;;
  "")
    cmd_info
    echo ""
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Hint: run 'tmuxy --help' for available commands, or 'tmuxy skill' for the AI agent guide." >&2
    usage >&2
    exit 1
    ;;
esac

