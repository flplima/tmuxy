#!/usr/bin/env bash
# tmuxy — AI-first noun-verb CLI for tmux
#
# Safety: All mutating commands route through `tmux run-shell` to avoid
# crashing tmux 3.3a–3.5a when control mode is attached.
# Read-only commands run as direct subprocesses (safe with control mode).

set -euo pipefail

SELF="$0"
if [ -L "$SELF" ]; then
  SELF="$(readlink -f "$SELF")"
fi
# An agent hook runs on every tool call: straight to its script, before any
# of the set-up below.
if [ "${1:-}" = agent ] && [ "${2:-}" = hook ]; then
  shift 2
  exec "${SELF%/*}/tmuxy/agent-hook" "$@"
fi
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")/tmuxy" && pwd)"

TMUXY_VERSION="${TMUXY_VERSION:-}"
if [ -z "$TMUXY_VERSION" ] && [ -f "$REPO_ROOT/package.json" ]; then
  TMUXY_VERSION=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$REPO_ROOT/package.json" 2>/dev/null || true)
fi
TMUXY_VERSION="${TMUXY_VERSION:-0.0.10-alpha.78}"

# --- Helpers ---

# Socket resolution (explicit TMUX_SOCKET, else the socket of the server whose
# pane we are in, else the dedicated `tmuxy` socket — never the user's default
# tmux server), `_tmux`/`_run_safe`, `shquote` and `find_server_cmd` are
# shared with the bin/tmuxy scripts, so they live in their `_lib`. Every tmux call in this
# script goes through `_tmux`, every mutation through `_run_safe`. `_lib`
# resolves SCRIPTS_DIR from its own `$0` (this file, not the scripts
# directory), so restore ours afterwards.
source "$SCRIPTS_DIR/_lib"
SCRIPTS_DIR="$(cd "$(dirname "$SELF")/tmuxy" && pwd)"

# Where a target-less command lands. Inside a pane, tmux reads the caller's
# $TMUX_PANE and every `splitw`, `breakp` and `#{pane_id}` resolves from it.
# From OUTSIDE (a script, a test, an SSH agent) an unattached client has no
# pane, and tmux falls back to the session with the LATEST activity — which,
# right after `pane group add` has parked a member in the hidden
# `__tmuxy_stash` session, is the stash: the next `tab create` or `pane
# send` would land where no client can see it. Resolving the pane here,
# once, with the same preference the server has (an attached real session,
# else the first real one) hands tmux an answer it honours for an unattached
# client the way it does for a pane's own — and `_run_safe` passes it on to
# the client it spawns inside run-shell. Read-only, and skipped when there
# is no server to ask. Never for `tmuxy agent`: an agent hook outside any
# tmuxy pane must change nothing, not some other pane's state.
# The caller's own pane, before that: `pane send` asks the user before typing
# into any other.
export TMUXY_CALLER_PANE="${TMUX_PANE:-}"
if [ -z "${TMUX_PANE:-}" ] && [ "${1:-}" != agent ]; then
  _outside_pane="$(_tmux list-panes -a \
    -f '#{&&:#{window_active},#{pane_active}}' \
    -F '#{session_attached}	#{session_name}	#{pane_id}' 2>/dev/null \
    | awk -F'\t' '$2 != "__tmuxy_stash" { if ($1 > 0) { print $3; exit } ; if (!first) first = $3 } END { if (first) print first }' \
    | head -1 || true)"
  if [ -n "$_outside_pane" ]; then
    TMUX_PANE="$_outside_pane"
    export TMUX_PANE
  fi
fi

# --- JSON output helpers ---
#
# Free-text tmux fields (window names, pane commands) can contain commas and
# quotes, so the --json serializers use a tab separator and escape the values.
# `pane_title` is filtered against the host name because tmux seeds every
# pane's title with it — same expression as tmux_formats::APP_PANE_TITLE in
# packages/tmuxy-core/src/constants.rs; keep the two in step.
APP_PANE_TITLE_FMT='#{?#{==:#{pane_title},#{host}},,#{pane_title}}'
LIST_PANES_JSON_FMT=$'#{pane_id}\t#{window_id}\t#{pane_width}\t#{pane_height}\t#{pane_current_command}\t#{pane_active}\t'"$APP_PANE_TITLE_FMT"
LIST_WINDOWS_JSON_FMT=$'#{window_id}\t#{window_index}\t#{window_name}\t#{window_panes}\t#{window_active}\t#{@tmuxy-window-type}'
JSON_ESCAPE_AWK='function jstr(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\n/, "\\n", s); gsub(/\r/, "\\r", s); gsub(/\t/, "\\t", s); return s } '

# --- Config ---

# Where tmuxy keeps its config and state. Mirrors tmuxy-core's config_dir().
tmuxy_config_dir() {
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/tmuxy"
}

# Read one boolean out of tmuxy.state.json without a JSON parser: the file is
# written by serde_json's pretty printer, so a key sits on its own line.
state_bool() {
  local key="$1" file
  file="$(tmuxy_config_dir)/tmuxy.state.json"
  [ -f "$file" ] || return 1
  grep -q "\"$key\": true" "$file"
}

cmd_config() {
  local setting="${1:-}"
  case "$setting" in
    reload)
      cmd_config_reload
      ;;
    use-tmux-conf)
      shift
      cmd_config_use_tmux_conf "$@"
      ;;
    ""|--help|-h)
      cat <<'EOF'
Usage: tmuxy config <setting> [value]

Settings:
  reload                   Re-apply ~/.config/tmuxy/tmuxy.conf to the running app:
                           the bindings and every @tmuxy-* option are re-read.
  use-tmux-conf [on|off]   Source your own ~/.tmux.conf on tmuxy's socket.
                           With no value, prints the current setting.

With `use-tmux-conf on`, tmuxy sources ~/.tmux.conf and then re-applies
tmuxy.essentials.conf on top: your prefix, status line and plugins win over
tmuxy's defaults, and the settings tmuxy needs to function are restored
afterwards whatever your config did to them.

Takes effect on the next tmux server start for that socket — the config chain
is read when the server starts, so restart tmuxy (or `tmuxy server stop`) after
changing it.
EOF
      ;;
    *)
      echo "Unknown config setting: $setting" >&2
      echo "Hint: tmuxy config --help" >&2
      return 1
      ;;
  esac
}

# The app watches tmuxy.conf and sources it on its own control-mode connection
# when the file changes, then pushes the bindings and settings to every client.
# Marking the file modified is the whole request: a raw `source-file` from
# here would apply the config to tmux but tell no client about it.
cmd_config_reload() {
  local conf
  conf="$(tmuxy_config_dir)/tmuxy.conf"
  if [ ! -f "$conf" ]; then
    echo "Error: $conf does not exist (start tmuxy once to create it)" >&2
    return 1
  fi
  touch "$conf"
  echo "Reloading $conf — the app re-applies it within a second."
}

cmd_config_use_tmux_conf() {
  local dir state_file value="${1:-}"
  dir="$(tmuxy_config_dir)"
  state_file="$dir/tmuxy.state.json"

  if [ -z "$value" ]; then
    if state_bool use_tmux_conf; then
      echo "use-tmux-conf: on  (~/.tmux.conf is sourced, then tmuxy.essentials.conf on top)"
    else
      echo "use-tmux-conf: off (tmuxy uses its own config only)"
    fi
    return 0
  fi

  case "$value" in
    on|true|1) value=true ;;
    off|false|0) value=false ;;
    *)
      echo "Usage: tmuxy config use-tmux-conf [on|off]" >&2
      return 1
      ;;
  esac

  mkdir -p "$dir"
  # Rewrite the one key, preserving everything else in the file. node is not a
  # dependency of the CLI, so this is done with the tools a shell always has.
  if [ -f "$state_file" ]; then
    if grep -q '"use_tmux_conf"' "$state_file"; then
      # -E: BSD sed has no \| alternation in a basic regex, and silently
      # matches nothing rather than erroring — which read as "off does not work".
      sed -i.bak -E "s/(\"use_tmux_conf\": )(true|false)/\1$value/" "$state_file"
      rm -f "$state_file.bak"
    else
      # Insert after the opening brace so the file stays valid JSON.
      sed -i.bak "1s/^{/{\n  \"use_tmux_conf\": $value,/" "$state_file"
      rm -f "$state_file.bak"
    fi
  else
    printf '{\n  "use_tmux_conf": %s\n}\n' "$value" > "$state_file"
  fi

  if [ "$value" = true ]; then
    echo "use-tmux-conf: on — tmuxy will source ~/.tmux.conf, then re-apply its essentials."
  else
    echo "use-tmux-conf: off — tmuxy will use its own config only."
  fi
  echo "Restart tmuxy for this to take effect (the config chain is read at tmux server start)."
}

# --- Info & Skill ---

cmd_info() {
  local json=false
  for arg in "$@"; do
    case "$arg" in
      --help|-h) echo "Usage: tmuxy info [--json]"; return ;;
      --json) json=true ;;
    esac
  done

  local inside=false
  if [ -n "${TMUX:-}" ]; then
    inside=true
  fi

  if ! $inside; then
    local server_running=false
    if _tmux has-session 2>/dev/null; then
      server_running=true
    fi
    if $json; then
      printf '{"inside":false,"socket":"%s","serverRunning":%s,"version":"%s","agentSkillHint":"Run '\''%s skill'\'' to view the agent instruction guide"}\n' \
        "$TMUX_SOCKET" "$server_running" "$TMUXY_VERSION" "tmuxy"
    else
      echo "tmuxy $TMUXY_VERSION"
      if $server_running; then
        echo "  Status: not inside a tmuxy session (server is running on socket '$TMUX_SOCKET')"
      else
        echo "  Status: not inside a tmuxy session (no server on socket '$TMUX_SOCKET')"
      fi
      echo "  Tip:    Run 'tmuxy gui' to open the desktop app, or 'tmuxy connect' to attach."
      echo ""
      echo "Agent Guide:"
      echo "  • Run 'tmuxy skill' to print the full agent instructions & safety rules."
      echo "  • Run 'tmuxy --json' for machine-readable state."
    fi
    return
  fi

  # Inside session — read session, active pane, and active window in one display-message call
  local fmt=$'#{session_name}\t#{pane_id}\t#{window_id}\t#{pane_width}\t#{pane_height}\t#{pane_current_command}\t#{window_index}\t#{window_name}\t#{window_panes}'
  local info_line
  info_line=$(_tmux display-message -p "$fmt" 2>/dev/null || true)

  local session_name pane_id window_id pane_width pane_height pane_cmd window_index window_name window_panes
  IFS=$'\t' read -r session_name pane_id window_id pane_width pane_height pane_cmd window_index window_name window_panes <<< "$info_line"

  if $json; then
    printf '{"inside":true,"socket":"%s","session":"%s","activePane":{"id":"%s","width":%s,"height":%s,"command":"%s"},"activeTab":{"id":"%s","index":%s,"name":"%s","panesCount":%s},"version":"%s","agentSkillHint":"Run '\''%s skill'\'' to view the full agent instruction guide and safety rules"}\n' \
      "$TMUX_SOCKET" "${session_name:-}" "${pane_id:-}" "${pane_width:-0}" "${pane_height:-0}" "${pane_cmd:-}" \
      "${window_id:-}" "${window_index:-0}" "${window_name:-}" "${window_panes:-0}" "$TMUXY_VERSION" "tmuxy"
  else
    echo "tmuxy $TMUXY_VERSION (socket: $TMUX_SOCKET, session: ${session_name:-$TMUX_SOCKET})"
    echo "  Status:  attached (control mode active)"
    echo "  Pane:    ${pane_id:-%0} (${pane_width:-0}x${pane_height:-0}, ${pane_cmd:-shell})"
    echo "  Tab:     ${window_id:-@0} (name: \"${window_name:-tmuxy}\", ${window_panes:-1} pane)"
    echo ""
    echo "Agent Guide:"
    echo "  • Run 'tmuxy skill' to print the full agent instructions & safety rules."
    echo "  • Run 'tmuxy --json' for machine-readable state."
    echo "  • Warning: Do NOT run raw mutating tmux commands (use 'tmuxy pane/tab/run')."
  fi
}

# The one copy of the agent guide. .agents/skills/tmuxy/SKILL.md is this text
# verbatim (a CLI test fails when they differ): an installed CLI has no repo to
# read the skill file from, so the heredoc is the source.
# Coding agents in tmuxy panes: `install` wires an agent's lifecycle hooks to
# `tmuxy agent hook`, which turns each event into the pane's
# `@tmuxy-pane-state`, and installs the skill. The editing of each agent's
# own config lives in the server binary (`agents.rs`); what an event means
# too, so the hooks stay a bare command that an upgrade never has to rewrite.
cmd_agent() {
  local verb="${1:-}"
  [ $# -gt 0 ] && shift
  case "$verb" in
    install|uninstall|status)
      find_server_cmd
      exec "${SERVER_CMD[@]}" agent "$verb" "$@"
      ;;
    ""|--help|-h)
      cat <<EOF
Usage: tmuxy agent <install|uninstall|status> [claude|codex|agy]...

Show what a coding agent is doing on its tree row: working, waiting for you,
done, failed. Its lifecycle hooks report to tmuxy; the tmuxy skill is
installed alongside, so the agent knows the CLI.

  install     Add the hooks and the skill (default: every agent found)
  uninstall   Remove them, leaving everything else as it was
  status      What is installed, per agent

Options:
  --hooks-only | --skill-only
  --project   This project's config (./.claude, ./.codex, ./.agents)
              instead of the home directory's
  --dry-run   Say what would change; write nothing
  --force     (install) Replace a tmuxy skill tmuxy did not write
EOF
      ;;
    *)
      echo "Unknown agent command: $verb (try 'tmuxy agent --help')" >&2
      return 1
      ;;
  esac
}


cmd_skill() {
  case "${1:-}" in
    --help|-h) echo "Usage: tmuxy skill"; return ;;
  esac
  cat <<'EOF'
---
name: tmuxy
description: Working inside tmuxy (web/desktop tmux interface). Covers tmuxy CLI, control-mode safety rules (never run mutating raw tmux commands), and pane/tab/widget operations.
---

# tmuxy

tmuxy is a web/desktop UI over a real tmux server. When running inside tmuxy, panes, tabs and floats are real UI surfaces you can drive from the shell, not just tmux abstractions.

## Am I inside tmuxy?

```sh
[ -n "$TMUX" ] && [ "$(basename "${TMUX%%,*}")" = "tmuxy" ]
```

`$TMUX` is `<socket-path>,<server-pid>,<session-id>`; the socket basename is `tmuxy` (or `tmuxy-dev`).

## Hard rules

1. **Never run a mutating raw `tmux` command.** External `tmux` mutations crash tmux
   3.3a–3.5a while control mode is attached. Route everything through the `tmuxy` CLI,
   which wraps mutations in `tmux run-shell`. Escape hatch: `tmuxy run <any tmux cmd>`.
2. **Read-only `tmux` is fine** as a direct subprocess (`display-message -p`,
   `list-panes`, `show-options -qv`).
3. **Never use `new-window`/`neww`** — it crashes tmux 3.5a. `tmuxy tab create` does
   `splitw ; breakp` instead.
4. Kill a stray float with `tmuxy pane kill %id`, never `tmux kill-window`.

## CLI cheat sheet

```sh
tmuxy                           # status and multiplexer info
tmuxy --json                    # machine-readable status
tmuxy skill                     # print this guide
tmuxy pane list --json          # id, tab, width, height, command, active (--all = every tab)
tmuxy pane split [-h|-v] [--json] # split pane (returns %id or JSON)
tmuxy pane float [opts] [cmd]   # open a float
tmuxy pane capture [%id] --json # read what's on a pane's screen
tmuxy pane send ls Enter        # type into a pane
tmuxy pane select -U|-D|-L|-R|%id # select pane
tmuxy pane kill [%id]           # close pane
tmuxy tab list --json           # tabs; also kill/select/next/prev/rename/layout
tmuxy tab create [name] [--json]# create tab (returns @id or JSON)
tmuxy pane group add            # group the current pane (members become header tabs)
tmuxy pane group join %id %m    # put %id in %m's group; also move, leave, switch, next, prev, close
tmuxy pane send -t %id <keys...># type into another pane; the user allows it there first (blocks until answered)
tmuxy session save [name]       # snapshot a session; also restore <name>, snapshots, forget <name>
tmuxy open <file|url|host>      # show an HTML file, a site, a .md file or an image
tmuxy widget browser <file|url> # the same, spelled out
tmuxy browser [url]             # a real browser drawn in the pane; `:` verbs drive it (see below)
tmuxy browser --attach[=ENDPOINT] # the same, on a browser already running (your own profile)
tmuxy run <tmux cmd>            # any tmux command, routed safely through run-shell
tmuxy config reload             # re-apply ~/.config/tmuxy/tmuxy.conf to the running app
```

## Driving a browser pane

`tmuxy browser [url]` turns a pane into a real browser (your own Chrome/Chromium/Edge/
Brave, drawn as a picture). `--attach` drives a browser that is already running — with
no endpoint it finds one by itself (a profile's `DevToolsActivePort`, else 127.0.0.1:9222);
Chrome 144+ exposes the user's own profile only after the consent prompt at
`chrome://inspect/#remote-debugging`. The picture only means something when the server is
the machine with the screen. Drive it from another pane, no API needed:

```sh
tmuxy pane send -t %ID ':goto example.com' Enter   # verbs: goto, eval, click, type, wait,
tmuxy pane send -t %ID ':eval document.title' Enter #   text, title, url, shot, back,
tmuxy pane capture %ID                             #   forward, reload, viewport, repl, help
```

Each verb answers on the pane's bottom row, which `tmuxy pane capture` reads back. `:repl`
(or the toolbar's REPL button) swaps the picture for the verb log, so the user can see what
you typed and what came back; `:repl off` brings the picture back.

## Personalizing tmuxy

Everything the user can change lives in `~/.config/tmuxy/`; its `README.md` is the
guide — read it before changing a theme, a colour or the tmux config. In short:

- Never edit an app-owned file (the built-in `themes/*.css`, `tmuxy.defaults.conf`):
  it is rewritten on every launch. Copy a theme to a new name instead.
- Small tweaks: `custom.css` (any CSS), or `set -g @tmuxy-css-<variable> <value>` in
  `tmuxy.conf`. Options are `@tmuxy-*` in `tmuxy.conf`; `tmuxy config reload` applies it.
- A saved theme or `custom.css` repaints every open window by itself.
EOF
}

# --- Help ---

usage() {
  cat <<EOF
tmuxy $TMUXY_VERSION — AI-first terminal multiplexer

Usage: tmuxy <command> [args...]

Commands:
  info        Show multiplexer and session status [--json]
  skill       Show AI agent guide and safety rules
  agent       Show Claude Code / Codex / Antigravity state in tmuxy (install, uninstall, status)
  pane        Manage panes (split, kill, select, resize, group, float)
  tab         Manage tabs (create, kill, select, rename, layout)
  session     Manage sessions (switch, connect, save, restore, snapshots, forget)
  nav         Navigate across groups, splits, and tabs
  open        Show a page, file or image in a browser pane (alias of widget browser)
  widget      Display widgets (browser, tree, session)
  tree        Browse tabs and panes as a tree in this terminal
  run         Run any tmux command safely
  browser     Turn this pane into a browser: a real engine, drawn in the pane
  cleanup     Reap shells left hanging by a pane that died while starting up
  connect     Reconnect the desktop app to a different tmux server (socket)
  server      Production server operations
  trace       Inspect/export a local action-trace file (docs/TELEMETRY.md)
  config      Re-apply tmuxy.conf (reload) or change a setting (use-tmux-conf)
  gui         Open the desktop GUI application

Options:
  -h, --help    Show this help
  -V, --version Show version
  --json        Output as JSON (with info or root command)

Note for AI/LLM agents:
  • Do NOT run raw mutating tmux commands (external new-window/split-window crash control mode).
  • Always route mutations through 'tmuxy pane/tab/run'.
  • Use --json on query commands for unambiguous, parseable output.
  • Run 'tmuxy skill' to print the full agent instruction guide.
EOF
}

usage_tree() {
  cat <<'EOF'
Usage: tmuxy tree

Open an interactive tree view of all tabs and their panes. Navigate with
j/k or the arrow keys, Enter (or a mouse click) to activate a tab/pane.
A standalone browser of tabs/panes, for a plain terminal. The left sidebar
renders the same tree as a React widget — see `tmuxy widget tree`.
EOF
}

usage_pane() {
  cat <<'EOF'
Usage: tmuxy pane <command> [args...]

Commands:
  list          List all panes [--json] [--all]
  split         Split current pane [-h|-v]
  kill          Kill a pane [%id]
  select        Select/focus a pane [-U|-D|-L|-R|%id]
  resize        Resize a pane [-U|-D|-L|-R] [n]
  swap          Swap two panes <src> <dst>
  zoom          Toggle pane zoom
  break         Break pane into own tab
  capture       Capture pane content [%id] [--json]
  send          Send keys to pane <keys...>
  state         Declare what the pane is doing <state> [%id]
  restore-cmd   Say how to bring the pane back after a restore '<command>' [%id]
  paste         Paste text into pane <text>
  float         Create a float pane [cmd args...]
  group         Pane group operations (add, close, switch, next, prev, move, join, leave)

Run 'tmuxy pane <command> --help' for details.
EOF
}

usage_pane_group() {
  cat <<'EOF'
Usage: tmuxy pane group <command> [args...]

Commands:
  add           Add current pane to a group
  close         Close pane from group [%id]
  switch        Switch to pane in group <%id>
  next          Next pane in group
  prev          Previous pane in group
  move          Move a member to another place in its group <%id> <index>
  join          Make a pane a member of another pane's group <%id> <%member> [index]
  leave         Take a member out of its group [%id] [--tab | --beside <%id> <dir>]
EOF
}

usage_tab() {
  cat <<'EOF'
Usage: tmuxy tab <command> [args...]

Commands:
  list          List all tabs [--json]
  create        Create a new tab [name]
  kill          Kill a tab [@id]
  select        Switch to a tab <index|@id>
  next          Next tab
  prev          Previous tab
  rename        Rename current tab <name>
  layout        Change pane layout [next|even-h|even-v|main-h|main-v|tiled]
EOF
}

usage_widget() {
  cat <<'EOF'
Usage: tmuxy widget <command> [args...]

Commands:
  browser       Show a page: a local HTML file, a URL, a markdown file
                (rendered, with mermaid), or an image. `-` reads markdown
                from stdin. --color-filter recolours a page or an image
                into the theme's colours.
  tree          Display the tabs+panes tree (the left sidebar's content)
  session       Switch, rename, kill or detach the session; connect to
                another tmux socket, locally or over SSH
EOF
}

usage_session() {
  cat <<'EOF'
Usage: tmuxy session <command> [args...]

Commands:
  switch        Interactive session switcher [--float]
  connect       SSH connection prompt [--web]
  save          Snapshot a session now [name] [--scrollback N]
  restore       Rebuild a session from its snapshot <name> [--run]
  snapshots     The sessions that have a snapshot, and whether they run
  forget        Delete a session's snapshots <name> [--force]

A session's shape — tabs, splits, floats, sidebars, groups, each pane's
directory and program — is saved on every change and brought back when the
server starts and the session is gone. Programs come back typed at the
prompt, not run; `--run` runs them. A pane says how to bring itself back with
`tmuxy pane restore-cmd '<command>'`.
EOF
}

usage_nav() {
  cat <<'EOF'
Usage: tmuxy nav <direction>

Directions:
  left        Previous group member → pane to the left → left sidebar
  right       Next group member → pane to the right → right sidebar
  up          Pane splits only (vertical)
  down        Pane splits only (vertical)
  next        Sequential forward (same as right)
  prev        Last pane, fall back to last window
EOF
}

usage_run() {
  cat <<'EOF'
Usage: tmuxy run <tmux-command> [args...]

Run any tmux command safely through run-shell.

Safety features:
  - new-window is intercepted → split-window + break-pane
  - resize-window is blocked (crashes control mode)
  - All other commands route through run-shell

Examples:
  tmuxy run swap-pane -s %0 -t %1
  tmuxy run new-window              # intercepted → safe alternative
  tmuxy run send-keys -t %3 ls Enter
EOF
}

usage_connect() {
  cat <<'EOF'
Usage: tmuxy connect [socket] [session]

With no arguments, opens the "add a server" form (a small TUI) to save a tmux
server — the local machine or a remote SSH host — to the desktop app's sidebar
server picker (stored in ~/.config/tmuxy/servers.json).

With a socket, reconnects the tmuxy DESKTOP APP to a different tmux server
without relaunching. `socket` is a socket name (in tmux's default dir, e.g.
`default` for your everyday tmux server) or a full socket path (containing a
slash). If `session` is omitted, the app attaches to the target server's first
existing session, or creates `tmuxy` if it has none.

This sets a request the running desktop app picks up. It has no effect in the
web UI (the web server's socket is fixed at launch).

Examples:
  tmuxy connect                      # open the add-a-server form
  tmuxy connect default              # attach to your everyday tmux server
  tmuxy connect default work         # ...to its "work" session specifically
  tmuxy connect /tmp/tmux-1000/foo   # attach to a socket by full path
EOF
}

# --- Pane subcommands ---

cmd_pane() {
  local sub="${1:-}"
  shift 2>/dev/null || true

  case "$sub" in
    restore-cmd)
      # Say how to bring this pane back after a restore (`@tmuxy-pane-restore`):
      # the program itself knows (`claude --resume <id>`, `nvim -S`, `ssh
      # host`) where `ps` can only guess. Wins over discovery at restore time.
      local value="" target=""
      for arg in "$@"; do
        case "$arg" in
          --help|-h)
            echo "Usage: tmuxy pane restore-cmd '<command>' [%id]"
            echo "       tmuxy pane restore-cmd --clear [%id]"
            return
            ;;
          --clear) value="--clear" ;;
          %*) target="$arg" ;;
          *) value="$arg" ;;
        esac
      done
      if [ -z "$value" ]; then
        echo "Error: command required (or --clear)" >&2
        return 1
      fi
      target="${target:-${TMUX_PANE:-}}"
      if [ -z "$target" ]; then
        echo "Error: no pane to target (pass %id or run inside a pane)" >&2
        return 1
      fi
      if [ "$value" = "--clear" ]; then
        _run_safe "set-option -p -u -t $(shquote "$target") @tmuxy-pane-restore"
      else
        _run_safe "set-option -p -t $(shquote "$target") @tmuxy-pane-restore $(shquote "$value")"
      fi
      ;;

    state)
      # Declare what this pane is doing, for the sidebar tree to draw. Any
      # process can call it — an agent's hooks, a shell's precmd/preexec, a
      # build script on failure — which is why the value is not validated
      # here: the client owns the vocabulary and collapses what it doesn't
      # know, so a writer is free to use its own names.
      local value="" target=""
      for arg in "$@"; do
        case "$arg" in
          --help|-h)
            echo "Usage: tmuxy pane state <idle|working|needs-input|error|unread|clear> [%id]"
            return
            ;;
          %*) target="$arg" ;;
          *) value="$arg" ;;
        esac
      done
      if [ -z "$value" ]; then
        echo "Error: state value required" >&2
        return 1
      fi
      # Default to the calling pane. `set-option -p` with no target resolves
      # against tmux's idea of the current pane, which under run-shell is the
      # ACTIVE one, not the caller — so the target is always explicit.
      target="${target:-${TMUX_PANE:-}}"
      if [ -z "$target" ]; then
        echo "Error: no pane to target (pass %id or run inside a pane)" >&2
        return 1
      fi
      if [ "$value" = clear ]; then
        _run_safe "set-option -p -u -t $(shquote "$target") @tmuxy-pane-state"
      else
        _run_safe "set-option -p -t $(shquote "$target") @tmuxy-pane-state $(shquote "$value")"
      fi
      ;;

    list)
      local json=false all=false
      for arg in "$@"; do
        case "$arg" in
          --json) json=true ;;
          --all) all=true ;;
          --help|-h) echo "Usage: tmuxy pane list [--json] [--all]"; return ;;
        esac
      done
      local scope=()
      if $all; then scope=(-s); fi
      if $json; then
        # Tab-separated: pane_current_command is free text, so a comma in it
        # would shift every following field and break the JSON.
        _tmux list-panes ${scope[@]+"${scope[@]}"} -F "$LIST_PANES_JSON_FMT" | \
          awk -F'\t' "$JSON_ESCAPE_AWK"'BEGIN{printf "["} NR>1{printf ","} {printf "{\"id\":\"%s\",\"tab\":\"%s\",\"width\":%s,\"height\":%s,\"command\":\"%s\",\"active\":%s,\"title\":\"%s\"}", jstr($1), jstr($2), $3, $4, jstr($5), ($6=="1"?"true":"false"), jstr($7)} END{printf "]\n"}'
      else
        _tmux list-panes ${scope[@]+"${scope[@]}"}
      fi
      ;;

    split)
      # `-h` is this command's own flag (horizontal split), so only the long
      # form asks for help — otherwise `tmuxy pane split -h` prints usage
      # instead of splitting.
      local args="" json=false
      for arg in "$@"; do
        case "$arg" in
          --help) echo "Usage: tmuxy pane split [-h|-v] [--json]"; return ;;
          --json) json=true ;;
          *) args="$args $arg" ;;
        esac
      done
      local out
      out=$(_run_safe "splitw$args -P -F '##{pane_id}'")
      local pane_id
      pane_id=$(echo "$out" | grep -o '%[0-9]*' | tail -1 || true)
      if $json; then
        printf '{"paneId":"%s"}\n' "${pane_id:-}"
      elif [ -n "$pane_id" ]; then
        echo "$pane_id"
      fi
      ;;

    kill)
      local target=""
      for arg in "$@"; do
        case "$arg" in
          --help|-h) echo "Usage: tmuxy pane kill [%id]"; return ;;
          *) target="$arg" ;;
        esac
      done
      if [ -n "$target" ]; then
        _run_safe "killp -t $(shquote "$target")"
      else
        _run_safe "killp"
      fi
      ;;

    select)
      local arg="${1:-}"
      case "$arg" in
        --help|-h) echo "Usage: tmuxy pane select [-U|-D|-L|-R|%id]"; return ;;
        -U|-D|-L|-R) _run_safe "selectp $arg" ;;
        %*) _run_safe "selectp -t $(shquote "$arg")" ;;
        "") echo "Error: pane direction or ID required" >&2; return 1 ;;
        *) echo "Error: invalid argument '$arg'. Use -U, -D, -L, -R, or %id" >&2; return 1 ;;
      esac
      ;;

    resize)
      local args=""
      for arg in "$@"; do
        case "$arg" in
          --help|-h) echo "Usage: tmuxy pane resize [-U|-D|-L|-R] [n]"; return ;;
          *) args="$args $arg" ;;
        esac
      done
      if [ -z "$args" ]; then
        echo "Error: direction required (-U, -D, -L, -R)" >&2; return 1
      fi
      _run_safe "resizep$args"
      ;;

    swap)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane swap <src> <dst>"; return ;;
      esac
      local src="${1:?Usage: tmuxy pane swap <src> <dst>}"
      local dst="${2:?Usage: tmuxy pane swap <src> <dst>}"
      _run_safe "swap-pane -s $(shquote "$src") -t $(shquote "$dst")"
      ;;

    zoom)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane zoom"; return ;;
      esac
      _run_safe "resizep -Z"
      ;;

    break)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane break"; return ;;
      esac
      _run_safe "breakp -t '#{session_id}:'"
      ;;

    capture)
      local target="" json=false
      for arg in "$@"; do
        case "$arg" in
          --help|-h) echo "Usage: tmuxy pane capture [%id] [--json]"; return ;;
          --json) json=true ;;
          %*) target="$arg" ;;
        esac
      done
      local cmd="capture-pane -p"
      if [ -n "$target" ]; then cmd="$cmd -t $target"; fi
      local content
      content=$(_tmux $cmd)
      if $json; then
        # Escape for JSON: backslash, double-quote, then convert newlines
        local escaped
        escaped=$(printf '%s' "$content" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{if(NR>1)printf "\\n"; printf "%s",$0}')
        printf '{"content":"%s"}\n' "$escaped"
      else
        echo "$content"
      fi
      ;;

    send)
      case "${1:-}" in
        "") echo "Error: keys required" >&2; return 1 ;;
      esac
      bash "$SCRIPTS_DIR/send" "$@"
      ;;

    paste)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane paste <text>"; return ;;
        "") echo "Error: text required" >&2; return 1 ;;
      esac
      local text="$*"
      _tmux load-buffer - <<< "$text"
      _run_safe "pasteb"
      ;;

    float)
      case "${1:-}" in
        --help|-h) cat <<'FEOF'
Usage: tmuxy pane float [options] [cmd args...]

Options:
  --left          Drawer docked to left edge
  --right         Drawer docked to right edge
  --top           Drawer docked to top edge
  --bottom        Drawer docked to bottom edge
  --width N       Width in columns, default 60 (a top/bottom drawer spans the
                  full width, so it ignores this)
  --height N      Height in rows, default 15 and never more than the tab's own
                  height (a left/right drawer spans the full height, so it
                  ignores this)
  --bg MODE       Backdrop: dim (default), blur, none
  --hide-header   Hide the title bar
FEOF
          return ;;
      esac
      exec bash "$SCRIPTS_DIR/float-create" "$@"
      ;;

    group)
      cmd_pane_group "$@"
      ;;

    --help|-h)
      usage_pane
      ;;

    "")
      usage_pane
      ;;

    *)
      echo "Unknown pane command: $sub" >&2
      usage_pane >&2
      return 1
      ;;
  esac
}

# --- Pane group subcommands ---

cmd_pane_group() {
  local sub="${1:-}"
  shift 2>/dev/null || true

  case "$sub" in
    add)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane group add"; return ;;
      esac
      _run_shell "bash '$SCRIPTS_DIR/pane-group-add' #{pane_id} #{pane_width} #{pane_height}"
      ;;

    close)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane group close [%id]"; return ;;
      esac
      local pane_id="${1:-"#{pane_id}"}"
      _run_shell "bash '$SCRIPTS_DIR/pane-group-close' '$pane_id'"
      ;;

    switch)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane group switch <%id>"; return ;;
      esac
      local pane_id="${1:?Usage: tmuxy pane group switch <pane_id>}"
      _run_shell "bash '$SCRIPTS_DIR/pane-group-switch' '$pane_id'"
      ;;

    move)
      case "${1:-}" in
        --help|-h|"") echo "Usage: tmuxy pane group move <%id> <index>   (0 is first)"; [ -n "${1:-}" ] && return; return 1 ;;
      esac
      local pane_id="$1" index="${2:?Usage: tmuxy pane group move <%id> <index>}"
      _run_shell "bash '$SCRIPTS_DIR/pane-group-move' $(shquote "$pane_id") $(shquote "$index")"
      ;;

    join)
      case "${1:-}" in
        --help|-h|"") echo "Usage: tmuxy pane group join <%id> <%member-or-pane> [index]"; [ -n "${1:-}" ] && return; return 1 ;;
      esac
      local pane_id="$1" anchor="${2:?Usage: tmuxy pane group join <%id> <%member-or-pane> [index]}" index="${3:-}"
      _run_shell "bash '$SCRIPTS_DIR/pane-group-join' $(shquote "$pane_id") $(shquote "$anchor") $(shquote "$index")"
      ;;

    leave)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane group leave [%id] [--tab | --beside <%id> <left|right|up|down>]"; return ;;
      esac
      local pane_id="${TMUX_PANE:-}"
      case "${1:-}" in %*) pane_id="$1"; shift ;; esac
      if [ -z "$pane_id" ]; then
        echo "Error: no pane to take out of its group (pass %id or run inside a pane)" >&2
        return 1
      fi
      local mode="${1:---tab}" beside="${2:-}" dir="${3:-right}"
      _run_shell "bash '$SCRIPTS_DIR/pane-group-leave' $(shquote "$pane_id") $(shquote "$mode") $(shquote "$beside") $(shquote "$dir")"
      ;;

    next)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane group next"; return ;;
      esac
      _run_shell "bash '$SCRIPTS_DIR/pane-group-next' #{pane_id}"
      ;;

    prev)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy pane group prev"; return ;;
      esac
      _run_shell "bash '$SCRIPTS_DIR/pane-group-prev' #{pane_id}"
      ;;

    --help|-h)
      usage_pane_group
      ;;

    "")
      usage_pane_group
      ;;

    *)
      echo "Unknown group command: $sub" >&2
      usage_pane_group >&2
      return 1
      ;;
  esac
}

# --- Tab subcommands ---

cmd_tab() {
  local sub="${1:-}"
  shift 2>/dev/null || true

  case "$sub" in
    list)
      local json=false
      for arg in "$@"; do
        case "$arg" in
          --json) json=true ;;
          --help|-h) echo "Usage: tmuxy tab list [--json]"; return ;;
        esac
      done
      if $json; then
        # Include @tmuxy-window-type ($6) so we can drop tmuxy's hidden windows
        # (floats and the sidebars). Keep "tab" and untagged/foreign ("")
        # windows so this still works in a plain (non-tmuxy) session.
        # Tab-separated: window_name is user-controlled free text (tmuxy tab
        # rename), so a comma in it would shift every following field.
        _tmux list-windows -F "$LIST_WINDOWS_JSON_FMT" | \
          awk -F'\t' "$JSON_ESCAPE_AWK"'BEGIN{printf "["; n=0} $6!="float" && $6!~/^sidebar-/{ if(n++) printf ","; printf "{\"id\":\"%s\",\"index\":%s,\"name\":\"%s\",\"panes\":%s,\"active\":%s}", jstr($1), $2, jstr($3), $4, ($5=="1"?"true":"false")} END{printf "]\n"}'
      else
        _tmux list-windows
      fi
      ;;

    create)
      local name="" json=false
      for arg in "$@"; do
        case "$arg" in
          --help|-h) echo "Usage: tmuxy tab create [name] [--json]"; return ;;
          --json) json=true ;;
          *) [ -z "$name" ] && name="$arg" ;;
        esac
      done
      # new-window crashes tmux 3.5a — use splitw+breakp as a single tmux command
      # list (separated by \;) so it runs atomically through run-shell. Direct
      # external tmux invocations crash CC; this routes through run-shell safely.
      # splitw+breakp creates the new window and selects it. Tabs carry no
      # marker — an untagged window in the session is a tab, so no tagging.
      # The break names its session: `#{session_id}` is run-shell's, expanded
      # for the calling pane, where a bare breakp would put the window in
      # whichever session tmux last touched (see TMUX_PANE above).
      local out
      if [ -n "$name" ]; then
        out=$(_run_safe "splitw \\; breakp -t '#{session_id}:' -n $(shquote "$name") -P -F '##{window_id}'")
      else
        out=$(_run_safe "splitw \\; breakp -t '#{session_id}:' -P -F '##{window_id}'")
      fi
      local tab_id
      tab_id=$(echo "$out" | grep -o '@[0-9]*' | tail -1 || true)
      if $json; then
        printf '{"tabId":"%s"}\n' "${tab_id:-}"
      elif [ -n "$tab_id" ]; then
        echo "$tab_id"
      fi
      ;;

    kill)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy tab kill [@id]"; return ;;
      esac
      local target="${1:-}"
      if [ -n "$target" ]; then
        _run_safe "killw -t $(shquote "$target")"
      else
        _run_safe "killw"
      fi
      ;;

    select)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy tab select <index|@id>"; return ;;
        "") echo "Error: tab index or @id required" >&2; return 1 ;;
      esac
      _run_safe "select-window -t $(shquote "$1")"
      ;;

    next)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy tab next"; return ;;
      esac
      _run_safe "next-window"
      ;;

    prev)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy tab prev"; return ;;
      esac
      _run_safe "previous-window"
      ;;

    rename)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy tab rename <name>"; return ;;
        "") echo "Error: name required" >&2; return 1 ;;
      esac
      _run_safe "rename-window $(shquote "$1")"
      ;;

    layout)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy tab layout [next|even-h|even-v|main-h|main-v|tiled]"; return ;;
      esac
      local layout="${1:-next}"
      if [ "$layout" = "next" ]; then
        _run_safe "next-layout"
      else
        _run_safe "select-layout $(shquote "$layout")"
      fi
      ;;

    --help|-h)
      usage_tab
      ;;

    "")
      usage_tab
      ;;

    *)
      echo "Unknown tab command: $sub" >&2
      usage_tab >&2
      return 1
      ;;
  esac
}

# --- Widget subcommands ---

cmd_widget() {
  local sub="${1:-}"
  shift 2>/dev/null || true

  case "$sub" in
    browser)
      case "${1:-}" in
        --help|-h)
          cat <<'BEOF'
Usage: tmuxy widget browser [--color-filter] <file|url|->

Options:
  --color-filter  Recolour a page or an image into the theme's colours
                  (markdown is already drawn in them)
BEOF
          return ;;
        "") echo "Error: file, url or - required" >&2; return 1 ;;
      esac
      open_target "$@"
      ;;

    tree)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy widget tree"; return ;;
      esac
      exec "$SCRIPTS_DIR/tmuxy-widget-tree"
      ;;

    session)
      case "${1:-}" in
        --help|-h) echo "Usage: tmuxy widget session"; return ;;
      esac
      exec "$SCRIPTS_DIR/tmuxy-widget-session"
      ;;

    --help|-h)
      usage_widget
      ;;

    "")
      usage_widget
      ;;

    *)
      echo "Unknown widget command: $sub" >&2
      usage_widget >&2
      return 1
      ;;
  esac
}

# --- Session subcommands ---

cmd_session() {
  local sub="${1:-}"
  shift 2>/dev/null || true

  case "$sub" in
    switch)
      case "${1:-}" in
        --help|-h) exec bash "$SCRIPTS_DIR/session-switch" --help ;;
      esac
      exec bash "$SCRIPTS_DIR/session-switch" "$@"
      ;;

    connect)
      case "${1:-}" in
        --help|-h) exec bash "$SCRIPTS_DIR/session-connect" --help ;;
      esac
      exec bash "$SCRIPTS_DIR/session-connect" "$@"
      ;;

    save|snapshots)
      # Reads only (tmux queries and `ps`), safe as a plain subprocess.
      find_server_cmd
      exec "${SERVER_CMD[@]}" session "$sub" "$@"
      ;;

    restore)
      # A restore creates and splits, which must not run as bare tmux
      # subprocesses while a control-mode client is attached (docs/TMUX.md).
      # Inside `run-shell` the binary's own tmux calls are tmux-internal, the
      # same way every mutating helper in bin/tmuxy runs.
      case "${1:-}" in
        --help|-h) find_server_cmd; exec "${SERVER_CMD[@]}" session restore --help ;;
      esac
      local quoted=""
      for arg in "$@"; do quoted="$quoted $(shquote "$arg")"; done
      find_server_cmd
      _run_shell "$(shquote "${SERVER_CMD[@]}") session restore$quoted"
      ;;

    forget)
      # `--force` kills a running session first: a kill is a mutation, so it
      # goes through run-shell; the file removal needs nothing from tmux.
      case "${1:-}" in
        --help|-h) find_server_cmd; exec "${SERVER_CMD[@]}" session forget --help ;;
      esac
      local quoted=""
      for arg in "$@"; do quoted="$quoted $(shquote "$arg")"; done
      find_server_cmd
      _run_shell "$(shquote "${SERVER_CMD[@]}") session forget$quoted"
      ;;

    --help|-h)
      usage_session
      ;;

    "")
      usage_session
      ;;

    *)
      echo "Unknown session command: $sub" >&2
      usage_session >&2
      return 1
      ;;
  esac
}

# --- Nav subcommand ---

cmd_nav() {
  local dir="${1:-}"

  case "$dir" in
    # The calling pane is $TMUX_PANE. run-shell's own `#{pane_id}` expands to
    # the session's current pane, which is a different pane when this runs
    # from inside a sidebar column — the nav script needs to know it is there.
    # (Resolved in two steps: `${TMUX_PANE:-#{pane_id}}` would let bash close
    # the expansion at the `}` inside the tmux format.)
    left|right|up|down|next|prev)
      local pane_arg="${TMUX_PANE:-}"
      [ -n "$pane_arg" ] || pane_arg='#{pane_id}'
      _run_shell "bash '$SCRIPTS_DIR/nav' $dir $pane_arg"
      ;;
    --help|-h)
      usage_nav
      ;;
    "")
      usage_nav
      ;;
    *)
      echo "Unknown direction: $dir" >&2
      usage_nav >&2
      return 1
      ;;
  esac
}

# --- Opening something in a browser pane ---

# `tmuxy open` / `tmuxy widget browser`: a website goes to the real engine
# (`tmuxy browser`), which draws it in the pane under the app's address bar —
# a frame cannot show a site that refuses to be framed, and most big ones do.
# Files, markdown and images stay with the widget, which draws them in the
# theme. `-` (markdown on stdin) is never resolved first: resolving reads it.
open_target() {
  local filter="" arg resolved
  for arg in "$@"; do
    case "$arg" in
      --color-filter) filter=1 ;;
      - | --resolve) exec "$SCRIPTS_DIR/tmuxy-widget-browser" "$@" ;;
    esac
  done
  resolved=$("$SCRIPTS_DIR/tmuxy-widget-browser" --resolve "$@") || exit $?
  case "$resolved" in
    http://* | https://*)
      find_server_cmd
      TMUXY_CLI="$SELF" exec "${SERVER_CMD[@]}" browser ${filter:+--color-filter} "$resolved"
      ;;
  esac
  exec "$SCRIPTS_DIR/tmuxy-widget-browser" "$@"
}

# --- Run escape hatch ---

cmd_run() {
  case "${1:-}" in
    --help|-h) usage_run; return ;;
    "") echo "Error: tmux command required" >&2; usage_run >&2; return 1 ;;
  esac

  local tmux_cmd="$1"
  shift

  case "$tmux_cmd" in
    new-window|neww)
      # Intercept: new-window crashes tmux 3.5a with control mode attached.
      # Route splitw+breakp+tag through run-shell as a single atomic tmux
      # command list — the previous implementation ran split-window/break-pane
      # as direct external subprocesses, the exact thing that crashes CC.
      # Mirrors `tmuxy tab create` (cmd_tab).
      echo "Note: new-window intercepted for safety. Using split-window + break-pane." >&2
      local name_arg=""
      while [ $# -gt 0 ]; do
        case "$1" in
          -n) name_arg="$2"; shift 2 ;;
          *) shift ;;
        esac
      done
      if [ -n "$name_arg" ]; then
        _run_safe "splitw \\; breakp -t '#{session_id}:' -n $(shquote "$name_arg")"
      else
        _run_safe "splitw \\; breakp -t '#{session_id}:'"
      fi
      ;;

    resize-window|resizew)
      echo "Error: resize-window is blocked — it is unreliable with control mode attached (ignored when sent externally). Use resize-pane." >&2
      return 1
      ;;

    *)
      _run_safe "$tmux_cmd $(shquote "$@")"
      ;;
  esac
}

# --- Connect to a different tmux server (desktop app) ---

cmd_connect() {
  case "${1:-}" in
    --help|-h) usage_connect; return ;;
    "")
      # No socket given → open the interactive "add a server" form, which the
      # server binary carries. Replaces the current process so it owns the
      # pane (the desktop app runs this in a float); the TUI persists to
      # servers.json and exits.
      find_server_cmd
      exec "${SERVER_CMD[@]}" connect
      ;;
  esac

  local socket="$1"
  local session="${2:-}"

  # Target socket flag: a slash means a full socket path (-S), else a name (-L).
  local target_flag="-L"
  case "$socket" in */*) target_flag="-S" ;; esac

  # Resolve the session when the caller didn't name one: prefer the target
  # server's first existing session, otherwise fall back to `tmuxy` (which the
  # app creates on attach). Querying the target socket directly is read-only
  # and safe even though it's a different server.
  if [ -z "$session" ]; then
    # `|| true` so a missing/empty target server (list-sessions exits non-zero)
    # doesn't trip `set -e`/pipefail; fall back to `tmuxy`.
    # Skip the hidden __tmuxy_stash session (it parks group members and sorts
    # before real sessions, so a naive `head -1` would attach to it).
    session="$(command tmux "$target_flag" "$socket" list-sessions -F '#{session_name}' 2>/dev/null | grep -vFx '__tmuxy_stash' | head -1 || true)"
    [ -z "$session" ] && session="tmuxy"
  fi

  # Publish the request on the CURRENT server via run-shell (control-mode safe).
  # The desktop app's connect watcher reads these and reconnects.
  # Session first, socket last: the desktop app's watcher triggers on
  # TMUXY_CONNECT_TO, so it must be the final write or the poll can fire
  # between the two and reconnect to the default session.
  _run_safe "set-environment -g TMUXY_CONNECT_SESSION $(shquote "$session")"
  _run_safe "set-environment -g TMUXY_CONNECT_TO $(shquote "$socket")"

  echo "Requested desktop app reconnect to socket '$socket' (session '$session')."
  echo "No effect in the web UI — the web server's socket is fixed at launch."
}

# --- Main dispatcher ---

case "${1:-}" in
  pane)
    shift
    cmd_pane "$@"
    ;;
  tab)
    shift
    cmd_tab "$@"
    ;;
  session)
    shift
    cmd_session "$@"
    ;;
  nav)
    shift
    cmd_nav "$@"
    ;;
  widget)
    shift
    cmd_widget "$@"
    ;;
  open)
    shift
    case "${1:-}" in
      --help|-h)
        cat <<'OEOF'
Usage: tmuxy open [--color-filter] <file|url|host|->

Show a page in a browser pane: a local HTML, markdown or image file, a
website, or a host — `localhost:3000`, `192.168.1.10:8080` and
`example.com/docs` are read as addresses when no such file exists. `-`
renders markdown from stdin. The same as `tmuxy widget browser`.

A website opens in `tmuxy browser` — a real engine drawn in the pane, under
an address bar — so a site that refuses to be framed still shows. Files,
markdown and images are drawn by the app, in the theme.

Options:
  --color-filter  Recolour a page or an image into the theme's colours
  --resolve       Print what the target resolves to and open nothing
OEOF
        ;;
      "") echo "Error: file, url or host required" >&2; exit 1 ;;
      *) open_target "$@" ;;
    esac
    ;;
  tree)
    shift
    case "${1:-}" in
      --help|-h) usage_tree ;;
      *)
        # Standalone tree binary (v86 guest and other server-less installs)
        if command -v tmuxy-tree &>/dev/null; then
          exec tmuxy-tree "$@"
        fi
        find_server_cmd
        exec "${SERVER_CMD[@]}" tree "$@"
        ;;
    esac
    ;;
  browser)
    shift
    case "${1:-}" in
      --help | -h)
        cat <<'BEOF'
Usage: tmuxy browser [--session NAME] [--attach[=ENDPOINT]] [--color-filter]
                     [--viewport auto|desktop|mobile] [url]

Turn this pane into a browser: a real engine draws the page IN THE PANE as an
inline image, under the app's address bar (back, forward, refresh, the
address, page size, open externally). The mouse and keyboard reach the page. It shows
sites that refuse to be framed and works the same in the web UI and the
desktop app. `tmuxy open <website>` opens one too.

`:` opens a command line on the bottom row for the verbs below, whose output
prints there. Another pane or an agent drives it with
`tmuxy pane send -t %ID ':goto example.com' Enter` and reads the answer back
with `tmuxy pane capture` — no API needed. ctrl+c leaves.

The engine is your own Chrome/Chromium/Edge/Brave; tmuxy ships none. Set
TMUXY_CHROME to choose one.

Verbs (after `:`):
  goto <url>              navigate (a bare host gets a scheme)
  eval <js>               evaluate in the page and print the result
  click <selector>        click the first match
  type <selector> <text>  focus a selector and type
  wait <selector>         block until a selector exists
  text [selector]         the visible text of the page, or of one element
  title | url             the page's title or current URL
  shot [path]             save a PNG
  back | forward | reload history
  viewport auto|desktop|mobile  lay out for the pane, 1440x900 or 400x800
  repl [on|off]           show the verb log in the pane instead of the picture
                          (the toolbar's REPL button does the same); bare toggles

Options:
  --session NAME     Which session (default: one per pane); names the
                     throwaway profile, so one engine per name
  --attach[=ENDPOINT] Drive a browser that is already running, by DevTools
                     endpoint (`ws://...`, or `http://127.0.0.1:PORT`); bare,
                     it finds one: a profile's DevToolsActivePort, else a
                     listener on 127.0.0.1:9222. For the desktop app's own
                     browser, or for your REAL profile with its logins — which
                     Chrome 144+ exposes after the consent prompt at
                     chrome://inspect/#remote-debugging (older Chrome: start it
                     with --remote-debugging-port and a --user-data-dir). The
                     page is still drawn in the pane and still takes the mouse
                     and keys; the browser is left running when the pane
                     closes. Put the url BEFORE a bare --attach.
                     The picture is only meaningful when the server is the
                     machine with the screen: over SSH the browser is on the
                     server, and this pane is where you see it.
  --color-filter     Recolour the page into the theme's colours
  --viewport SIZE    What the page lays out for: auto (the pane, the
                     default), desktop (1440x900) or mobile (400x800)

In a pane, `TMUXY_CELL_PX=WxH` overrides the cell size used to size the page
when the terminal does not report one.

Examples:
  tmuxy browser localhost:3000
  tmuxy pane float --width 160 --height 48 tmuxy browser github.com
  tmuxy browser --session agent1
  tmuxy browser github.com --attach          # in the browser you are logged in to
  tmuxy browser --attach=http://127.0.0.1:9222
BEOF
        exit 0
        ;;
    esac
    # Straight to the binary: the pane program IS `tmuxy browser`, which draws
    # its own screen. It is told where THIS CLI is, so it can write its
    # restore tag through `tmuxy pane restore-cmd` wherever tmuxy is installed.
    find_server_cmd
    TMUXY_CLI="$SELF" exec "${SERVER_CMD[@]}" browser "$@"
    ;;
  cleanup)
    shift
    case "${1:-}" in
      --help | -h)
        cat <<'CEOF'
Usage: tmuxy cleanup [-n|--dry-run] [-q|--quiet]

Reap shells left hanging in the kernel by a pane that died while its shell was
still starting up. Each one holds a PTY slave open, and enough of them exhaust
the machine's pseudoterminals so that no new pane can be created.

Options:
  -n, --dry-run  List what would be reaped and exit
  -q, --quiet    Print nothing
CEOF
        exit 0
        ;;
    esac
    exec "$SCRIPTS_DIR/reap-orphan-shells" "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  connect)
    shift
    cmd_connect "$@"
    ;;
  server)
    shift
    find_server_cmd
    exec "${SERVER_CMD[@]}" "$@"
    ;;
  trace)
    shift
    # Inspect/export a local action-trace file (docs/TELEMETRY.md).
    if [ "$1" = "check" ] || [ "$1" = "health" ]; then
      shift
      find_server_cmd
      exec "${SERVER_CMD[@]}" trace --health "$@"
    fi
    find_server_cmd
    exec "${SERVER_CMD[@]}" trace "$@"
    ;;
  config)
    shift
    cmd_config "$@"
    ;;
  info)
    shift
    cmd_info "$@"
    ;;
  skill)
    shift
    cmd_skill "$@"
    ;;
  agent)
    shift
    cmd_agent "$@"
    ;;
  --json|-j)
    shift
    cmd_info --json "$@"
    ;;
  --version|-V|version)
    echo "tmuxy $TMUXY_VERSION"
    ;;
  gui)
    shift
    find_server_cmd
    exec "${SERVER_CMD[@]}" gui "$@"
    ;;
  --help|-h)
    usage
    ;;
  "")
    cmd_info
    echo ""
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Hint: run 'tmuxy --help' for available commands, or 'tmuxy skill' for the AI agent guide." >&2
    usage >&2
    exit 1
    ;;
esac
