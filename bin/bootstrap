#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

for cmd in node npm cargo rustup; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "[bootstrap] missing command: $cmd"
    exit 1
  fi
done

echo "[bootstrap] Installing npm dependencies"
npm ci

echo "[bootstrap] Ensuring Rust targets"
# shellcheck disable=SC2046 # one target per word
rustup target add $(bin/toolchain rust-targets) >/dev/null

echo "[bootstrap] Ensuring frontend dist placeholder"
mkdir -p packages/tmuxy-ui/dist

# Only where nothing answers to `tmuxy` yet: an installed app writes its own
# wrapper at this path, and a link over it would point the user's tmuxy at
# this checkout.
if [ ! -e "$HOME/.local/bin/tmuxy" ]; then
  echo "[bootstrap] Linking tmuxy CLI"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$ROOT_DIR/packages/tmuxy-cli/bin/tmuxy-cli" "$HOME/.local/bin/tmuxy"
fi

echo "[bootstrap] Done"
