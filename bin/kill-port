#!/usr/bin/env bash
#
# Kill any process listening on a given TCP port.
#
# `lsof` where there is one (macOS, most Linux); the /proc scan below is for a
# minimal container without lsof, fuser or ss. The scan is Linux-only, and on
# a Mac it used to find nothing and say nothing — so the `predev` hooks that
# call this started a second dev server on a port the last one still held.
#
# Usage: kill-port <port>
#

PORT="${1:?Usage: kill-port <port>}"

if command -v lsof >/dev/null 2>&1; then
  PIDS=$(lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)
  for pid in $PIDS; do
    echo "[kill-port] Killing PID $pid on port $PORT"
    kill "$pid" 2>/dev/null || true
  done
  # Wait briefly for processes to exit
  [ -n "$PIDS" ] && sleep 1
  exit 0
fi

HEX=$(printf '%04X' "$PORT")

# Collect socket inodes listening (state 0A = LISTEN) on this port
INODES=()
for proto in /proc/net/tcp /proc/net/tcp6; do
  [ -f "$proto" ] || continue
  while read -r _ local _ state _ _ _ _ _ inode _; do
    if [[ "$local" == *":$HEX" && "$state" == "0A" ]]; then
      INODES+=("$inode")
    fi
  done < "$proto"
done

[ ${#INODES[@]} -eq 0 ] && exit 0

# Find PIDs owning those inodes
PIDS=()
for pid_dir in /proc/[0-9]*; do
  pid="${pid_dir##*/}"
  fd_dir="$pid_dir/fd"
  [ -d "$fd_dir" ] || continue
  for fd in "$fd_dir"/*; do
    link=$(readlink "$fd" 2>/dev/null) || continue
    for inode in "${INODES[@]}"; do
      if [[ "$link" == "socket:[$inode]" ]]; then
        PIDS+=("$pid")
      fi
    done
  done
done

# Deduplicate and kill
declare -A seen
for pid in "${PIDS[@]}"; do
  if [ -z "${seen[$pid]}" ]; then
    seen[$pid]=1
    echo "[kill-port] Killing PID $pid on port $PORT"
    kill "$pid" 2>/dev/null || true
  fi
done

# Wait briefly for processes to exit
sleep 1
