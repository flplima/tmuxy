#!/usr/bin/env bash
#
# The toolchain facts every environment is built with, written down once.
# The CI workflows and their composite actions, the devcontainer image
# (.devcontainer/Dockerfile copies this file in, as it copies
# bin/install-dev-tools), bin/bootstrap and bin/install-dev-tools all ask
# here.
#
# Usage:
#   bin/toolchain node-version          the Node release CI and the image run
#   bin/toolchain tmux-version          the tmux CI, the image and docs/TMUX.md target
#   bin/toolchain rust-targets          the rustup targets past the host's: wasm32 for
#                                       tmuxy-wasm, i686-musl for the guests' tmuxy-verbs
#   bin/toolchain tauri-driver-version  the driver the desktop suites run the app under
#   bin/toolchain wasm-bindgen-version  the wasm-bindgen Cargo.lock pins, for installing
#                                       the matching CLI
#   bin/toolchain packages <set>        apt package names, space-separated:
#                                         tmux-build       what a tmux release builds with
#                                         tmux-build-head  the same, for tmux master
#                                         webkit-dev       the headers the desktop crate links
#                                         desktop-test     Xvfb and the WebKit WebDriver
#                                         chromium-fonts   the faces headless Chromium renders with
#   bin/toolchain build-tmux [<version>|HEAD]
#                                       build tmux from source (the pin by default) and
#                                       install it under /usr/local; needs `packages
#                                       tmux-build` (`tmux-build-head` for HEAD)
set -euo pipefail

NODE_VERSION=22
TMUX_VERSION=3.7a
RUST_TARGETS=(wasm32-unknown-unknown i686-unknown-linux-musl)
TAURI_DRIVER_VERSION=2.0.6

# The CLI and the crate must agree EXACTLY on the bindgen schema, so the
# version is read from the lockfile rather than written here: a hand-kept pin
# drifts the moment anything runs `cargo update`, and the failure is a
# schema-mismatch error a long way from the change that caused it.
wasm_bindgen_version() {
  local lock version
  lock="$(cd "$(dirname "$0")/.." && pwd)/Cargo.lock"
  version=$(awk '/^name = "wasm-bindgen"$/{f=1; next} f && /^version = /{gsub(/["]/,""); sub(/version = /,""); print; exit}' "$lock")
  if [ -z "$version" ]; then
    echo "no wasm-bindgen in $lock" >&2
    exit 1
  fi
  printf '%s\n' "$version"
}

# Whether apt can install a package by this name. Reads apt's whole answer:
# under pipefail, a grep -q that stops early would fail the pipe on SIGPIPE.
has_candidate() {
  LC_ALL=C apt-cache policy "$1" 2>/dev/null | grep 'Candidate: [^(]' >/dev/null
}

packages() {
  case "${1:-}" in
    tmux-build) echo libevent-dev libncurses-dev bison ;;
    # master has no release tarball and no generated configure script.
    tmux-build-head) echo libevent-dev libncurses-dev bison autoconf automake pkg-config ;;
    webkit-dev)
      echo libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev librsvg2-dev
      ;;
    desktop-test)
      # WebKitWebDriver's package was renamed in Ubuntu 26.04; Debian and
      # older Ubuntu still call it webkit2gtk-driver. Asked of the apt index,
      # so it is right only after an `apt-get update`. The question is whether
      # the new name has an install candidate: 22.04's index knows the name
      # (`apt-cache show` succeeds) with nothing installable behind it.
      local webdriver=webkit2gtk-driver
      if has_candidate webkitgtk-webdriver; then
        webdriver=webkitgtk-webdriver
      fi
      echo xvfb x11-utils "$webdriver"
      ;;
    # The list Playwright's own install-deps uses for Chromium. Without the CJK
    # and emoji faces headless Chromium measures a fullwidth glyph as a 1-cell
    # fallback box, and the wide-glyph stories and E2E tests assert real cell
    # widths: a container and a runner installing the same list measure alike.
    # xfonts-cyrillic is Ubuntu's: Debian keeps it in non-free, which the
    # devcontainer image's base does not enable, so it is asked of the apt
    # index like the WebDriver above.
    chromium-fonts)
      local cyrillic=""
      if has_candidate xfonts-cyrillic; then cyrillic=xfonts-cyrillic; fi
      # shellcheck disable=SC2086 # empty when there is none
      echo fonts-freefont-ttf fonts-ipafont-gothic fonts-liberation fonts-noto-color-emoji \
        fonts-tlwg-loma-otf fonts-unifont fonts-wqy-zenhei $cyrillic xfonts-scalable
      ;;
    *)
      echo "unknown package set: ${1:-} (tmux-build, tmux-build-head, webkit-dev, desktop-test, chromium-fonts)" >&2
      exit 2
      ;;
  esac
}

build_tmux() {
  local version="${1:-$TMUX_VERSION}" work sudo=""
  if [ "$(id -u)" -ne 0 ]; then sudo=sudo; fi
  work="$(mktemp -d)"
  if [ "$version" = HEAD ]; then
    git clone --depth 1 https://github.com/tmux/tmux.git "$work/tmux"
    local commit
    commit="$(git -C "$work/tmux" rev-parse HEAD)"
    echo "tmux master commit: $commit"
    if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
      echo "tmux master commit: $commit" >>"$GITHUB_STEP_SUMMARY"
    fi
    (cd "$work/tmux" && sh autogen.sh)
  else
    curl -fsSL "https://github.com/tmux/tmux/releases/download/$version/tmux-$version.tar.gz" |
      tar xz -C "$work"
    mv "$work/tmux-$version" "$work/tmux"
  fi
  (cd "$work/tmux" && ./configure && make -j"$(nproc)" && $sudo make install)
  rm -rf "$work"
}

case "${1:-}" in
  node-version) echo "$NODE_VERSION" ;;
  tmux-version) echo "$TMUX_VERSION" ;;
  rust-targets) echo "${RUST_TARGETS[*]}" ;;
  tauri-driver-version) echo "$TAURI_DRIVER_VERSION" ;;
  wasm-bindgen-version) wasm_bindgen_version ;;
  packages) packages "${2:-}" ;;
  build-tmux) build_tmux "${2:-}" ;;
  *)
    echo "usage: bin/toolchain node-version | tmux-version | rust-targets | tauri-driver-version | wasm-bindgen-version | packages <set> | build-tmux [<version>|HEAD]" >&2
    exit 2
    ;;
esac
