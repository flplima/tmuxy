#!/bin/bash
# Collapsible panes (zellij-style stacks), at the window's first level.
#
#   stack new <pane_id>    Turn the pane's window collapsible and add a new
#                          first-level row below (a full-width horizontal
#                          split). The backend then keeps only the row holding
#                          the active pane expanded; every other first-level
#                          row collapses to one line per pane (the header).
#   stack off <window_id>  Turn the feature off. The backend evens the
#                          first-level rows back out.
#
# The flag is the @tmuxy-collapsible window option (docs/TMUX.md). Everything
# that reshapes the window lives in tmuxy-core (`layout.rs`,
# `collapsible_layout_commands`): it reacts to the option, to focus changes and
# to layout changes, and only ever touches the first level — panes nested
# inside a row keep their proportions, so navigating among them changes
# nothing.
set -euo pipefail
source "${0%/*}/_lib"

COLLAPSIBLE_OPT="@tmuxy-collapsible"
CMD="${1:-}"

case "$CMD" in
  new)
    PANE_ID="${2:?pane id required}"
    WID=$(pane_window "$PANE_ID")
    cwd=$(_tmux display-message -t "$PANE_ID" -p '#{pane_current_path}')
    _tmux set-option -w -t "$WID" "$COLLAPSIBLE_OPT" 1
    # -f: the new pane spans the full window width, i.e. it is a first-level
    # row of the window rather than a split of whatever pane was active.
    _tmux split-window -v -f -t "$PANE_ID" -c "$cwd"
    ;;
  off)
    WID="${2:?window id required}"
    _tmux set-option -u -w -t "$WID" "$COLLAPSIBLE_OPT"
    ;;
  relayout)
    # A tmux server that loaded the previous config still runs this from its
    # after-select-pane hook until it re-sources the config. The backend does
    # the reshaping now, so there is nothing left to do here.
    ;;
  *)
    echo "usage: stack new <pane_id> | stack off <window_id>" >&2
    exit 1
    ;;
esac
