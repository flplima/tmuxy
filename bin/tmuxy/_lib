#!/bin/bash
# Shared helpers for tmuxy shell scripts.
#
# Window typing is sourced from the @tmuxy-window-type window option, with
# values: float | float-backdrop | sidebar-left | sidebar-right. A window
# without @tmuxy-window-type is a tab.
#
# Pane groups are identified by a per-pane @tmuxy-group-id option (e.g. g5) set
# on every member. The visible member lives in the attached session; the hidden
# members are parked in the dedicated __tmuxy_stash session (one window each),
# so a native `tmux attach` never sees them. Membership follows the pane across
# a cross-session swap-pane, so there is no separate list to keep in sync.

# The session hidden pane-group members are parked in. Kept out of every session
# picker/tree (matches tmuxy-core `STASH_SESSION`).
STASH_SESSION="__tmuxy_stash"

# Resolved with parameter expansion, not `dirname`. These scripts run from
# `run-shell` on a keypress, and every external binary is another process
# spawn — tens of milliseconds on macOS, felt latency for something the shell
# does for free. The `cd`+`pwd` fork survives only for the relative-path case,
# which `run-shell` and `tmuxy-cli` never produce.
_dir="${0%/*}"
[ "$_dir" = "$0" ] && _dir="."
case "$_dir" in
  /*) SCRIPTS_DIR="$_dir" ;;
  *) SCRIPTS_DIR="$(cd "$_dir" && pwd)" ;;
esac

# Derive TMUX_SOCKET from TMUX env var if not already set.
# Inside run-shell, TMUX is e.g. "/tmp/tmux-1000/tmuxy-dev,110,9" — extract
# the socket name (basename of the path before the first comma). Outside any
# tmux, fall back to the dedicated `tmuxy` socket (never the user's default
# tmux server).
if [ -z "${TMUX_SOCKET:-}" ] && [ -n "${TMUX:-}" ]; then
  _path="${TMUX%%,*}"
  TMUX_SOCKET="${_path##*/}"
fi
TMUX_SOCKET="${TMUX_SOCKET:-tmuxy}"
export TMUX_SOCKET
# A TMUX_SOCKET containing a slash is a full socket path (-S); otherwise a
# socket name in tmux's default directory (-L).
case "$TMUX_SOCKET" in
  */*) TMUX_SOCKET_FLAG="-S" ;;
  *) TMUX_SOCKET_FLAG="-L" ;;
esac
export TMUX_SOCKET_FLAG

# Wrap tmux to target the resolved socket. Using an explicit socket flag
# bypasses the TMUX env var, which returns corrupted list-windows results
# inside run-shell (tmux 3.5a bug).
_tmux() {
  command tmux "$TMUX_SOCKET_FLAG" "$TMUX_SOCKET" "$@"
}

# Route a mutating tmux command through run-shell. These scripts run inside a
# live pane with a control-mode client attached (the UI spawns them in floats),
# so direct external mutations (new-session, set-environment, …) can crash the
# tmux server on 3.5a — run-shell executes them in the server's own context.
_run_safe() {
  _tmux run-shell "tmux $TMUX_SOCKET_FLAG $TMUX_SOCKET $*"
}

# Get the window type set on a window via @tmuxy-window-type.
# Args: $1=window_id (e.g., @5)
# Output: float|float-backdrop|sidebar-left|sidebar-right  (empty for a tab)
window_type() {
  _tmux show-options -wqv -t "$1" @tmuxy-window-type 2>/dev/null
}

# The window id of a sidebar column, if that column currently exists.
# Args: $1=left|right
# Output: window id (e.g. @7), or empty.
sidebar_window() {
  _tmux list-windows -F '#{window_id} #{@tmuxy-window-type}' 2>/dev/null \
    | awk -v t="sidebar-$1" '$2 == t { print $1; exit }'
}

# Ask the connected clients to move keyboard focus somewhere no tmux command
# can: into a sidebar column, or back out to the panes. Focusing a sidebar is a
# client-side concept — its pane lives in another window, so `select-pane` would
# switch the visible tab — which leaves the shell no way to do it directly.
#
# The request is a session option; it rides the client's existing list-windows
# poll (it is read as a per-window column, but set at session scope so every row
# carries it) and the client that acts on it unsets it. See
# `tmux_options::FOCUS_REQUEST` in tmuxy-core.
# Args: $1=left|right|panes
request_focus() {
  _tmux set-option -t "$(_tmux display-message -p '#{session_name}')" \
    @tmuxy-focus-request "$1" 2>/dev/null || true
  # tmux emits no control-mode notification for a user option, so left alone
  # the request would sit until the backend's next window event or idle
  # heartbeat (15 s). Poke a window event out of tmux instead: renaming a
  # sidebar's chrome window to the name it already has emits %window-renamed
  # and nothing else — chrome windows are not tabs, so no label changes and
  # automatic-rename was never on for them. The backend re-lists windows on
  # the event and the client sees the request within a round trip.
  local target_side="$1" poke_win
  [ "$target_side" = "panes" ] && target_side="left"
  poke_win=$(sidebar_window "$target_side")
  [ -n "$poke_win" ] || poke_win=$(sidebar_window right)
  if [ -n "$poke_win" ]; then
    _run_safe "rename-window -t $poke_win __sidebar-$(window_type "$poke_win" | sed 's/^sidebar-//')"
  fi
}

# Ensure the stash session exists, creating it detached if needed.
# new-session -d (a detached, separate session) is control-mode safe — unlike
# new-window, which crashes the server — and the core suppresses the resulting
# %sessions-changed. Idempotent.
ensure_stash_session() {
  if ! _tmux has-session -t "$STASH_SESSION" 2>/dev/null; then
    _tmux new-session -d -s "$STASH_SESSION" -x 80 -y 24 2>/dev/null || true
  fi
}

# Read a pane's @tmuxy-group-id.
# Args: $1=pane_id
# Output: group id (e.g. g5), or empty if the pane is not grouped.
group_id_of_pane() {
  _tmux show-options -pqv -t "$1" @tmuxy-group-id 2>/dev/null
}

# Set a pane's @tmuxy-group-id.
# Args: $1=pane_id  $2=group_id
set_group_id() {
  _tmux set-option -p -t "$1" @tmuxy-group-id "$2"
}

# Clear a pane's @tmuxy-group-id (degroup a lone survivor).
# Args: $1=pane_id
clear_group_id() {
  _tmux set-option -pu -t "$1" @tmuxy-group-id 2>/dev/null || true
}

# Mint a fresh group id from an anchor pane id: %5 -> g5. Pane ids are never
# reused within a server, so this is unique and stable for the group's life.
# Args: $1=anchor_pane_id
new_group_id() {
  echo "g${1#%}"
}

# List every pane belonging to a group, ordered by pane-id number (stable).
# Args: $1=group_id
# Output: pane ids, one per line (e.g. %4\n%6\n%7)
group_members() {
  local gid="$1"
  _tmux list-panes -a -F '#{pane_id} #{@tmuxy-group-id}' \
    | awk -v g="$gid" '$2 == g { print $1 }' \
    | sort -t'%' -k2,2n
}

# The visible member of a group — the one NOT parked in the stash session.
# Args: $1=group_id
# Output: pane id, or empty.
visible_member() {
  local gid="$1"
  _tmux list-panes -a -F '#{session_name} #{pane_id} #{@tmuxy-group-id}' \
    | awk -v g="$gid" -v stash="$STASH_SESSION" \
        '$3 == g && $1 != stash { print $2; exit }'
}

# Kill stash windows for any group that has no visible member left (its tab was
# closed wholesale, orphaning the hidden members). Idempotent; safe to call
# after any group mutation.
gc_groups() {
  _tmux list-panes -a -F '#{session_name} #{window_id} #{pane_id} #{@tmuxy-group-id}' \
    | awk -v stash="$STASH_SESSION" '
        $4 != "" {
          if ($1 == stash) { stash_win[$4] = stash_win[$4] " " $2 }
          else { has_visible[$4] = 1 }
        }
        END {
          for (g in stash_win) {
            if (!(g in has_visible)) print stash_win[g]
          }
        }' \
    | tr ' ' '\n' | sort -u | while read -r wid; do
        [ -n "$wid" ] && _tmux kill-window -t "$wid" 2>/dev/null || true
      done
}

# Get active window ID
active_window() {
  _tmux display-message -p '#{window_id}'
}

# Get a pane's window ID
pane_window() {
  _tmux display-message -t "$1" -p '#{window_id}'
}

# Force a list-panes refresh (so server pushes new state to clients)
refresh_panes() {
  _tmux list-panes -s -F '#{pane_id},#{pane_index},#{pane_left},#{pane_top},#{pane_width},#{pane_height},#{cursor_x},#{cursor_y},#{pane_active},#{pane_current_command},#{pane_title},#{pane_in_mode},#{copy_cursor_x},#{copy_cursor_y},#{window_id}' > /dev/null 2>&1
}
