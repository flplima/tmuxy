#!/bin/bash
# tmuxy queue push / send — publish a message to a named queue
#
# Usage: tmuxy queue push <name> <message>
#        echo "payload" | tmuxy queue push <name> -
#
# Storage: /tmp/tmuxy-queues/<socket>/<name>/msg.<N>
# Signal:  tmux wait-for -S tmuxy_queue_<name>

set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPTS_DIR/_lib"

NAME="${1:?Usage: tmuxy queue push <name> <message|->}"
shift
MSG="${1:--}"

# Read from stdin if "-"
if [ "$MSG" = "-" ]; then
  MSG="$(cat)"
fi

SOCKET="${TMUX_SOCKET:-tmuxy}"
DIR="/tmp/tmuxy-queues/$SOCKET/$NAME"
mkdir -p "$DIR"

# Atomically read+increment the sequence counter. Released on any exit, so a
# killed producer does not wedge the queue for the next one.
_lock_acquire "$DIR"
trap '_lock_release "$DIR"' EXIT
SEQ=$(cat "$DIR/next" 2>/dev/null || echo 0)
echo $((SEQ + 1)) > "$DIR/next"
_lock_release "$DIR"
trap - EXIT

# Write payload atomically (tmp + mv)
printf '%s' "$MSG" > "$DIR/msg.${SEQ}.tmp"
mv "$DIR/msg.${SEQ}.tmp" "$DIR/msg.${SEQ}"

# Signal any blocked consumer
_tmux wait-for -S "tmuxy_queue_${NAME}" 2>/dev/null || true
