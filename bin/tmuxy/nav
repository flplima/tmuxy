#!/bin/bash
# Unified navigation across groups, pane splits and the sidebar columns
# Args: $1=direction (left|right|up|down|next|prev), $2=current pane_id
#
# left/right: group panes (circular) → pane splits (horizontal) → sidebar column
# up/down:    pane splits only (vertical neighbors, no fallback)
# next:       same as right
# prev:       last-pane in window, fall back to last-window
#
# Leaving the grid sideways lands in a sidebar. Its pane lives in its own window,
# so `select-pane` can't reach it without switching the visible tab — the move is
# published as a focus request the client acts on instead (see `request_focus`).

set -euo pipefail
source "$(dirname "$0")/_lib"

DIR="$1"
PANE_ID="$2"

nav_prev() {
  # Try last-pane (switches to last active pane in current window)
  local before after
  before=$(_tmux display-message -p '#{pane_id}')
  _tmux last-pane 2>/dev/null || true
  after=$(_tmux display-message -p '#{pane_id}')
  if [ "$before" != "$after" ]; then
    refresh_panes
    return
  fi
  # Only 1 pane — try last-window
  _tmux last-window 2>/dev/null || true
  refresh_panes
}

nav_vertical() {
  local tmux_dir="$1"
  _tmux selectp "$tmux_dir"
  refresh_panes
}

nav_horizontal() {
  local tmux_dir="$1"   # -R or -L
  local edge_dir="$2"   # "right" or "left"

  # Step 0: already inside a sidebar column — the only way out is back to the
  # panes, and only when heading away from that column's edge.
  local current_type
  current_type=$(window_type "$(active_window)")
  case "$current_type" in
    sidebar-left)  [ "$edge_dir" = "right" ] && request_focus panes; return ;;
    sidebar-right) [ "$edge_dir" = "left" ]  && request_focus panes; return ;;
  esac

  # Step 1: if the pane is in a group, cycle within the group (circular).
  local gid
  gid=$(group_id_of_pane "$PANE_ID")

  if [ -n "$gid" ]; then
    local members count
    members=$(group_members "$gid")
    count=$(printf '%s\n' "$members" | grep -c . || true)

    if [ "$count" -gt 1 ]; then
      local visible_pane
      visible_pane=$(visible_member "$gid")

      if [ -n "$visible_pane" ]; then
        local target
        target=$(printf '%s\n' "$members" | awk -v v="$visible_pane" -v dir="$edge_dir" '
          { m[NR] = $0 }
          END {
            for (i = 1; i <= NR; i++) if (m[i] == v) {
              print (dir == "right") ? m[(i % NR) + 1] : m[(i == 1 ? NR : i - 1)]
              exit
            }
          }')
        if [ -n "$target" ] && [ "$target" != "$visible_pane" ]; then
          exec "$SCRIPTS_DIR/pane-group-switch" "$target"
        fi
        return
      fi
    fi
  fi

  # Step 2: Try tmux directional select (no tab fallback)
  local before after
  before=$(_tmux display-message -p '#{pane_id}')
  _tmux selectp "$tmux_dir" 2>/dev/null || true
  after=$(_tmux display-message -p '#{pane_id}')
  refresh_panes

  # Step 3: the select was a no-op, so the pane is at that edge of the grid. If
  # a sidebar is docked there, that is the next thing along.
  if [ "$before" = "$after" ] && [ -n "$(sidebar_window "$edge_dir")" ]; then
    request_focus "$edge_dir"
  fi
}

case "$DIR" in
  left)
    nav_horizontal "-L" "left"
    ;;
  right|next)
    nav_horizontal "-R" "right"
    ;;
  up)
    nav_vertical "-U"
    ;;
  down)
    nav_vertical "-D"
    ;;
  prev)
    nav_prev
    ;;
esac
