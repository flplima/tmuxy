#!/bin/bash
# Unified navigation across groups, pane splits and the sidebar columns
# Args: $1=direction (left|right|up|down|next|prev), $2=current pane_id
#
# left/right: group panes (circular) → pane splits (horizontal) → sidebar column
# up/down:    pane splits only (vertical neighbors, no fallback)
# next:       same as right
# prev:       last-pane in window, fall back to last-window
#
# Leaving the grid sideways lands in a sidebar. Its pane lives in its own window,
# so `select-pane` can't reach it without switching the visible tab — the move is
# published as a focus request the client acts on instead (see `request_focus`).

set -euo pipefail
source "${0%/*}/_lib"

DIR="$1"
PANE_ID="$2"

nav_prev() {
  # Try last-pane (switches to last active pane in current window)
  local before after
  before=$(_tmux display-message -p '#{pane_id}')
  _tmux last-pane 2>/dev/null || true
  after=$(_tmux display-message -p '#{pane_id}')
  if [ "$before" != "$after" ]; then
    refresh_panes
    return
  fi
  # Only 1 pane — try last-window
  _tmux last-window 2>/dev/null || true
  refresh_panes
}

nav_vertical() {
  local tmux_dir="$1"
  _tmux selectp "$tmux_dir" -t "$PANE_ID"
  refresh_panes
}

nav_horizontal() {
  local tmux_dir="$1"   # -R or -L
  local edge_dir="$2"   # "right" or "left"

  # Everything the decision below needs, in ONE tmux call. A `display-message`
  # aimed at a PANE resolves the window-scoped @tmuxy-window-type and the
  # pane-scoped @tmuxy-group-id alongside the edge flag, so what used to be
  # four process spawns on every Ctrl+h / Ctrl+l is one. The always-present
  # edge flag goes last on purpose: `$( )` strips trailing newlines, so an
  # option that happens to be unset must never be the final field.
  local probe current_type gid at_edge
  probe=$(_tmux display-message -t "$PANE_ID" -p "#{@tmuxy-window-type}
#{@tmuxy-group-id}
#{pane_at_$edge_dir}")
  {
    IFS= read -r current_type || true
    IFS= read -r gid || true
    IFS= read -r at_edge || true
  } <<EOF
$probe
EOF

  # Step 0: already inside a sidebar column — the only way out is back to the
  # panes, and only when heading away from that column's edge. The CALLER's
  # pane decides this, not the session's current pane: run from the dock's
  # shell, `display-message` with no target names the tab's active pane, and
  # the branch below would never match.
  case "$current_type" in
    sidebar-left)  [ "$edge_dir" = "right" ] && request_focus panes; return ;;
    sidebar-right) [ "$edge_dir" = "left" ]  && request_focus panes; return ;;
  esac

  # Step 1: if the pane is in a group, cycle within the group (circular).
  if [ -n "$gid" ]; then
    local members count
    members=$(group_members "$gid")
    count=$(printf '%s\n' "$members" | grep -c . || true)

    if [ "$count" -gt 1 ]; then
      local visible_pane
      visible_pane=$(visible_member "$gid")

      if [ -n "$visible_pane" ]; then
        local target
        target=$(printf '%s\n' "$members" | awk -v v="$visible_pane" -v dir="$edge_dir" '
          { m[NR] = $0 }
          END {
            for (i = 1; i <= NR; i++) if (m[i] == v) {
              print (dir == "right") ? m[(i % NR) + 1] : m[(i == 1 ? NR : i - 1)]
              exit
            }
          }')
        if [ -n "$target" ] && [ "$target" != "$visible_pane" ]; then
          exec "$SCRIPTS_DIR/pane-group-switch" "$target"
        fi
        return
      fi
    fi
  fi

  # Step 2: at the grid's edge already? tmux said so in the probe above.
  # (Comparing the active pane before/after a `select-pane -L/-R` does not
  # work: at the edge tmux WRAPS to the opposite side rather than doing
  # nothing.) If a sidebar is docked on that edge, it is the next thing along;
  # otherwise stay put.
  if [ "$at_edge" = "1" ]; then
    if [ -n "$(sidebar_window "$edge_dir")" ]; then
      request_focus "$edge_dir"
    fi
    return
  fi

  # Step 3: a neighbour exists in that direction — move to it.
  _tmux selectp "$tmux_dir" -t "$PANE_ID" 2>/dev/null || true
  refresh_panes
}

case "$DIR" in
  left)
    nav_horizontal "-L" "left"
    ;;
  right|next)
    nav_horizontal "-R" "right"
    ;;
  up)
    nav_vertical "-U"
    ;;
  down)
    nav_vertical "-D"
    ;;
  prev)
    nav_prev
    ;;
esac
