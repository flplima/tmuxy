#!/bin/bash
# Render the session switcher in a tmuxy widget pane
#
# Usage: tmuxy-widget-session
#
# Like the tree widget, this streams no content: the switcher is drawn from the
# session list the app already polls and from the saved servers the desktop
# backend reads, so this only has to declare the widget and keep the pane alive
# so the float stays open.
#
# It replaces the `tmuxy session switch --float` shell prompt: the same choices,
# but rendered by the app rather than read off a pane with `read -rp`.

set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)"

{ while true; do sleep 3600; done; } | "${SCRIPTS_DIR}/tmuxy-widget" session
