#!/bin/bash
# Show a page in a tmuxy browser widget pane
#
# Usage:
#   tmuxy-widget-browser [--color-filter] <file>   Local HTML, markdown or image file
#   tmuxy-widget-browser [--color-filter] <url>    A website, or a remote image/markdown
#   tmuxy-widget-browser [--color-filter] -        Render markdown read from stdin
#   tmuxy-widget-browser --resolve <target>        Print what <target> resolves to, open nothing
#
# A target with no scheme is a file when one exists at that path; otherwise it
# is read the way a browser's address bar reads it: `localhost[:port]` and an
# IPv4 address are `http://`, a name with a dot in it (`example.com/docs`) is
# `https://`. Anything else that is not a file is an error.
#
# --color-filter recolours a page or an image into the theme's colours (dark
# ink to the foreground, light paper to the background). Markdown is already
# drawn in the theme's colours and is left as it is.
#
# The widget takes a single resolved source and shows it: HTML and websites go
# in a frame, markdown is rendered (mermaid included), images are drawn. The
# UI decides which from the source, so this only has to resolve it and keep the
# pane alive — the pipe closing is what tears the widget down.

set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)"
COLOR_FILTER=""
RESOLVE_ONLY=""
while :; do
  case "${1:-}" in
    --color-filter) COLOR_FILTER=1; shift ;;
    --resolve) RESOLVE_ONLY=1; shift ;;
    *) break ;;
  esac
done
SOURCE="${1:?Usage: tmuxy-widget-browser [--color-filter] <file|url|->}"

# What a scheme-less target that is not a file means. Prints the URL, or
# nothing when the target reads as no address at all.
infer_url() {
  local target="$1" host
  host="${target%%/*}"
  host="${host%%:*}"
  # `notes.md` is a file somebody forgot to create, not the `.md` top-level
  # domain: a name that ends in something the widget can show is a file.
  case "$host" in
    *.md|*.markdown|*.html|*.htm|*.png|*.jpg|*.jpeg|*.gif|*.svg|*.webp|*.txt|*.pdf) return 0 ;;
  esac
  case "$target" in
    localhost|localhost:*|localhost/*)
      echo "http://$target" ;;
    *)
      if [[ "$host" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
        echo "http://$target"
      elif [[ "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]]; then
        echo "https://$target"
      fi ;;
  esac
}

if [ "$SOURCE" = "-" ]; then
  # Stdin has nowhere to live: the widget fetches its source by path or URL,
  # and there is no path for a stream. Spill it to a temp file and point the
  # widget at that. Removed when the widget exits.
  #
  # A directory rather than `mktemp <template>.md`: BSD mktemp only substitutes
  # X's at the very end of the template, so asking for a random name with an
  # extension yields a file literally called `XXXXXX.md` — and two stdin
  # browsers would then fight over it.
  # $TMPDIR often ends in a slash; the path becomes the pane's title, so trim it.
  TMPROOT="${TMPDIR:-/tmp}"
  TMPHOME="$(mktemp -d "${TMPROOT%/}"/tmuxy-browser-XXXXXX)"
  trap 'rm -rf "$TMPHOME"' EXIT
  RESOLVED="$TMPHOME/stdin.md"
  cat >"$RESOLVED"
elif [[ "$SOURCE" =~ ^(https?|data): ]]; then
  RESOLVED="$SOURCE"
elif [[ "$SOURCE" != file://* ]] && [ ! -e "$SOURCE" ] && [ -n "$(infer_url "$SOURCE")" ]; then
  # Not a file on disk, but the shape of an address: `localhost:3000`,
  # `192.168.1.10:8080`, `example.com/docs`.
  RESOLVED="$(infer_url "$SOURCE")"
else
  # A file:// URL is just a path written the long way.
  RESOLVED="${SOURCE#file://}"
  if [[ "$RESOLVED" != /* ]]; then
    RESOLVED="$(cd "$(dirname "$RESOLVED")" 2>/dev/null && pwd)/$(basename "$RESOLVED")"
  fi
  if [ ! -f "$RESOLVED" ]; then
    echo "Error: File not found: $RESOLVED" >&2
    exit 1
  fi
fi

if [ -n "$RESOLVE_ONLY" ]; then
  echo "$RESOLVED"
  exit 0
fi

# Emit the source through the widget marker, then block so the pane — and the
# widget rendered in place of it — stays up until the user closes it. The
# colour filter's marker goes first: the source is read as everything after its
# own marker, so anything written later would run into it.
{
  if [ -n "$COLOR_FILTER" ]; then echo "__COLOR_FILTER__"; fi
  echo "__SRC__:${RESOLVED}"
  while true; do sleep 3600; done
} | "${SCRIPTS_DIR}/tmuxy-widget" browser "$(basename "${RESOLVED%%[?#]*}")"
