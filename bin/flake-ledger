#!/usr/bin/env node
/**
 * The flake ledger: what failed on `main` and then passed on a re-run, and
 * which panes the trace health check found silent — over the last few days.
 *
 * A re-run that goes green erases the failure from view: the run is green,
 * nobody opens the first attempt's log, and a race that hits one shard in
 * five runs is never seen as a pattern. This reads the GitHub API for every
 * attempt of every recent `lint and tests` run on main and counts, per test:
 *
 *   - failed on an attempt that a later attempt of the same run passed
 *     (a flake by construction), and
 *   - failed with no later attempt (a real failure, or a flake nobody retried);
 *
 * and lists every "Silent shell pane" warning the E2E jobs' trace health
 * check raised (docs/TELEMETRY.md), green runs included.
 *
 * Usage: bin/flake-ledger [--days N] [--json out.json]
 * Needs `gh` authenticated (GH_TOKEN in CI). Writes markdown to stdout, and to
 * $GITHUB_STEP_SUMMARY when set.
 */

'use strict';

const { execFile, execFileSync } = require('child_process');
const fs = require('fs');

const WORKFLOW = 'lint-and-tests.yml';

/** Jest colours its marks; the colour codes are not part of a test's name. */
const ANSI_COLOUR = new RegExp(`${String.fromCharCode(27)}\\[[0-9;]*m`, 'g');

/** `gh api` for a raw body; '' when the call fails (a log expired, a 404, a timeout). */
function ghText(route) {
  return new Promise((resolve) => {
    execFile(
      'gh',
      // Job logs carry jest's colour codes, which gh refuses to print without this.
      ['api', '--allow-escape-sequences', route],
      { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024, timeout: 120000 },
      (error, stdout) => resolve(error ? '' : stdout),
    );
  });
}

/** `gh api` as JSON; null when the call fails. */
async function gh(route) {
  try {
    return JSON.parse(await ghText(route));
  } catch {
    return null;
  }
}

/** Map with at most `limit` calls in flight: hundreds of API calls, one by one, take an hour. */
async function pool(items, limit, fn) {
  const out = new Array(items.length);
  let next = 0;
  const worker = async () => {
    while (next < items.length) {
      const i = next++;
      out[i] = await fn(items[i], i);
    }
  };
  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
  return out;
}

/**
 * The tests a job log reports as failed: jest's `✕ <name> (<n> ms)` lines.
 * GitHub prefixes each log line with a timestamp; jest may colour the mark.
 */
function failedTests(log) {
  const names = new Set();
  for (const raw of log.split('\n')) {
    const line = raw.replace(ANSI_COLOUR, '');
    // The mark leads the line (after GitHub's timestamp): a passing test's
    // NAME can hold a ✕ too ("click, +, ✕ and drag").
    const m = line.match(/^(?:\S+Z)?\s*✕\s+(.+?)(?:\s+\(\d+\s*ms\))?\s*$/);
    if (m) names.add(m[1].trim());
  }
  return [...names];
}

/** A failed job's tests, or the job's own name when the log names none. */
async function failuresOf(job, repo) {
  const tests = failedTests(await ghText(`repos/${repo}/actions/jobs/${job.id}/logs`));
  return tests.length > 0 ? tests : [`(job failed outside a test: ${job.name})`];
}

/**
 * Fold one run's attempts into ledger entries. `attempts` is the job list per
 * attempt, oldest first; a job failed on attempt N is a flake when the same
 * job passed on a later attempt.
 */
function classify(attempts) {
  const flaky = [];
  const failed = [];
  attempts.forEach((jobs, i) => {
    for (const job of jobs.filter((j) => j.conclusion === 'failure')) {
      const later = attempts
        .slice(i + 1)
        .some((next) => next.some((j) => j.name === job.name && j.conclusion === 'success'));
      (later ? flaky : failed).push({ job, attempt: i + 1 });
    }
  });
  return { flaky, failed };
}

function markdown(ledger) {
  const out = [];
  out.push(`## Flake ledger — last ${ledger.days} days of \`${WORKFLOW}\` on main`);
  out.push('');
  out.push(`${ledger.runs} runs read, ${ledger.reruns} of them re-run.`);
  out.push('');
  const table = (title, rows) => {
    out.push(`### ${title}`);
    out.push('');
    if (rows.length === 0) {
      out.push('None.');
      out.push('');
      return;
    }
    out.push('| count | job | test | runs |');
    out.push('| ---: | --- | --- | --- |');
    for (const r of rows) {
      const links = r.runs.map((u, i) => `[${i + 1}](${u})`).join(' ');
      out.push(`| ${r.count} | ${r.job} | ${r.test.replace(/\|/g, '\\|')} | ${links} |`);
    }
    out.push('');
  };
  table('Failed, then passed on a re-run (flaky)', ledger.flaky);
  table('Failed with no later attempt', ledger.failed);
  out.push('### Silent shell panes (trace health check)');
  out.push('');
  if (ledger.silent.length === 0) {
    out.push('None.');
  } else {
    for (const s of ledger.silent) out.push(`- ${s.job}: ${s.message} ([run](${s.run}))`);
  }
  out.push('');
  return out.join('\n');
}

/** Count rows by (job, test), keeping a link per occurrence. */
function tally(entries) {
  const rows = new Map();
  for (const e of entries) {
    const key = `${e.job}\u0000${e.test}`;
    const row = rows.get(key) ?? { job: e.job, test: e.test, count: 0, runs: [] };
    row.count += 1;
    row.runs.push(e.run);
    rows.set(key, row);
  }
  return [...rows.values()].sort((a, b) => b.count - a.count);
}

async function main() {
  const args = process.argv.slice(2);
  const days = Number(args[args.indexOf('--days') + 1]) || 7;
  const jsonOut = args.includes('--json') ? args[args.indexOf('--json') + 1] : null;
  const repo =
    process.env.GITHUB_REPOSITORY ||
    execFileSync('gh', ['repo', 'view', '--json', 'nameWithOwner', '--jq', '.nameWithOwner'], {
      encoding: 'utf8',
    }).trim();
  const since = new Date(Date.now() - days * 86400000).toISOString().slice(0, 10);
  const LIMIT = 8;

  const runs = [];
  for (let page = 1; page <= 10; page++) {
    const res = await gh(
      `repos/${repo}/actions/workflows/${WORKFLOW}/runs?branch=main&per_page=100&page=${page}&created=>=${since}`,
    );
    if (!res || res.workflow_runs.length === 0) break;
    runs.push(...res.workflow_runs);
  }

  // Every attempt's job list, per run.
  const attemptsByRun = await pool(runs, LIMIT, (run) =>
    Promise.all(
      Array.from({ length: run.run_attempt || 1 }, (_, n) =>
        gh(`repos/${repo}/actions/runs/${run.id}/attempts/${n + 1}/jobs?per_page=100`).then(
          (res) => (res ? res.jobs : []),
        ),
      ),
    ),
  );

  const failures = [];
  const annotationJobs = [];
  runs.forEach((run, r) => {
    const verdict = classify(attemptsByRun[r]);
    for (const { job } of verdict.flaky) failures.push({ kind: 'flaky', job, run });
    for (const { job } of verdict.failed) failures.push({ kind: 'failed', job, run });
    // Silent-pane warnings live as annotations on the E2E jobs, of every attempt.
    for (const job of attemptsByRun[r].flat().filter((j) => j.name.startsWith('e2e ('))) {
      annotationJobs.push({ job, run });
    }
  });

  const flaky = [];
  const failed = [];
  const named = await pool(failures, LIMIT, (f) => failuresOf(f.job, repo));
  failures.forEach((f, i) => {
    for (const test of named[i]) {
      (f.kind === 'flaky' ? flaky : failed).push({ job: f.job.name, test, run: f.run.html_url });
    }
  });

  const silent = [];
  const annotations = await pool(annotationJobs, LIMIT, ({ job }) =>
    gh(`repos/${repo}/check-runs/${job.id}/annotations`),
  );
  annotationJobs.forEach(({ job, run }, i) => {
    for (const a of annotations[i] || []) {
      if (a.title === 'Silent shell pane') {
        silent.push({ job: job.name, message: a.message, run: run.html_url });
      }
    }
  });

  const ledger = {
    days,
    runs: runs.length,
    reruns: runs.filter((run) => (run.run_attempt || 1) > 1).length,
    flaky: tally(flaky),
    failed: tally(failed),
    silent,
  };
  const md = markdown(ledger);
  process.stdout.write(`${md}\n`);
  if (process.env.GITHUB_STEP_SUMMARY) fs.appendFileSync(process.env.GITHUB_STEP_SUMMARY, `${md}\n`);
  if (jsonOut) fs.writeFileSync(jsonOut, JSON.stringify(ledger, null, 2));
}

if (require.main === module) {
  main().catch((error) => {
    process.stderr.write(`flake-ledger: ${error.message}\n`);
    process.exit(1);
  });
}

module.exports = { failedTests, classify, tally, markdown };
