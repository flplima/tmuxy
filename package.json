{
  "name": "tmuxy",
  "version": "0.1.6",
  "private": true,
  "description": "A tmux terminal wrapper - available as Tauri app or web server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flplima/tmuxy.git"
  },
  "homepage": "https://tmuxy.sh/",
  "workspaces": [
    "packages/tmuxy-ui",
    "packages/tmuxy-demo"
  ],
  "scripts": {
    "devcontainer": "bash bin/devcontainer up",
    "build:wasm": "cargo build -p tmuxy-wasm --target wasm32-unknown-unknown --release --no-default-features && wasm-bindgen --target web --out-dir packages/tmuxy-wasm/pkg --out-name tmuxy_wasm target/wasm32-unknown-unknown/release/tmuxy_wasm.wasm",
    "start": "bash bin/dev-server start",
    "stop": "bash bin/dev-server stop",
    "restart": "bash bin/dev-server restart",
    "logs": "bash bin/dev-server logs",
    "test": "vitest run",
    "test:e2e": "jest --runInBand",
    "test:tauri": "NODE_OPTIONS='--experimental-vm-modules' jest --config tests/tauri/jest.config.js",
    "test:cli": "jest --config tests/cli/jest.config.js",
    "perf:interactions": "node packages/tmuxy-ui/scripts/measure-interactions.mjs",
    "perf:interactions:tauri": "node packages/tmuxy-ui/scripts/measure-interactions-tauri.mjs",
    "perf:compare": "node packages/tmuxy-ui/scripts/compare-interactions.mjs",
    "perf:requests": "node packages/tmuxy-ui/scripts/measure-requests.mjs",
    "perf:soak": "node packages/tmuxy-ui/scripts/measure-soak.mjs",
    "lint": "bin/lint-gate check eslint",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .github || true",
    "check:policy": "node bin/ci/policy.mjs",
    "check:fast": "bin/lint-gate check && npm test",
    "check:full": "npm run check:fast && npm run test:cli && TERM=xterm-256color cargo test --workspace"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jest": "^29.15.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "knip": "^5.88.1",
    "playwright": "^1.65.0",
    "vitest": "^4.1.12",
    "webdriverio": "^9.24.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.23",
    "@puppeteer/browsers": "^3.2.2",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    },
    "katex": "^0.18.2",
    "glob@>=9": "^14.0.3",
    "minimatch@>=7": "^11.0.4"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "knip": {
    "ignoreExportsUsedInFile": true,
    "ignoreIssues": {
      "tests/helpers/{config,browser,keyboard,pane-ops,window-ops,pane-groups,copy-mode-ui,e2e-context,glitch-detector,cli,ui-tmux,layout,copy-mode,cell-grid,mouse-capture,selection-drag,menus,layout-helpers}.js": [
        "exports"
      ]
    },
    "ignoreDependencies": [
      "v86"
    ],
    "ignoreBinaries": [
      "wasm-bindgen",
      "bin/lint-gate"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "bin/**/*.mjs",
          "tests/perf/*.mjs",
          "eslint.config.mjs",
          "tests/**/*.test.js",
          "tests/**/jest.*.js",
          "tests/smoke/*.js"
        ],
        "project": [
          "bin/**/*.mjs",
          "tests/perf/**/*.mjs",
          "tests/**/*.js"
        ]
      },
      "packages/tmuxy-ui": {
        "entry": [
          "src/main.tsx",
          "src/kindle/main.ts",
          "src/lib.ts",
          "src/**/*.stories.tsx",
          "src/**/*.test.{ts,tsx}",
          "src/**/__tests__/**/*.{ts,tsx}",
          "src/stories/fixtures/scenarios/*.ts",
          "scripts/*.mjs",
          "eslint-rules/*.mjs",
          ".storybook/*.ts"
        ],
        "project": [
          "src/**/*.{ts,tsx}",
          "scripts/**/*.mjs",
          "eslint-rules/*.mjs",
          ".storybook/*.ts"
        ],
        "ignore": [
          "public/**"
        ]
      },
      "packages/tmuxy-demo": {
        "entry": [
          "app/**/*.tsx",
          "next.config.ts",
          "postcss.config.mjs",
          "scripts/*.mjs"
        ],
        "project": [
          "app/**",
          "components/**",
          "lib/**",
          "scripts/**",
          "*.{ts,mjs}"
        ],
        "ignore": [
          "public/**",
          "out/**"
        ]
      }
    }
  }
}
