#!/bin/bash
# Show the changes of a git checkout in a tmuxy `diff` widget pane
#
# Usage: tmuxy widget diff [folder]
#
#   folder   a folder inside a git checkout; the current one without it
#
# The UI reads the changes through tmuxy, in the scope it is switched to:
# unstaged, staged, or the branch against its base. Which checkout it may
# read is decided here, out of band: the checkout's top folder is a pane
# option, written through `run-shell` before the widget marker and cleared
# on the way out, so nothing the pane prints and nothing a client asks can
# point the diff at another folder (see docs/SECURITY-CONTENT.md). The UI
# reads again while the pane is on screen; nothing is printed under the
# marker but the checkout's name.

set -euo pipefail

# shellcheck source=_lib
source "${0%/*}/_lib"

usage() {
  sed -n '4,6p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --) shift ;;
  -*) _die_usage "Unknown option: $1" usage ;;
esac
if [ $# -gt 1 ]; then
  _die_usage "one folder at most" usage
fi
DIR="${1:-.}"
if [ ! -d "$DIR" ]; then
  _fail "$EXIT_FAILED" "not a folder: $DIR"
fi

take_own_pane "a diff"

# Only where the checkout starts: git runs nothing for `rev-parse`, and the
# hooks and the filesystem monitor are switched off all the same.
ROOT="$(cd "$DIR" && env -u GIT_DIR -u GIT_WORK_TREE git --no-pager \
  -c core.fsmonitor=false -c core.hooksPath=/dev/null \
  rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
if [ -z "$ROOT" ]; then
  _fail "$EXIT_FAILED" "not in a git checkout: $DIR"
fi
case "$ROOT" in
  *$'\n'*) _fail "$EXIT_FAILED" "a folder name with a newline cannot be shown" ;;
esac

PANE="$(shquote "$TMUX_PANE")"
# The checkout goes with this script, as a preview's file does.
trap '_run_safe "set-option -p -u -t $PANE $OPT_PANE_DIFF" || true' EXIT
_run_safe "set-option -p -t $PANE $OPT_PANE_DIFF $(shquote "$ROOT")"

NAME="$(basename "$ROOT")"
hold() {
  echo "$NAME"
  while :; do sleep 3600; done
}

hold | "${SCRIPTS_DIR}/tmuxy-widget" diff "$NAME"
