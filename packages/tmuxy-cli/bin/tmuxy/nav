#!/bin/bash
# Args: $1=direction (left|right|up|down|next|prev), $2=current pane_id

set -euo pipefail
# shellcheck source=_lib
source "${0%/*}/_lib"

DIR="$1"
PANE_ID="$2"

nav_prev() {
  local before after
  before=$(_tmux display-message -p '#{pane_id}')
  _tmux last-pane 2>/dev/null || true
  after=$(_tmux display-message -p '#{pane_id}')
  if [ "$before" != "$after" ]; then
    return
  fi
  _tmux last-window 2>/dev/null || true
}

nav_vertical() {
  local tmux_dir="$1"
  _tmux selectp "$tmux_dir" -t "$PANE_ID"
}

nav_horizontal() {
  local tmux_dir="$1"   # -R or -L
  local edge_dir="$2"   # "right" or "left"

  # A `display-message` aimed at a PANE resolves the window-scoped
  # @tmuxy-window-type and the pane-scoped @tmuxy-group-id alongside the edge
  # flag, in one process spawn on every Ctrl+h / Ctrl+l. The always-present
  # edge flag goes last: `$( )` strips trailing newlines, so an option that
  # happens to be unset must never be the final field.
  local probe current_type gid at_edge
  probe=$(_tmux display-message -t "$PANE_ID" -p "#{$OPT_WINDOW_TYPE}
#{$OPT_GROUP_ID}
#{pane_at_$edge_dir}")
  {
    IFS= read -r current_type || true
    IFS= read -r gid || true
    IFS= read -r at_edge || true
  } <<EOF
$probe
EOF

  # The CALLER's pane decides this, not the session's current pane: run from
  # the dock's shell, `display-message` with no target names the tab's active
  # pane, and the branch below would never match.
  case "$current_type" in
    "$WINDOW_TYPE_SIDEBAR_LEFT")  [ "$edge_dir" = "right" ] && request_focus panes; return ;;
    "$WINDOW_TYPE_SIDEBAR_RIGHT") [ "$edge_dir" = "left" ]  && request_focus panes; return ;;
  esac

  # A grouped pane steps to the neighbouring member first, without wrapping.
  if [ -n "$gid" ]; then
    local step=next rc=0
    [ "$edge_dir" = "left" ] && step=prev
    group_verb "$step" --no-wrap "$PANE_ID" || rc=$?
    case "$rc" in
      0) return ;;
      "$EXIT_TARGET") ;;
      *) exit "$rc" ;;
    esac
  fi

  # The edge comes from `pane_at_*`, not from comparing the active pane
  # around a `select-pane -L/-R`: at the edge tmux WRAPS to the opposite side
  # rather than doing nothing.
  if [ "$at_edge" = "1" ]; then
    if [ -n "$(shown_sidebar_window "$edge_dir")" ]; then
      request_focus "$edge_dir"
    fi
    return
  fi

  _tmux selectp "$tmux_dir" -t "$PANE_ID" 2>/dev/null || true
}

case "$DIR" in
  left)
    nav_horizontal "-L" "left"
    ;;
  right|next)
    nav_horizontal "-R" "right"
    ;;
  up)
    nav_vertical "-U"
    ;;
  down)
    nav_vertical "-D"
    ;;
  prev)
    nav_prev
    ;;
esac
