#!/bin/bash
set -euo pipefail
# shellcheck source=_lib
source "${0%/*}/_lib"

for arg in "$@"; do
  case "$arg" in
    --help|-h)
      echo "Usage: tmuxy session switch"
      echo ""
      echo "Interactive session switcher."
      exit 0
      ;;
  esac
done

current=$(_tmux display-message -p '#{session_name}')

# A read loop rather than `mapfile`: macOS ships bash 3.2, where mapfile does
# not exist and `set -e` then killed the switcher before it drew anything.
sessions=()
while IFS= read -r session_line; do
  sessions+=("$session_line")
done < <(_tmux list-sessions -F '#{session_name}' | grep -vFx "$STASH_SESSION")

if [ ${#sessions[@]} -eq 0 ]; then
  echo "No tmux sessions found."
  exit 1
fi

echo "Sessions:"
for i in "${!sessions[@]}"; do
  num=$((i + 1))
  name="${sessions[$i]}"
  if [ "$name" = "$current" ]; then
    echo "  $num) $name *"
  else
    echo "  $num) $name"
  fi
done
echo ""

read -rp 'Select session (number or "new"): ' choice

if [ "$choice" = "new" ]; then
  new_name=$(memorable_session_name)
  _run_safe "new-session -d -s $(shquote "$new_name")"
  selected="$new_name"
elif [[ "$choice" =~ ^[0-9]+$ ]]; then
  idx=$((choice - 1))
  if [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sessions[@]} ]; then
    echo "Invalid selection." >&2
    exit 1
  fi
  selected="${sessions[$idx]}"
else
  echo "Invalid input." >&2
  exit 1
fi

echo "$selected"

# switch-client acts on the calling client, so it must stay a direct call —
# run-shell would run without a client context and can't switch anything.
_tmux switch-client -t "$selected"
