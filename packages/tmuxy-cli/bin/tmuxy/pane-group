#!/bin/bash
# pane-group <verb> <args...>: a pane-group operation, run inside tmux
# run-shell. The rules are tmuxy_core::groups; the verbs and their arguments
# are the verbs binary's `group` (`tmuxy-server group --help`,
# packages/tmuxy-verbs/src/group_cli.rs).
set -euo pipefail
# shellcheck source=_lib
source "${0%/*}/_lib"

group_verb "$@"
