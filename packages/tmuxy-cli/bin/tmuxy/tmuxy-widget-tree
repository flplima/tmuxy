#!/bin/bash
# The tree has no content to stream: it is derived entirely from the tmux state
# the app already holds, so this only has to declare the widget and keep the
# pane alive so the pane (and therefore the column) stays open.
#
# The pane still matters: it is what gives the left sidebar a real pane id, so
# it can be focused, navigated into with ctrl+hjkl, and sized by the backend
# exactly like the right sidebar's shell.

set -euo pipefail

{ while true; do sleep 3600; done; } | "${0%/*}/tmuxy-widget" tree
