#!/bin/bash
# tmuxy pane send — type keys into a pane; into someone else's, only once the
# user has agreed.
#
# Usage: tmuxy pane send [-t <pane>] [--timeout SECONDS] <keys...>
#
# Into the caller's own pane (no -t, or -t naming it) the keys go at once. Into
# any other pane they do not: the target pane is put into the "ask state" — the
# UI blurs its content and asks "`<caller>` wants to send `<keys>`. Allow?" —
# and this blocks until the user answers, then sends the keys on yes and
# nothing on no. A caller therefore knows exactly when the command started and
# can capture the pane afterwards.
#
# `set -g @tmuxy-send-ask off` sends without asking; `@tmuxy-send-allow` is a
# comma list of caller process names (`claude,codex`) and target panes
# (`%3,%5`) that skip the question while it is on. A send that skips it still
# marks the target pane unread, so nothing is typed into a pane unseen.
#
# Protocol (both ends of it live here and in packages/tmuxy-ui):
#   @tmuxy-ask         on the target pane — base64 of {token, caller, keys}.
#                      Base64 because `list-panes` is comma-separated and the
#                      keys are free text.
#   @tmuxy-ask-answer  written by the client the user answered in, as
#                      `<token>:yes` / `<token>:no`. The token pins the answer
#                      to the question that was on screen.
#
# Exit status: 0 when the keys were sent, 1 when the user declined, 2 when the
# question timed out or the arguments were wrong, 3 when there is no such pane.

set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPTS_DIR/_lib"

# How often the answer option is polled. tmux emits no notification for a user
# option, so there is nothing to block on: `wait-for` would need the client to
# signal a channel it has no way to reach from a browser. A read-only
# `show-options` is cheap and this only runs while a question is on screen.
POLL_INTERVAL=0.15

usage() {
  cat <<'EOF'
Usage: tmuxy pane send [-t <pane>] [--timeout SECONDS] <keys...>

Type keys into a pane, as tmux send-keys does: each argument is literal text
or a key name (Enter, Escape, C-c, ...), with nothing between them.

Into your own pane (no -t) the keys go at once. Into another pane they go
only once the user allows it there: the pane shows who wants to send what,
and this blocks until they answer.

Options:
  -t <pane>            The pane to type into. Default: your own.
  --timeout SECONDS    Give up on an unanswered question after this long.
  --                   Everything after it is keys, even one starting with -.

Skipping the question:
  set -g @tmuxy-send-ask off            never ask
  set -g @tmuxy-send-allow claude,%3    don't ask these callers or panes

Exit status: 0 sent, 1 declined, 2 timed out or bad usage, 3 no such pane.

Examples:
  tmuxy pane send ls Enter
  tmuxy pane send -t %3 'npm test' Enter
EOF
}

# --- Arguments ---

TARGET=""
TIMEOUT=""
KEYS=()
# `tmuxy pane paste` hands its text here (`--paste`), to be pasted rather than
# typed once the same question is answered.
PASTE=false

while [ $# -gt 0 ]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    -t)
      TARGET="${2:?-t needs a pane}"
      shift 2
      ;;
    # `-t%3`, which tmux's own parser reads as `-t %3`: missing it left the
    # target empty and put the flag among the keys, where send-keys took it.
    -t*)
      TARGET="${1#-t}"
      shift
      ;;
    --timeout)
      TIMEOUT="${2:?--timeout needs a value}"
      shift 2
      ;;
    --paste)
      PASTE=true
      shift
      ;;
    --)
      shift
      KEYS+=("$@")
      break
      ;;
    # Any other flag would reach send-keys as one of its own options.
    -?*)
      echo "Error: unknown option '$1' (keys that start with '-' go after --)" >&2
      exit 2
      ;;
    *)
      KEYS+=("$1")
      shift
      ;;
  esac
done

if [ ${#KEYS[@]} -eq 0 ]; then
  echo "Error: keys required" >&2
  exit 2
fi
if [ -n "$TIMEOUT" ] && ! [ "$TIMEOUT" -gt 0 ] 2>/dev/null; then
  echo "Error: --timeout takes a positive whole number of seconds" >&2
  exit 2
fi

# A paste arrives between the bracketed-paste markers, and a program that
# parses its input as ECMA-48 ends the paste on any spelling of the end
# marker: `ESC [ 0201 ~` and the 8-bit CSI `U+009B 201 ~` as well as the
# literal one. Without ESC and C1 nothing in the text can start an escape
# sequence, so every control goes but tab, LF and CR: the rest of C0, DEL,
# and C1 (U+0080..U+009F, the bytes C2 80..C2 9F in UTF-8), the same rule as
# the client's paste. Byte-wise is safe for UTF-8: no other character's
# encoding holds a C0 byte or the lead byte C2. A run of C2 bytes before a C1
# byte goes with it, so a removal cannot join a C2 to the next C1 byte. The
# trailing `.` keeps `$(…)` from eating the text's trailing newlines.
without_controls() {
  local c1="" hi lo lead
  for hi in 20 21 22 23; do
    for lo in 0 1 2 3 4 5 6 7; do c1="$c1$(printf "\\$hi$lo")"; done
  done
  lead="$(printf '\302')"
  printf '%s.' "$1" \
    | LC_ALL=C tr -d '\001-\010\013\014\016-\037\177' \
    | LC_ALL=C sed "s/$lead$lead*[$c1]//g"
}

if $PASTE; then
  text="$(without_controls "${KEYS[*]}")"
  KEYS=("${text%.}")
  if [ -z "${KEYS[0]}" ]; then
    if [ "$JSON_OUT" = true ]; then
      json_ok "sent=false"
    else
      echo "nothing to paste: the text held only control characters" >&2
    fi
    exit 0
  fi
fi

# The pane the caller runs in, as it was before the CLI resolved a default
# for callers outside any pane (packages/tmuxy-cli/bin/tmuxy-cli exports it),
# and only if the caller really runs there (`verified_own_pane`).
OWN_PANE="$(verified_own_pane "${TMUXY_CALLER_PANE:-}")"

# No -t: the caller's own pane. A caller in no pane (cron, ssh, a script) has
# none, and its keys go to the pane the CLI resolved — the one the user is
# looking at — which is someone else's, so it is asked like any other.
if [ -z "$TARGET" ]; then
  TARGET="${OWN_PANE:-${TMUX_PANE:-}}"
  if [ -z "$TARGET" ]; then
    echo "Error: no pane to send to (pass -t)" >&2
    exit 2
  fi
fi

# A label (`tmuxy pane run --label`) or a title names the pane; a pane id is
# taken as it is. The target has to exist before a question is hung on it —
# a typo'd pane id would otherwise block forever on an option nothing can
# ever answer.
TARGET="$(_resolve_target "$TARGET")" || exit $?
if ! resolved="$(_tmux_read display-message -p -t "$TARGET" '#{pane_id}' 2>/dev/null)"; then
  _fail "$EXIT_TARGET" "no such pane: $TARGET"
fi
[ -n "$resolved" ] && TARGET="$resolved"

# Always an explicit target, and `--` before the keys: a key that looks like
# a flag (`-t %4`) is typed, never read as one.
send_keys() {
  if $PASTE; then
    local buf="tmuxy-cli-paste-$$"
    printf '%s' "${KEYS[*]}" | _tmux load-buffer -b "$buf" -
    # -p: bracketed when the program in the pane asked for it (?2004h), so a
    # multi-line paste is inserted rather than run a line at a time.
    _run_safe "pasteb -p -d -b $buf -t $(shquote "$TARGET")"
  else
    _run_safe "send-keys -t $(shquote "$TARGET") -- $(shquote "${KEYS[@]}")"
  fi
  if [ "$JSON_OUT" = true ]; then
    json_ok "paneId=$(json_string "$TARGET")" "sent=true"
  else
    echo "sent to $TARGET: ${KEYS[*]}"
  fi
}

if [ "$TARGET" = "$OWN_PANE" ]; then
  send_keys
  exit 0
fi

# Who is asking: the program in front in the caller's pane (an agent's own
# name, not the shell it runs commands through), else the parent process.
CALLER=""
if [ -n "$OWN_PANE" ]; then
  CALLER="$(_tmux display-message -p -t "$OWN_PANE" '#{pane_current_command}' 2>/dev/null || true)"
  # A process is named after the file it runs, and Claude Code runs as
  # `.../claude/versions/<version>`, so tmux reports a bare version (`2.1.314`).
  [[ "$CALLER" =~ ^[0-9]+(\.[0-9]+)+$ ]] && CALLER="claude"
fi
if [ -z "$CALLER" ]; then
  CALLER="$(basename "$(ps -o comm= -p "$PPID" 2>/dev/null || true)")"
  if [[ "$CALLER" =~ ^[0-9]+(\.[0-9]+)+$ ]] && [[ "$(ps -o args= -p "$PPID" 2>/dev/null || true)" == */claude/* ]]; then
    CALLER="claude"
  fi
fi
[ -n "$CALLER" ] || CALLER="a script"

# --- Skipping the question ---

pane_option() {
  _tmux show-options -pqv -t "$1" "$2" 2>/dev/null || true
}

allowed() {
  [ "$(_tmux show-options -gqv @tmuxy-send-ask 2>/dev/null || true)" = off ] && return 0
  local entry list
  list="$(_tmux show-options -gqv @tmuxy-send-allow 2>/dev/null || true)"
  IFS=',' read -r -a entries <<<"$list"
  for entry in "${entries[@]+"${entries[@]}"}"; do
    entry="${entry// /}"
    if [ -n "$entry" ] && { [ "$entry" = "$CALLER" ] || [ "$entry" = "$TARGET" ]; }; then
      return 0
    fi
  done
  return 1
}

if allowed; then
  send_keys
  # Unread, unless the pane already says something louder about itself; the
  # client clears it once the user looks at the pane.
  case "$(pane_option "$TARGET" @tmuxy-pane-state)" in
    "" | idle) _run_safe "set-option -p -t $(shquote "$TARGET") @tmuxy-pane-state unread" ;;
  esac
  exit 0
fi

# --- Payload ---

# A token unique to this question. Pane ids are never reused within a server
# and the pid is unique among live processes, so the pair cannot collide with
# another question on the same pane; the random tail keeps anything else on
# the socket from writing an answer it could work out in advance.
TOKEN="${TARGET#%}-$$-$RANDOM$RANDOM"

KEYS_JSON=""
for key in "${KEYS[@]}"; do
  KEYS_JSON="$KEYS_JSON${KEYS_JSON:+,}$(json_string "$key")"
done
# The keys as they will land: a paste's are already without its controls, so
# the question shows the very text that would be pasted.
PAYLOAD="{\"token\":\"$TOKEN\",\"caller\":$(json_string "$CALLER"),\"keys\":[$KEYS_JSON]}"
ENCODED="$(printf '%s' "$PAYLOAD" | base64 | tr -d '\n')"

# --- Ask ---

# While the question is up, the caller's own pane says it is waiting on the
# user; what it said before comes back afterwards.
OWN_STATE=""
[ -n "$OWN_PANE" ] && OWN_STATE="$(pane_option "$OWN_PANE" @tmuxy-pane-state)"

# Clear the question and the caller's waiting mark on ANY exit: an interrupted
# or killed sender must not leave a question on screen that nothing is
# listening to any more.
cleanup() {
  _run_safe "set-option -pu -t $(shquote "$TARGET") @tmuxy-ask" 2>/dev/null || true
  _run_safe "set-option -pu -t $(shquote "$TARGET") @tmuxy-ask-answer" 2>/dev/null || true
  if [ -n "$OWN_PANE" ]; then
    if [ -n "$OWN_STATE" ]; then
      _run_safe "set-option -p -t $(shquote "$OWN_PANE") @tmuxy-pane-state $(shquote "$OWN_STATE")" 2>/dev/null || true
    else
      _run_safe "set-option -pu -t $(shquote "$OWN_PANE") @tmuxy-pane-state" 2>/dev/null || true
    fi
  fi
}
trap cleanup EXIT INT TERM

# Answer first, question second: a stale answer left by a previous question
# would otherwise be read as this one's before the poll ever starts.
_run_safe "set-option -pu -t $(shquote "$TARGET") @tmuxy-ask-answer"
_run_safe "set-option -p -t $(shquote "$TARGET") @tmuxy-ask $(shquote "$ENCODED")"
if [ -n "$OWN_PANE" ]; then
  _run_safe "set-option -p -t $(shquote "$OWN_PANE") @tmuxy-pane-state needs-input"
fi

# Writing to stderr is not only for the user's benefit: it is pane output, and
# pane output is what makes the backend re-list the panes promptly. Without it
# a question asked from a silent pane waits for the idle heartbeat to appear.
echo "tmuxy: waiting for $TARGET to allow sending: ${KEYS[*]}" >&2

# --- Wait ---

deadline=""
[ -n "$TIMEOUT" ] && deadline=$(($(date +%s) + TIMEOUT))

answer=""
while :; do
  # A dead target ends the wait: nothing can answer a question on a pane that
  # no longer exists.
  if ! _tmux display-message -p -t "$TARGET" '#{pane_id}' >/dev/null 2>&1; then
    _fail "$EXIT_TARGET" "$TARGET is gone"
  fi

  case "$(pane_option "$TARGET" @tmuxy-ask-answer)" in
    "$TOKEN:yes")
      answer="yes"
      break
      ;;
    "$TOKEN:no")
      answer="no"
      break
      ;;
  esac

  if [ -n "$deadline" ] && [ "$(date +%s)" -ge "$deadline" ]; then
    _fail 2 "no answer from $TARGET after ${TIMEOUT}s; nothing sent"
  fi

  sleep "$POLL_INTERVAL" 2>/dev/null || sleep 1
done

# The question is answered; take it off the pane before the keys land, so the
# user never sees the command typed under a stale overlay.
cleanup
trap - EXIT INT TERM

if [ "$answer" = "no" ]; then
  _fail "$EXIT_FAILED" "declined in $TARGET; nothing sent"
fi

send_keys
