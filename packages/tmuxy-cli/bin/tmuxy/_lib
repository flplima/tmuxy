#!/bin/bash
# Shared helpers for tmuxy shell scripts.
#
# Window typing is sourced from the @tmuxy-window-type window option, with
# values: float | sidebar-left | sidebar-right. A window
# without @tmuxy-window-type is a tab.
#
# Pane groups are tmuxy-core's (`tmuxy_core::groups`): the pane-group script
# hands its arguments to the server binary's `group` verb (`group_verb`).

# The session hidden pane-group members are parked in. Kept out of every session
# picker/tree (matches tmuxy-core `STASH_SESSION`).
STASH_SESSION="__tmuxy_stash"

# Where tmuxy keeps its files, split by owner — resolved as tmuxy-core does
# (session::config_dir, paths::data_dir, paths::state_dir):
#   config — the user's (tmuxy.conf, custom.css, themes/): safe to symlink.
#   data   — what the app mirrors from its bundle: defaults, themes, bin/.
#   state  — this machine's: menu choices, launcher, servers.json, pid files.
tmuxy_config_dir() {
  case "${XDG_CONFIG_HOME:-}" in
    /*) echo "$XDG_CONFIG_HOME/tmuxy" ;;
    *) echo "$HOME/.config/tmuxy" ;;
  esac
}

tmuxy_data_dir() {
  if [ -n "${TMUXY_DATA_DIR:-}" ]; then
    echo "$TMUXY_DATA_DIR"
    return
  fi
  case "${XDG_DATA_HOME:-}" in
    /*) echo "$XDG_DATA_HOME/tmuxy" ;;
    *) echo "$HOME/.local/share/tmuxy" ;;
  esac
}

tmuxy_state_dir() {
  if [ -n "${TMUXY_STATE_DIR:-}" ]; then
    echo "$TMUXY_STATE_DIR"
  elif [ "$(uname -s)" = Darwin ]; then
    echo "$HOME/Library/Application Support/tmuxy"
  else
    case "${XDG_STATE_HOME:-}" in
      /*) echo "$XDG_STATE_HOME/tmuxy" ;;
      *) echo "$HOME/.local/state/tmuxy" ;;
    esac
  fi
}

# Resolved with parameter expansion, not `dirname`. These scripts run from
# `run-shell` on a keypress, and every external binary is another process
# spawn — tens of milliseconds on macOS, felt latency for something the shell
# does for free. The `cd`+`pwd` fork survives only for the relative-path case,
# which `run-shell` and `tmuxy-cli` never produce.
_dir="${0%/*}"
[ "$_dir" = "$0" ] && _dir="."
case "$_dir" in
  /*) SCRIPTS_DIR="$_dir" ;;
  *) SCRIPTS_DIR="$(cd "$_dir" && pwd)" ;;
esac

# Derive TMUX_SOCKET from TMUX env var if not already set.
# Inside run-shell, TMUX is e.g. "/tmp/tmux-1000/tmuxy-dev,110,9" — extract
# the socket name (basename of the path before the first comma). Outside any
# tmux, fall back to the dedicated `tmuxy` socket (never the user's default
# tmux server).
if [ -z "${TMUX_SOCKET:-}" ] && [ -n "${TMUX:-}" ]; then
  _path="${TMUX%%,*}"
  TMUX_SOCKET="${_path##*/}"
fi
TMUX_SOCKET="${TMUX_SOCKET:-tmuxy}"
export TMUX_SOCKET
# A TMUX_SOCKET containing a slash is a full socket path (-S); otherwise a
# socket name in tmux's default directory (-L).
case "$TMUX_SOCKET" in
  */*) TMUX_SOCKET_FLAG="-S" ;;
  *) TMUX_SOCKET_FLAG="-L" ;;
esac
export TMUX_SOCKET_FLAG

# The caller's pane, as tmux names one (`%N`). It is spliced into commands
# run-shell hands to a shell, so anything else in it is dropped rather than
# trusted.
if [ -n "${TMUX_PANE:-}" ] && ! [[ "$TMUX_PANE" =~ ^%[0-9]+$ ]]; then
  unset TMUX_PANE
fi

# The tmux binary: TMUX_BIN when set (as tmuxy-core's `tmux_path()` reads it,
# so a side-installed tmux is used end to end), else the one on PATH.
TMUX_BIN="${TMUX_BIN:-tmux}"

# The same binary as one word of a line run-shell hands a shell: bare when it
# plainly is one, `shquote`d otherwise.
tmux_word() {
  if [[ "$TMUX_BIN" =~ ^[A-Za-z0-9._/@+-]+$ ]]; then
    printf '%s' "$TMUX_BIN"
  else
    shquote "$TMUX_BIN"
  fi
}

# Wrap tmux to target the resolved socket. Using an explicit socket flag
# bypasses the TMUX env var, which returns corrupted list-windows results
# inside run-shell (tmux 3.5a bug).
_tmux() {
  command "$TMUX_BIN" "$TMUX_SOCKET_FLAG" "$TMUX_SOCKET" "$@"
}

# Run ONE shell command inside the tmux server through run-shell, and hand
# back what it printed and its exit status as if it had run here.
#
# They come back through files, not through run-shell: tmux 3.4 shows
# run-shell output — and a "returned 1" for a command that failed — in
# view-mode on the target pane instead of handing it to the calling client,
# and a pane in view-mode swallows every key typed into it. One failing
# `tmuxy run` left the shell unreachable.
# Formats in the command (`#{pane_id}`, `#{pane_width}`, `#{session_id}`)
# expand against run-shell's own target. Without one, tmux resolves it from
# the CLI's client — unattached, so the session's current window and active
# pane, not the caller's — which is how `pane group add` from a background
# tab grouped a pane in the tab in front. The caller's pane is the target
# whenever one is known (TMUX_PANE, resolved by packages/tmuxy-cli/bin/tmuxy-cli).
_run_shell() {
  local dir status=0
  dir=$(mktemp -d)
  _tmux run-shell ${TMUX_PANE:+-t "$TMUX_PANE"} "{ $1 ; } >$(shquote "$dir/out") 2>$(shquote "$dir/err"); echo \$? >$(shquote "$dir/status")" 2>"$dir/client-err" || status=$?
  # No status file means run-shell never ran the command; its own status
  # stands — unless there was no server to run it, which is exit 4.
  if [ -f "$dir/status" ]; then
    status=$(cat "$dir/status")
  elif [ "$status" -ne 0 ] && _no_server_in "$(cat "$dir/client-err")"; then
    rm -rf "$dir"
    _fail "$EXIT_NO_SERVER" "no tmux server on socket '$TMUX_SOCKET'"
  fi
  if [ -s "$dir/client-err" ]; then cat "$dir/client-err" >&2; fi
  if [ -f "$dir/out" ]; then cat "$dir/out"; fi
  if [ -f "$dir/err" ]; then cat "$dir/err" >&2; fi
  rm -rf "$dir"
  return "$status"
}

# Route a mutating tmux command through run-shell. These scripts run inside a
# live pane with a control-mode client attached (the UI spawns them in floats),
# so direct external mutations (new-session, set-environment, …) can crash the
# tmux server on 3.5a — run-shell executes them in the server's own context.
# Takes ONE pre-built tmux command string; interpolate user-supplied values
# with `shquote` so spaces, quotes and `#` survive the trip.
#
# The inner tmux is a client of its own, and run-shell hands it no pane: a
# target-less `send-keys` or `breakp` in there resolves to whichever session
# tmux touched last, not the caller's. So the caller's pane rides along as the
# inner client's TMUX_PANE, which tmux reads for an unattached client the way
# it reads it for a shell in a pane.
_run_safe() {
  # The socket is a name or a path from the environment: bare when it is
  # plainly one word, quoted for the shell otherwise.
  local socket="$TMUX_SOCKET"
  [[ "$socket" =~ ^[A-Za-z0-9._/@+-]+$ ]] || socket="$(shquote "$socket")"
  _run_shell "${TMUX_PANE:+TMUX_PANE=$TMUX_PANE }$(tmux_word) $TMUX_SOCKET_FLAG $socket $*"
}

# Quote arguments for interpolation into a `_run_safe` command string. Each
# argument becomes one single-quoted token (embedded single quotes escaped),
# and `#` is doubled because run-shell format-expands its command string before
# the shell sees it (see docs/TMUX.md).
shquote() {
  # The single-quote escape is built from variables rather than written as
  # literal backslashes in the replacement: bash 3.2 (the only bash macOS
  # ships) and bash 4+ disagree about how many backslashes survive a literal
  # replacement string, and 3.2 turned `it's` into a tmux command that no
  # longer parses. A replacement that arrives by expansion is taken literally
  # by both.
  local out='' arg sq="'" sq_esc="'\\''"
  for arg in "$@"; do
    arg="'${arg//$sq/$sq_esc}'"
    out="$out ${arg//#/##}"
  done
  printf '%s' "${out# }"
}

# The exit codes, `_fail`/`_die_usage`, JSON answers and `_resolve_target`
# live in `_contract`, sourced here so every script that has `_lib` has them.
# Beside THIS file: SCRIPTS_DIR is `$0`'s directory, which is tmuxy-cli's own
# when it is the one sourcing.
source "${BASH_SOURCE[0]%/*}/_contract"

# --- The server binary -----------------------------------------------------
#
# Sets SERVER_CMD to the command that runs a server verb (`session`, `group`,
# `tree`, …) of the right build, or fails with a message:
#   1. TMUXY_SERVER_BIN (+ TMUXY_SERVER_SUBCOMMAND): what the running tmuxy
#      published to its tmux server's global environment, which run-shell
#      hands every script — the build actually serving this socket. Without
#      it the bundled copies under the data dir's bin/, which sit nowhere near
#      a build tree, could only guess.
#   2. tmuxy-server on PATH.
#   3. A cargo build beside these scripts (a checkout's bin/tmuxy).
#   4. The desktop app the `tmuxy` shorthand launches, whose server verbs are
#      `tmuxy server <verb>`.
find_server_cmd() {
  # The repo root in a dev tree, where these scripts are packages/tmuxy-cli/bin/tmuxy.
  local root="${SCRIPTS_DIR%/*}/../../.." launcher
  launcher="$(tmuxy_state_dir)/launcher"
  if [ -n "${TMUXY_SERVER_BIN:-}" ] && [ -x "$TMUXY_SERVER_BIN" ]; then
    SERVER_CMD=("$TMUXY_SERVER_BIN" ${TMUXY_SERVER_SUBCOMMAND:+"$TMUXY_SERVER_SUBCOMMAND"})
  elif command -v tmuxy-server &>/dev/null; then
    SERVER_CMD=(tmuxy-server)
  elif [ -x "$root/target/debug/tmuxy-server" ]; then
    SERVER_CMD=("$root/target/debug/tmuxy-server")
  elif [ -x "$root/target/release/tmuxy-server" ]; then
    SERVER_CMD=("$root/target/release/tmuxy-server")
  elif [ -f "$launcher" ] && [ -x "$(cat "$launcher")" ]; then
    SERVER_CMD=("$(cat "$launcher")" server)
  elif [ -x "/Applications/tmuxy.app/Contents/MacOS/tmuxy" ]; then
    SERVER_CMD=("/Applications/tmuxy.app/Contents/MacOS/tmuxy" server)
  else
    echo "Error: tmuxy-server binary not found. Run 'cargo build -p tmuxy-server' first." >&2
    return 1
  fi
}

# Run a pane-group operation: the pane-group script is its name, and keeps
# its arguments, output and exit status. TMUXY_SCRIPTS_DIR names the
# directory whose `pane-group close` a member's pane-died hook runs.
# Args: $1=verb, then the script's own arguments
group_verb() {
  find_group_cmd || exit 1
  TMUXY_SCRIPTS_DIR="$SCRIPTS_DIR" exec "${GROUP_CMD[@]}" "$@"
}

# Set GROUP_CMD to the command that runs a pane-group verb: the standalone
# tmuxy-group binary where it is installed (the v86 guest ships the operations
# that way, having no server), else the server's `group` subcommand.
find_group_cmd() {
  if command -v tmuxy-group &>/dev/null; then
    GROUP_CMD=(tmuxy-group)
    return
  fi
  find_server_cmd || return 1
  GROUP_CMD=("${SERVER_CMD[@]}" group)
}

# --- Cross-process mutex ---------------------------------------------------
#
# `mkdir` is the lock primitive because it is atomic on every POSIX filesystem
# and is always present (`flock` is absent on macOS).
#
# BusyBox's sleep (the v86 guest) may not accept a fraction, so the nap falls
# back to a whole second rather than failing under `set -e`.
_lock_nap() { sleep 0.05 2>/dev/null || sleep 1; }

# Take the lock for a directory, blocking until it is free.
# Args: $1=directory to lock within
_lock_acquire() {
  local lock="$1/.lock" owner tries=0
  # A `.lock` left as a FILE is from the flock era, when the lock was an fd
  # onto a file of that name; it would block mkdir forever.
  [ -f "$lock" ] && rm -f "$lock"
  while :; do
    if mkdir "$lock" 2>/dev/null; then
      # Between this mkdir and the pid landing, a waiter that watched the
      # PREVIOUS owner die can move the fresh directory away as that owner's
      # (the steal below). The write then has nowhere to go — and under
      # `set -e` that was an emitter exiting 1 under contention, on a CI Mac
      # once in some hundred pushes. A lock that was taken from under us is
      # not ours: take it again.
      if echo $$ > "$lock/pid" 2>/dev/null; then
        return 0
      fi
      continue
    fi
    owner="$(cat "$lock/pid" 2>/dev/null || true)"
    tries=$((tries + 1))
    _lock_nap
    # Steal a lock whose owner died between taking and releasing it: nothing
    # drops it on exit the way the kernel drops an flock, so one crashed
    # emitter would wedge the channel for good. The ~10s arm covers an owner
    # that is alive but stuck.
    #
    # Two guards against stealing a lock somebody legitimately holds: the pid
    # must be the same dead one seen before the nap (a lock that changed hands
    # meanwhile has a live owner), and the steal is a `mv` — of two processes
    # racing to reclaim the same lock only one can move it, so the other
    # cannot delete the winner's fresh lock. A lock re-taken in the instant
    # between the check and the move can still be lost; the window is a
    # syscall wide and only opens after a crash.
    if [ "$owner" = "$(cat "$lock/pid" 2>/dev/null || true)" ] &&
      { { [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; } || [ "$tries" -gt 200 ]; }; then
      if mv "$lock" "$lock.stale.$$" 2>/dev/null; then
        # What was moved must be the dead owner's lock. A live one re-taken
        # in that instant goes back where it was; if its place has been taken
        # meanwhile, its owner is about to find its pid gone and take the lock
        # again (above), so dropping it is safe.
        if [ "$(cat "$lock.stale.$$/pid" 2>/dev/null || true)" = "$owner" ]; then
          rm -rf "$lock.stale.$$"
        elif ! mv "$lock.stale.$$" "$lock" 2>/dev/null; then
          rm -rf "$lock.stale.$$"
        fi
      fi
      tries=0
    fi
  done
}

# Release the lock for a directory. Safe to call when not held.
# Args: $1=directory to unlock within
_lock_release() {
  rm -rf "$1/.lock" 2>/dev/null || true
}

# Get the window type set on a window via @tmuxy-window-type.
# Args: $1=window_id (e.g., @5)
# Output: float|sidebar-left|sidebar-right  (empty for a tab)
window_type() {
  _tmux show-options -wqv -t "$1" @tmuxy-window-type 2>/dev/null
}

# The window id of a sidebar column, if that column currently exists.
# Args: $1=left|right
# Output: window id (e.g. @7), or empty.
sidebar_window() {
  _tmux list-windows -F '#{window_id} #{@tmuxy-window-type}' 2>/dev/null \
    | awk -v t="sidebar-$1" '$2 == t { print $1; exit }'
}

# The same, only while the column is on screen: a closed column keeps its
# window, hidden (`@tmuxy-sidebar-hidden`), and is nowhere to move to.
shown_sidebar_window() {
  _tmux list-windows -F '#{window_id} #{@tmuxy-window-type} #{?@tmuxy-sidebar-hidden,hidden,shown}' 2>/dev/null \
    | awk -v t="sidebar-$1" '$2 == t && $3 == "shown" { print $1; exit }'
}

# Ask the connected clients to move keyboard focus somewhere no tmux command
# can: into a sidebar column, or back out to the panes. Focusing a sidebar is a
# client-side concept — its pane lives in another window, so `select-pane` would
# switch the visible tab — which leaves the shell no way to do it directly.
#
# The request is a session option; it rides the client's existing list-windows
# poll (it is read as a per-window column, but set at session scope so every row
# carries it) and the client that acts on it unsets it. See
# `tmux_options::FOCUS_REQUEST` in tmuxy-core.
# Args: $1=left|right|panes
request_focus() {
  _tmux set-option -t "$(_tmux display-message -p '#{session_name}')" \
    @tmuxy-focus-request "$1" 2>/dev/null || true
  # tmux emits no control-mode notification for a user option, so left alone
  # the request would sit until the backend's next window event or idle
  # heartbeat (15 s). Poke a window event out of tmux instead: renaming a
  # sidebar's chrome window to the name it already has emits %window-renamed
  # and nothing else — chrome windows are not tabs, so no label changes and
  # automatic-rename was never on for them. The backend re-lists windows on
  # the event and the client sees the request within a round trip.
  local target_side="$1" poke_win
  [ "$target_side" = "panes" ] && target_side="left"
  poke_win=$(sidebar_window "$target_side")
  [ -n "$poke_win" ] || poke_win=$(sidebar_window right)
  if [ -n "$poke_win" ]; then
    _run_safe "rename-window -t $poke_win __sidebar-$(window_type "$poke_win" | sed 's/^sidebar-//')"
  fi
}

# SIGKILL any of the given pids that outlived their window and were adopted by
# pid 1. Still having a real parent means it is exiting in good order; pid 1
# after the window is gone means nothing will signal it again, and a process
# blocked in an uninterruptible open() runs no handler anyway.
# Args: $1 = whitespace-separated pids (may be empty)
reap_pids() {
  local pid ppid
  for pid in ${1:-}; do
    case "$pid" in
      '' | *[!0-9]*) continue ;;
    esac
    kill -0 "$pid" 2>/dev/null || continue
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ "$ppid" = "1" ] || continue
    kill -9 "$pid" 2>/dev/null || true
  done
}

# Get a pane's window ID
pane_window() {
  _tmux display-message -t "$1" -p '#{window_id}'
}

# Force a list-panes refresh (so server pushes new state to clients)
refresh_panes() {
  _tmux list-panes -s -F '#{pane_id},#{pane_index},#{pane_left},#{pane_top},#{pane_width},#{pane_height},#{cursor_x},#{cursor_y},#{pane_active},#{pane_current_command},#{pane_title},#{pane_in_mode},#{copy_cursor_x},#{copy_cursor_y},#{window_id}' > /dev/null 2>&1
}

# The name for a session the user did not name: an adjective and a noun from
# session-names.json (the UI draws from the same lists, in
# tmuxy-ui/src/domain/sessionNames.ts), like `drifting-cedar`, that no session
# on the server and no snapshot has. The pairs are tried from a random one
# onward, so a number is added only once every pair is taken. awk reads the
# lists, one word per line, since jq is not a dependency of the CLI.
memorable_session_name() {
  local file="$SCRIPTS_DIR/session-names.json" taken word
  local adjectives=() nouns=()
  taken=$(_tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
  # A snapshot's name is taken too: a session made under it would be saved
  # over it.
  if find_server_cmd 2>/dev/null; then
    taken="$taken"$'\n'"$("${SERVER_CMD[@]}" session snapshots 2>/dev/null | cut -f1 || true)"
  fi
  while IFS= read -r word; do adjectives+=("$word"); done < <(_session_words adjectives "$file")
  while IFS= read -r word; do nouns+=("$word"); done < <(_session_words nouns "$file")
  local per=${#nouns[@]}
  local count=$((${#adjectives[@]} * per))
  local start=$(((RANDOM * 32768 + RANDOM) % count)) i pick name
  for ((i = 0; i < count; i++)); do
    pick=$(((start + i) % count))
    name="${adjectives[pick / per]}-${nouns[pick % per]}"
    if ! _name_taken "$name" "$taken"; then
      echo "$name"
      return
    fi
  done
  local base="${adjectives[start / per]}-${nouns[start % per]}" n=2
  while _name_taken "$base-$n" "$taken"; do n=$((n + 1)); done
  echo "$base-$n"
}

# Whether a name is one of the newline-separated names: a pattern match, not a
# grep per candidate, since there can be a thousand candidates.
_name_taken() {
  case $'\n'"$2"$'\n' in
    *$'\n'"$1"$'\n'*) return 0 ;;
  esac
  return 1
}

# The words of one list in session-names.json, one per line.
_session_words() {
  awk -v list="\"$1\"" '
    index($0, list) { on = 1; next }
    on && /\]/ { exit }
    on { gsub(/[",[:space:]]/, ""); if ($0 != "") print }
  ' "$2"
}
