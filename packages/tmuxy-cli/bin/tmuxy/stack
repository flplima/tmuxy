#!/bin/bash
# Collapsible panes (zellij-style stacks). The flag is the @tmuxy-collapsible
# window option (docs/TMUX-TAGS.md). tmuxy-core reshapes the window around it
# (`layout.rs`, `collapsible_layout_commands`): only the first-level row holding
# the active pane stays expanded, every other first-level row collapses to its
# headers, and panes nested inside a row keep their proportions.
set -euo pipefail
# shellcheck source=_lib
source "${0%/*}/_lib"

CMD="${1:-}"

case "$CMD" in
  new)
    PANE_ID="${2:?pane id required}"
    WID=$(pane_window "$PANE_ID")
    cwd=$(_pane_read "$PANE_ID" '#{pane_current_path}')
    _tmux set-option -w -t "$WID" "$OPT_COLLAPSIBLE" 1
    # -f: the new pane spans the full window width, i.e. it is a first-level
    # row of the window rather than a split of whatever pane was active.
    _tmux split-window -v -f -t "$PANE_ID" -c "$cwd"
    ;;
  off)
    WID="${2:?window id required}"
    _tmux set-option -u -w -t "$WID" "$OPT_COLLAPSIBLE"
    ;;
  toggle)
    WID="${2:?window id required}"
    if [ "$(_tmux show-options -wqv -t "$WID" "$OPT_COLLAPSIBLE")" = "1" ]; then
      _tmux set-option -u -w -t "$WID" "$OPT_COLLAPSIBLE"
    else
      _tmux set-option -w -t "$WID" "$OPT_COLLAPSIBLE" 1
    fi
    ;;
  *)
    echo "usage: stack new <pane_id> | stack off <window_id> | stack toggle <window_id>" >&2
    exit 1
    ;;
esac
