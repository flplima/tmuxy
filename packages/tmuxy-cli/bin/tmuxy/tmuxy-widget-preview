#!/bin/bash
# Show a local HTML or markdown file in a tmuxy `preview` widget pane
#
# Usage: tmuxy widget preview [--net] [--no-theme] [file]
#
#   file        an .html/.htm or .md/.markdown file; without one, the first of
#               index.html, README.md or readme.md in the current directory
#   --net       let a page load from the network (off: the page is offline,
#               and only what sits beside it is shown)
#   --no-theme  draw the page in its own colours, not the theme's
#
# The UI renders the file — markdown in the app (mermaid and pele diagrams included), a page in
# a sandboxed frame — and reads it through tmuxy rather than off a URL. What it
# may read is decided here, out of band: the file's path and the --net choice
# are pane options, written through `run-shell` before the widget marker and
# cleared on the way out, so nothing the pane prints and nothing a client asks
# can point the preview anywhere else (see docs/SECURITY-CONTENT.md).
#
# The file is watched — inotify where there is one, a poll every second
# otherwise — and each change rewrites one line under the marker, which is
# what tells the UI to read it again. A poll reads the file only when its
# time says it may have changed, so a preview nobody edits costs no process.
#
# A JSON line typed into the pane — a markdown form control's change, a
# page's `tmuxy.emit` — is printed under that line, and appended to a log of
# the pane's own, owner-only, which `tmuxy pane listen` reads. The app types
# one only while this pane is tagged `preview` (tmux checks, as it types).

set -euo pipefail

# shellcheck source=_lib
source "${0%/*}/_lib"

usage() {
  sed -n '4,10p' "$0" | sed 's/^# \{0,1\}//'
}

NET=""
THEME=1
while [ $# -gt 0 ]; do
  case "$1" in
    --net) NET=1; shift ;;
    --no-theme) THEME=""; shift ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    -*) _die_usage "Unknown option: $1" usage ;;
    *) break ;;
  esac
done

FILE="${1:-}"
if [ -z "$FILE" ]; then
  for candidate in index.html README.md readme.md; do
    if [ -f "$candidate" ] && [ ! -L "$candidate" ]; then FILE="$candidate"; break; fi
  done
  if [ -z "$FILE" ]; then
    _fail "$EXIT_FAILED" "no file given, and no index.html or README.md here"
  fi
fi

if [ -L "$FILE" ]; then
  _fail "$EXIT_FAILED" "a symlink cannot be previewed: $FILE"
fi
if [ ! -f "$FILE" ]; then
  _fail "$EXIT_FAILED" "not a file: $FILE"
fi
case "$(printf '%s' "$FILE" | tr '[:upper:]' '[:lower:]')" in
  *.html|*.htm|*.md|*.markdown) ;;
  *) _fail "$EXIT_FAILED" "a preview shows .html and .md files: $FILE" ;;
esac
take_own_pane "a preview"

DIR="$(cd "$(dirname "$FILE")" && pwd -P)"
ABS="$DIR/$(basename "$FILE")"
if [ -L "$ABS" ]; then
  _fail "$EXIT_FAILED" "a symlink cannot be previewed: $FILE"
fi
NAME="$(basename "$ABS")"
case "$ABS" in
  *$'\n'*) _fail "$EXIT_FAILED" "a file name with a newline cannot be previewed" ;;
esac

PANE="$(shquote "$TMUX_PANE")"

# The pane's message log, started empty before the widget tags the pane, so
# a listener that waits for the tag never reads an earlier widget's lines.
# Past LOG_CAP it starts over as a new file, which a listener follows.
SOCKET_PATH="$(_pane_read "$TMUX_PANE" '#{socket_path}' 2>/dev/null || true)"
LOG="$(preview_message_log "${SOCKET_PATH:-${TMUX%%,*}}" "$TMUX_PANE")"
LOG_CAP=$((8 * 1024 * 1024))
(umask 077 && mkdir -p "${LOG%/*}") && chmod 700 "${LOG%/*}" 2>/dev/null || true
rm -f -- "$LOG"
(umask 077 && : >"$LOG") 2>/dev/null || true
# Written each time the file is found changed: see `may_have_changed`.
STAMP="${LOG%.log}.stamp"

# The path goes with this script. Ctrl+C ends the widget first — its own exit
# takes `@tmuxy-pane-widget` with it, which alone stops the preview being
# read — and this script ends once the pane's shell does.
cleanup() {
  stty echo icanon </dev/tty 2>/dev/null || true
  rm -f -- "$LOG" "$STAMP"
  _run_safe "set-option -p -u -t $PANE $OPT_PANE_PREVIEW" || true
  _run_safe "set-option -p -u -t $PANE $OPT_PANE_PREVIEW_NET" || true
}
trap cleanup EXIT

# Not echoed, and read as it arrives rather than a line at a time: a
# terminal holds at most one line of 4096 bytes (1024 on macOS) while it
# waits for the Enter, and a line may be 16 KiB.
stty -echo -icanon min 1 time 0 2>/dev/null || true

_run_safe "set-option -p -t $PANE $OPT_PANE_PREVIEW $(shquote "$ABS")"
if [ -n "$NET" ]; then
  _run_safe "set-option -p -t $PANE $OPT_PANE_PREVIEW_NET 1"
else
  _run_safe "set-option -p -u -t $PANE $OPT_PANE_PREVIEW_NET"
fi

# What the file is now: its checksum and size, or `missing` in the moment an
# editor's save has replaced it.
fingerprint() {
  local sum
  sum="$(cksum <"$ABS" 2>/dev/null)" || sum="missing"
  printf '%s' "${sum// /-}"
}

# Whether the file has to be read again, asked of the shell alone: reading
# it is two processes, every second, for as long as the preview is open.
#
# The file is as it was last read while it and its folder are older than the
# stamp, an empty file of this script's written just before a read that found
# a change. A write after that read is newer than the stamp, or as old; a
# file renamed into place keeps its own time, and the folder takes the
# rename's.
#
# A filesystem that keeps times to the second or two dates a write earlier
# than it happened, before a stamp it came after: the stamp is believed only
# once the file has been read STILL seconds after it and found the same. And
# a time is a hint (a folder on another machine keeps its own clock, a tool
# may put a file's time back), so a still file is read every REREAD seconds
# all the same.
STILL=3
REREAD=30
stamped=0
still=""
reread=0
may_have_changed() {
  if ! [ "$STAMP" -nt "$ABS" ] || ! [ "$STAMP" -nt "$DIR" ]; then
    { : >"$STAMP"; } 2>/dev/null || true
    stamped=$SECONDS
    still=""
  elif [ -n "$still" ] && [ "$SECONDS" -lt "$reread" ]; then
    return 1
  elif [ $((SECONDS - stamped)) -ge "$STILL" ]; then
    still=1
  fi
  reread=$((SECONDS + REREAD))
}

# Block until the file may have changed: an inotify event in its folder (an
# editor that saves by renaming replaces the file, so the folder is what is
# watched), or a second either way.
settle() {
  if command -v inotifywait >/dev/null 2>&1; then
    inotifywait -qq -t 1 -e close_write,moved_to,create,modify "$DIR" 2>/dev/null || true
  else
    sleep 1
  fi
}

# A received line, kept for `tmuxy pane listen`.
logged=0
record() {
  printf '%s\n' "$1" >>"$LOG" 2>/dev/null || return 0
  logged=$((logged + ${#1} + 1))
  if [ "$logged" -gt "$LOG_CAP" ]; then
    (umask 077 && : >"$LOG.new" && mv -f -- "$LOG.new" "$LOG") 2>/dev/null || true
    logged=0
  fi
}

watch_file() {
  local last="" now line max cols partial=""
  local -a inputs=()
  # The log goes as soon as the widget does; the rest of the clean-up waits
  # for this script, which outlives the shell the widget hands the pane to.
  trap 'rm -f -- "$LOG" "$STAMP"' EXIT
  redraw() {
    # Each line cut to one row, so a long one cannot scroll the marker off
    # the screen; the log has it whole.
    cols="$(stty size 2>/dev/null)"
    cols="${cols#* }"
    [[ "$cols" =~ ^[1-9][0-9]*$ ]] || cols=200
    printf '\033[H\033[2J%s\n' "${WIDGET_MARKER}preview"
    if [ -z "$THEME" ]; then echo "$PREVIEW_NO_THEME"; fi
    echo "${PREVIEW_FILE}${NAME}"
    echo "${PREVIEW_REV}${last}"
    for line in ${inputs[@]+"${inputs[@]}"}; do
      printf '%s\n' "${line:0:cols}"
    done
  }
  while :; do
    if may_have_changed; then
      now="$(fingerprint)"
      if [ "$now" != "$last" ]; then
        last="$now"
        redraw
      fi
    fi
    if [ -t 0 ]; then
      line=""
      if IFS= read -r -t 1 line; then
        line="$partial$line"
        partial=""
        case "$line" in
          \{*\})
            record "$line"
            inputs+=("$line")
            max=$(( (${LINES:-24} > 12 ? ${LINES:-24} : 12) - 5 ))
            if [ "${#inputs[@]}" -gt "$max" ]; then
              inputs=("${inputs[@]:1}")
            fi
            redraw
            ;;
        esac
      else
        # A line still arriving when the second ran out: the rest follows.
        partial="$partial$line"
      fi
    else
      settle
    fi
  done
}

watch_file | "${SCRIPTS_DIR}/tmuxy-widget" preview "$NAME"
