#!/bin/bash
# The agent waits for every hook, on every tool call, so this one never makes
# it wait for tmux: it records the state it wants and returns, and a
# background job applies the latest wanted state under a lock. Hooks that
# race each other still end on the last one's state, because whichever job
# runs last applies what was wanted last. Outside a tmuxy pane it does
# nothing, and it always succeeds — a status line must never fail an agent.

agent="${1:-}"
event="${2:-}"
# Antigravity reads every hook's stdout as JSON.
[ "$agent" = agy ] && echo '{}'

socket_path="${TMUX%%,*}"
case "${socket_path##*/}" in
  tmuxy*) ;;
  *) exit 0 ;;
esac
[ -n "${TMUX_PANE:-}" ] || exit 0

source "${0%/*}/_lib"
find_server_cmd 2>/dev/null || exit 0
state="$("${SERVER_CMD[@]}" agent state "$agent" "$event" 2>/dev/null)" || exit 0
[ -n "$state" ] || exit 0

# Per pane, and per tmux server ($TMUX carries its pid): pane ids start again
# with the server. The base sits in a shared temp dir, so it has to be ours,
# owner-only and not a symlink someone else planted.
base="${TMPDIR:-/tmp}/tmuxy-agent-$UID"
(umask 077 && mkdir -p "$base") 2>/dev/null || exit 0
[ -O "$base" ] && [ ! -L "$base" ] || exit 0
chmod 700 "$base" 2>/dev/null || exit 0
dir="$base/${TMUX//[^A-Za-z0-9]/_}_${TMUX_PANE#%}"
[ -d "$dir" ] || (umask 077 && mkdir -p "$dir") 2>/dev/null || exit 0
echo "$state" >"$dir/wanted" 2>/dev/null || exit 0

# What the pane says is read from tmux, not remembered: other writers set the
# state too — the server reading a dialog off the screen
# (tmuxy-core/src/host/socket_watch/agent_screen.rs), a send's question, `tmuxy pane state` —
# and a remembered "already applied" skipped the hook that should have put it
# back (a pane left `needs-input` after the user had answered).
apply() {
  local wanted="" current=""
  _lock_acquire "$dir"
  read -r wanted <"$dir/wanted"
  current="$(_tmux show-options -pqv -t "$TMUX_PANE" "$OPT_PANE_STATE" 2>/dev/null || true)"
  if [ "$wanted" = clear ]; then
    [ -z "$current" ] || _run_safe "set-option -p -u -t $(shquote "$TMUX_PANE") $OPT_PANE_STATE"
  elif [ -n "$wanted" ] && [ "$wanted" != "$current" ]; then
    _run_safe "set-option -p -t $(shquote "$TMUX_PANE") $OPT_PANE_STATE $(shquote "$wanted")"
  fi
  _lock_release "$dir"
}
# Detached from the agent's pipes, or it would wait for the job anyway.
apply </dev/null >/dev/null 2>&1 &
exit 0
