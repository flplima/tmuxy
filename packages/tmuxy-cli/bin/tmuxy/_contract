#!/bin/bash

# --- Exit codes, failures and JSON ------------------------------------------
#
# The CLI's contract with scripts and agents (`tmuxy --help`, "Exit codes"):
#   0 ok · 1 failed · 2 bad command line · 3 target not found or ambiguous ·
#   4 no tmux server on the socket · 130 interrupted. A command that waits for
#   a program (`pane run --wait`, `pane wait`) exits with the program's status.
# The codes and a failure's shape are tmuxy-core's (`cli_contract`), from
# `_options`.

# `--json` anywhere on the command line (tmuxy-cli takes it off the arguments
# and sets this): every answer, including a failure, is one JSON object on
# stdout.
JSON_OUT="${JSON_OUT:-false}"

# The CLI's one JSON string encoder, as an awk function: `jstr(s)` is `s`
# with backslash, quote and every control character escaped as serde_json
# escapes them (`\t`, `\u001b`), so a string answers the same here as from a
# verb (tmuxy-core `cli_contract` holds the two together). A row printer
# splices it into its own awk program (`awk "$JSON_AWK"'…'`); `json_string`
# runs it on one value. awk only, since neither jq nor python is a dependency
# of the CLI. No variable is ever followed by `(`: BusyBox 1.31's awk (the
# v86 guest's) reads `out (…)` as a call to a function `out`, and every JSON
# list failed there with "Call to undefined function".
JSON_AWK='function jstr(s,  out, i, n, ch) { if (!JSTR_READY) { for (i = 1; i < 32; i++) JSTR_ESC[sprintf("%c", i)] = sprintf("\\u%04x", i); JSTR_ESC["\t"] = "\\t"; JSTR_ESC["\r"] = "\\r"; JSTR_ESC["\b"] = "\\b"; JSTR_ESC["\f"] = "\\f"; JSTR_ESC["\\"] = "\\\\"; JSTR_ESC["\""] = "\\\""; JSTR_READY = 1 } out = ""; n = length(s); for (i = 1; i <= n; i++) { ch = substr(s, i, 1); if (ch in JSTR_ESC) ch = JSTR_ESC[ch]; out = out ch } return out } '

# One string as a JSON string literal (quotes included), its lines joined by
# `\n`.
json_string() {
  printf '"'
  printf '%s' "$1" | LC_ALL=C awk "$JSON_AWK"'{ if (NR > 1) printf "\\n"; printf "%s", jstr($0) }'
  printf '"'
}

# A success in `--json` mode: `{"ok":true}` plus the fields given as
# `name=value` pairs, where a value is spliced in as written — pass a JSON
# literal (`json_string` output, a number, true/false).
json_ok() {
  local out='{"ok":true' pair
  for pair in "$@"; do
    out="$out,\"${pair%%=*}\":${pair#*=}"
  done
  printf '%s}\n' "$out"
}

# ` --json` when the answer is JSON, for a verb's command line.
_json_flag() {
  [ "$JSON_OUT" != true ] || printf ' --json'
}

_done() {
  [ "$JSON_OUT" = true ] || return 0
  json_ok "$@"
}

# Where a JSON failure goes: the real stdout. tmuxy-cli keeps it open as fd 3,
# since a failure raised inside a `$(…)` — resolving a target, say — would
# otherwise be captured by the substitution and never seen.
_json_fd() {
  if { true >&3; } 2>/dev/null; then echo 3; else echo 1; fi
}

_fail() {
  local code="$1" message="$2"
  if [ "$JSON_OUT" = true ]; then
    printf "$JSON_FAILURE_FORMAT\\n" "$(json_string "$message")" "$code" >&"$(_json_fd)"
  else
    echo "Error: $message" >&2
  fi
  exit "$code"
}

_die_usage() {
  if [ "$JSON_OUT" != true ] && [ -n "${2:-}" ]; then
    echo "Error: $1" >&2
    "$2" >&2
    exit "$EXIT_USAGE"
  fi
  _fail "$EXIT_USAGE" "$1"
}

_no_server_in() {
  local sign
  for sign in "${NO_SERVER_SIGNS[@]}"; do
    case "$1" in *"$sign"*) return 0 ;; esac
  done
  return 1
}

_tmux_read() {
  local err status=0
  err=$(mktemp)
  _tmux "$@" 2>"$err" || status=$?
  if [ "$status" -ne 0 ] && _no_server_in "$(cat "$err")"; then
    rm -f "$err"
    _fail "$EXIT_NO_SERVER" "no tmux server on socket '$TMUX_SOCKET'"
  fi
  cat "$err" >&2
  rm -f "$err"
  return "$status"
}

# After a `_tmux_read` run inside `$(…)` with its stderr dropped: a "no
# server" there has answered already under --json (the JSON fd is the real
# stdout) and exited only the subshell, so the caller would answer a second
# time with a reason of its own. Only its text line was dropped: print that,
# and exit with its code. Any other status is the caller's to read.
_exit_if_no_server() {
  [ "$1" -eq "$EXIT_NO_SERVER" ] || return 0
  [ "$JSON_OUT" = true ] || echo "Error: no tmux server on socket '$TMUX_SOCKET'" >&2
  exit "$EXIT_NO_SERVER"
}

# A pane to act on, from what the caller wrote: a tmux id (`%3`, `@2`, `$1`),
# an index or a `session:window.pane` target is handed back as it is; anything
# else is a LABEL — a pane's `@tmuxy-label` option (`tmuxy pane run --label`),
# else its title — and must name exactly one pane. None is exit 3; several is
# exit 3 too, with every match listed, and nothing changed.
_resolve_target() {
  local target="$1" rows matches count rc=0
  case "$target" in
    '' | %[0-9]* | @[0-9]* | \$[0-9]* | [0-9]* | *:* | *.* | '{'*)
      printf '%s' "$target"
      return 0
      ;;
  esac
  # The title is the app's (APP_PANE_TITLE_FMT): tmux seeds every untitled
  # pane's title with the host name, which would otherwise name them all.
  rows="$(_tmux_read list-panes -a -F "#{pane_id}"$'\t'"#{$OPT_PANE_LABEL}"$'\t'"$APP_PANE_TITLE_FMT"$'\t'"#{session_name}:#{window_index}" 2>/dev/null)" || rc=$?
  _exit_if_no_server "$rc"
  matches="$(printf '%s\n' "$rows" | awk -F'\t' -v want="$target" '$2 == want { print $1 "\t" $4 "\t" $2 }')"
  if [ -z "$matches" ]; then
    matches="$(printf '%s\n' "$rows" | awk -F'\t' -v want="$target" '$3 == want { print $1 "\t" $4 "\t" $3 }')"
  fi
  if [ -z "$matches" ]; then
    _fail "$EXIT_TARGET" "no pane labeled or titled '$target'"
  fi
  count="$(printf '%s\n' "$matches" | wc -l | tr -d ' ')"
  if [ "$count" -ne 1 ]; then
    if [ "$JSON_OUT" = true ]; then
      local list="" id where
      while IFS=$'\t' read -r id where _; do
        list="$list${list:+,}{\"paneId\":$(json_string "$id"),\"tab\":$(json_string "$where")}"
      done <<<"$matches"
      printf '{"ok":false,"error":%s,"code":%s,"matches":[%s]}\n' \
        "$(json_string "'$target' names $count panes; nothing changed")" "$EXIT_TARGET" "$list" >&"$(_json_fd)"
    else
      echo "Error: '$target' names $count panes; nothing changed. Pass the pane id:" >&2
      printf '%s\n' "$matches" | awk -F'\t' '{ printf "  %s  (%s)\n", $1, $2 }' >&2
    fi
    exit "$EXIT_TARGET"
  fi
  printf '%s' "${matches%%$'\t'*}"
}

# The parent of process `$1`, as `/proc` says; nothing where it cannot say.
_parent_of() {
  awk '/^PPid:/ { print $2; exit }' "/proc/$1/status" 2>/dev/null || true
}

# Every `pid ppid` pair, for a system without `/proc` (macOS).
_process_table() {
  ps -A -o pid=,ppid= 2>/dev/null || true
}

# The caller's own pane, if `$1` (a TMUX_PANE the caller handed in) is one:
# the pane whose process is an ancestor of this one. TMUX_PANE is only an
# environment variable, so anything can claim any pane with it; what the
# claim buys (typing into that pane without asking, setting its restore
# command or its widget tags) is given only to a process that really runs
# there. Prints nothing when it is not, and also when it cannot be proven:
# a parent that cannot be read anywhere up the line, or a process table that
# does not name this process. That case says so on stderr.
#
# A system that names no parent even for this process (the CheerpX guest's
# `/proc` has none, and its `ps` reads that `/proc`) can prove nothing, and
# there the claim stands only where the server says so: the guest's own
# config sets @tmuxy-trust-pane-claims on.
verified_own_pane() {
  local claimed="${1:-}" pane_pid verdict
  [ -n "$claimed" ] || return 0
  [[ "$claimed" =~ ^%[0-9]+$ ]] || return 0
  pane_pid="$(_tmux display-message -p -t "$claimed" '#{pane_pid}' 2>/dev/null)" || return 0
  [[ "$pane_pid" =~ ^[0-9]+$ ]] || return 0
  if [[ "$(_parent_of "$$")" =~ ^[1-9][0-9]*$ ]]; then
    local p="$$" i=0 ppid
    verdict=unproven
    while [ "$i" -lt 128 ]; do
      if [ "$p" = "$pane_pid" ]; then
        verdict=yes
        break
      fi
      [ "$p" -gt 1 ] || {
        verdict=no
        break
      }
      ppid="$(_parent_of "$p")"
      [[ "$ppid" =~ ^[0-9]+$ ]] || break
      p="$ppid"
      i=$((i + 1))
    done
  else
    # One table for the whole tree: 0 an ancestor, 1 not, 2 unproven.
    local rc=0
    _process_table | awk -v me="$$" -v want="$pane_pid" '
      { parent[$1] = $2 }
      END {
        if (!(me in parent) || parent[me] < 1) exit 2
        p = me
        for (i = 0; i < 128; i++) {
          if (p == want) exit 0
          if (p <= 1) exit 1
          if (!(p in parent)) exit 2
          p = parent[p]
        }
        exit 2
      }' || rc=$?
    case "$rc" in
      0) verdict=yes ;;
      1) verdict=no ;;
      *) verdict=unproven ;;
    esac
  fi
  case "$verdict" in
    yes) printf '%s' "$claimed" ;;
    unproven)
      if [ "$(_tmux show-options -gqv "$OPT_TRUST_PANE_CLAIMS" 2>/dev/null)" = on ]; then
        printf '%s' "$claimed"
      else
        echo "tmuxy: cannot prove this runs in $claimed (its process ancestry cannot be read), so it is treated as another pane" >&2
      fi
      ;;
  esac
}
