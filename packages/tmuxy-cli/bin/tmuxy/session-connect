#!/bin/bash
# session-connect — Staged server/session connect flow
#
# Usage: tmuxy session connect [<dest>] [--socket <name>] [--session <name>]
#
# Runs the 4-stage connect sequence (ssh -> tmux <ver> on socket -> listing
# sessions -> attach), printing each stage's status to stdout/stderr. The
# last stage is the server binary's `connect --save`: it saves the server to
# servers.json in the state dir with `last_used`, and publishes the request
# the desktop app's monitor attaches to (tmuxy_core::servers::connect).
set -euo pipefail
source "${0%/*}/_lib"

dest=""
target_socket=""
session_name=""
has_dest_arg=false

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      cat <<'EOF'
Usage: tmuxy session connect [<dest>] [--socket <name>] [--session <name>]

Connect to a tmux server on <dest> ([user@]host, or "localhost" / empty for
this machine) and attach to a session on its socket (default: tmuxy).

Stages:
  1. ssh <user@host> (or localhost)
  2. tmux <version> on the socket <name>
  3. listing sessions
  4. attach

Options:
  --socket <name>   tmux socket name (-L) or path (-S) (default: tmuxy)
  --session <name>  Session to attach to on the target server
  -h, --help        Show this help
EOF
      exit 0
      ;;
    --socket)
      shift
      if [ $# -eq 0 ] || [ -z "${1:-}" ]; then
        echo "Error: --socket requires a socket name" >&2
        exit 1
      fi
      target_socket="$1"
      shift
      ;;
    --socket=*)
      target_socket="${1#--socket=}"
      shift
      ;;
    --session)
      shift
      if [ $# -eq 0 ] || [ -z "${1:-}" ]; then
        echo "Error: --session requires a session name" >&2
        exit 1
      fi
      session_name="$1"
      shift
      ;;
    --session=*)
      session_name="${1#--session=}"
      shift
      ;;
    -*)
      echo "Error: unknown option '$1'" >&2
      exit 1
      ;;
    *)
      if ! $has_dest_arg; then
        dest="$1"
        has_dest_arg=true
      elif [ -z "$session_name" ]; then
        session_name="$1"
      fi
      shift
      ;;
  esac
done

if ! $has_dest_arg; then
  read -rp 'Connect to ([user@]host, or blank for localhost): ' dest || true
fi

# Strip optional leading "ssh " if a user pasted a full ssh command.
dest="${dest#ssh }"
dest="$(printf '%s' "$dest" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

is_remote=true
if [ -z "$dest" ] || [ "$dest" = "localhost" ]; then
  is_remote=false
  dest=""
fi

# A destination is `[user@]host` and nothing else. Checked after the pasted
# `ssh ` is stripped, so `ssh -oProxyCommand=…` cannot slip an option to ssh
# (which would run it as a local command).
if $is_remote && ! [[ "$dest" =~ ^([A-Za-z0-9._-]+@)?[A-Za-z0-9._:-]+$ ]] || [[ "$dest" == -* ]]; then
  echo "Error: '$dest' is not a [user@]host destination" >&2
  exit 1
fi

if [ -z "$target_socket" ]; then
  if $is_remote; then
    target_socket="tmuxy"
  else
    target_socket="$TMUX_SOCKET"
  fi
fi

if ! _is_safe_socket "$target_socket"; then
  echo "Error: '$target_socket' is not a valid tmux socket name or absolute path" >&2
  exit 1
fi
if [ -n "$session_name" ] && ! _is_safe_session_name "$session_name"; then
  echo "Error: '$session_name' is not a valid tmux session name" >&2
  exit 1
fi

case "$target_socket" in
  */*) target_sock_flag="-S" ;;
  *) target_sock_flag="-L" ;;
esac

# --- Stage 1: ssh <dest> / localhost ---
if $is_remote; then
  ssh_err_file=$(mktemp)
  if ! ssh -o BatchMode=yes -o ConnectTimeout=5 -- "$dest" true 2>"$ssh_err_file"; then
    ssh_err=$(cat "$ssh_err_file")
    rm -f "$ssh_err_file"
    echo "✗ ssh $dest" >&2
    [ -n "$ssh_err" ] && echo "$ssh_err" >&2
    exit 1
  fi
  rm -f "$ssh_err_file"
  echo "✓ ssh $dest"
else
  echo "✓ localhost"
fi

# --- Stage 2: tmux <version> on the socket <name> ---
ver_err_file=$(mktemp)
if $is_remote; then
  if ! raw_ver=$(ssh -o BatchMode=yes -o ConnectTimeout=5 -- "$dest" tmux -V 2>"$ver_err_file"); then
    ver_err=$(cat "$ver_err_file")
    rm -f "$ver_err_file"
    echo "✗ tmux on the socket $target_socket" >&2
    [ -n "$ver_err" ] && echo "$ver_err" >&2
    exit 1
  fi
else
  if ! raw_ver=$(_tmux -V 2>"$ver_err_file"); then
    ver_err=$(cat "$ver_err_file")
    rm -f "$ver_err_file"
    echo "✗ tmux on the socket $target_socket" >&2
    [ -n "$ver_err" ] && echo "$ver_err" >&2
    exit 1
  fi
fi
rm -f "$ver_err_file"
tmux_ver="${raw_ver#tmux }"
echo "✓ tmux${tmux_ver:+ $tmux_ver} on the socket $target_socket"

# --- Stage 3: listing sessions ---
sess_err_file=$(mktemp)
if $is_remote; then
  sessions_out=$(ssh -o BatchMode=yes -o ConnectTimeout=5 -- "$dest" \
    tmux "$target_sock_flag" "$target_socket" list-sessions -F '#{session_name}' 2>"$sess_err_file" || true)
elif [ "$target_socket" = "$TMUX_SOCKET" ]; then
  sessions_out=$(_tmux list-sessions -F '#{session_name}' 2>"$sess_err_file" || true)
else
  sessions_out=""
fi
rm -f "$sess_err_file"

if [ -z "$session_name" ] && [ -n "$sessions_out" ]; then
  session_name="$(_first_safe_session "$sessions_out")"
fi
echo "✓ listing sessions"

# --- Stage 4: attach ---
connect_args=(connect --save --socket "$target_socket")
[ -n "$session_name" ] && connect_args+=(--session "$session_name")
$is_remote && connect_args+=(--ssh "$dest")
find_server_cmd || exit 1
"${SERVER_CMD[@]}" "${connect_args[@]}" || exit $?
echo "✓ attach"
