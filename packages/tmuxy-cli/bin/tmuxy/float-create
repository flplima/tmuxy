#!/bin/bash
# Create a new float pane (centered or drawer)
#
# Options:
#   --left|--right|--top|--bottom   Drawer mode (slides from edge)
#   --width N                       Width in columns
#   --height N                      Height in rows
#   --bg dim|blur|none              Backdrop style
#   --hide-header                   Hide the header bar
#   --detach                        With a command: run it in the float and
#                                   print the float's pane id, without waiting
#
# Float-inside-float mode (called from within a float-typed window):
#   Runs the command directly in the current float pane (reuses the same slot).
#
# Interactive mode (no command args):
#   Creates a float pane with an interactive shell, outputs pane ID to stdout.
#
# Command mode (with args after options):
#   Creates a float pane running the command, captures its stdout,
#   waits for completion, auto-closes the float, and outputs the
#   captured stdout. Enables: FILE=$(tmuxy float fzf) && nvim "$FILE"
#   With --detach the float just runs the command, as its own program, and
#   its pane id is output at once (an MCP client's `pane_float`).

set -euo pipefail
source "${0%/*}/_lib"

# Parse options
DRAWER=""
WIDTH=""
HEIGHT=""
BG=""
HIDE_HEADER=""
DETACH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --left)         DRAWER="left";   shift ;;
    --right)        DRAWER="right";  shift ;;
    --top)          DRAWER="top";    shift ;;
    --bottom)       DRAWER="bottom"; shift ;;
    --width)        WIDTH="$2";      shift 2 ;;
    --height)       HEIGHT="$2";     shift 2 ;;
    --bg)           BG="$2";         shift 2 ;;
    --hide-header)  HIDE_HEADER="1"; shift ;;
    --detach)       DETACH="1";      shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

# The float itself is the server binary's `float` verb (tmuxy_core::float):
# one command list, split from the caller's pane, over its tab, in its session.
CALLER_TARGET=${TMUX_PANE:+-t $TMUX_PANE}
CURRENT_WIN=$(_tmux display-message -p $CALLER_TARGET '#{window_id}')
CURRENT_TYPE=$(window_type "$CURRENT_WIN")

FLOAT_ARGS=(float ${TMUX_PANE:+--pane "$TMUX_PANE"})
[ -n "$DRAWER" ] && FLOAT_ARGS+=(--drawer "$DRAWER")
[ -n "$WIDTH" ] && FLOAT_ARGS+=(--width "$WIDTH")
[ -n "$HEIGHT" ] && FLOAT_ARGS+=(--height "$HEIGHT")
[ -n "$BG" ] && FLOAT_ARGS+=(--bg "$BG")
[ -n "$HIDE_HEADER" ] && FLOAT_ARGS+=(--hide-header)

# Create the float, its pane running $1 (a shell line) when given, and set
# NEW_PANE_ID and NEW_WIN_ID to its pane and window, or fail.
create_float() {
  local ids
  find_server_cmd || exit 1
  ids=$("${SERVER_CMD[@]}" "${FLOAT_ARGS[@]}" ${1:+--command "$1"}) || exit $?
  read -r NEW_PANE_ID NEW_WIN_ID <<<"$ids"
}

if [ "$CURRENT_TYPE" = "float" ]; then
  # Already in a float - reuse the current slot instead of creating a new one
  if [ $# -eq 0 ]; then
    # Interactive mode inside float: replace current shell with a new one
    exec "${SHELL:-bash}"
  else
    # Command mode inside float: run the command directly here, output its result
    "$@"
  fi
  exit $?
fi

if [ $# -eq 0 ]; then
  # Interactive mode: create the float with a shell, output its pane id.
  create_float
  echo "$NEW_PANE_ID"
elif [ -n "$DETACH" ]; then
  # Detached: the command is the float's program, each word quoted for the
  # shell tmux runs it with, and nothing waits on it.
  create_float "$(printf '%q ' "$@")"
  echo "$NEW_PANE_ID"
else
  # Command mode: run the command in the float, capture its stdout, auto-close.
  TMPFILE=$(umask 077 && mktemp /tmp/tmuxy-float-out.XXXXXX)
  WRAPPER=$(umask 077 && mktemp /tmp/tmuxy-float-cmd.XXXXXX)
  trap 'rm -f "$TMPFILE" "$WRAPPER"' EXIT
  WAIT_CHAN="float-done-$$"

  # Do NOT redirect stderr - TUI apps (fzf, vim, etc.) draw their interface to
  # stderr/tty. Only redirect stdout to the capture file. A wrapper script keeps
  # the command out of the tmux command list, where its quoting would have to
  # survive both the shell and tmux's parser. Each word is quoted for the shell
  # again, as `pane run`'s wrapper does: the float runs the program with the
  # arguments it was given, none of them read as shell syntax.
  {
    echo '#!/bin/bash'
    printf '%q ' "$@"
    printf '> %q\n' "$TMPFILE"
    printf '%q %s %q wait-for -S %q\n' "$TMUX_BIN" "$TMUX_SOCKET_FLAG" "$TMUX_SOCKET" "$WAIT_CHAN"
  } > "$WRAPPER"
  chmod 700 "$WRAPPER"

  create_float "bash $(printf '%q' "$WRAPPER")"

  # Wait for the command to finish
  _tmux wait-for "$WAIT_CHAN"

  # Auto-close the float window.
  #
  # The pane pids are read first: kill-window closes each PTY master right
  # after the SIGHUP, and a shell still inside its own start-up never returns
  # from opening its controlling terminal — it sleeps in the kernel holding a
  # PTY slave (see `reap-orphan-shells`). A float whose command exits
  # immediately is exactly that race. A window id never resolves to another
  # window: when the float has closed on its own, both calls just fail.
  FLOAT_PANE_PIDS=$(_tmux list-panes -t "$NEW_WIN_ID" -F '#{pane_pid}' 2>/dev/null || true)
  if [ -n "$FLOAT_PANE_PIDS" ]; then
    _run_safe "kill-window -t $NEW_WIN_ID" || true
    reap_pids "$FLOAT_PANE_PIDS"
  fi

  # Output captured stdout
  cat "$TMPFILE"
fi
