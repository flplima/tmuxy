#!/bin/bash
# Usage: some-command | tmuxy-widget <component-name> [title]
#
# Prints the widget marker, then passes stdin through to stdout. The title,
# the component's name by default, is what the pane calls itself meanwhile.
# On exit (Ctrl+C, pipe close, SIGTERM), clears the terminal so the
# widget marker disappears and starts an interactive shell so the
# pane remains alive.
COMPONENT="${1:?Usage: tmuxy-widget <component-name> [title]}"
TITLE="${2:-$COMPONENT}"

# `shquote` / `_run_safe` (mutations go through `tmux run-shell`, see
# docs/TMUX.md).
source "$(cd "$(dirname "$0")" && pwd)/_lib"
# What the pane calls itself while the widget runs. A widget's own title
# normally comes from the UI — but a pane PARKED in a group's stash streams no
# content, so the only thing a group's tab strip has for it is tmux's
# `pane_title`. Left alone that is whatever the shell last set: the CLI's own
# path, which names nothing. Announcing the widget's name over OSC 2 gives the
# parked member something to be called, and costs the visible one nothing (the
# widget's own title wins there).

# The marker below is pane OUTPUT, and anything the pane prints can carry it —
# a crafted file, a commit message in `git log`, an ssh MOTD. This option is
# what says the widget was actually ASKED for: the client renders one only when
# the pane is tagged with the same name. Set before the marker is printed, so
# the client never sees a marker it has no authorisation for: `run-shell`
# returns only once the command has run, so the option is on the pane before
# the marker is printed and the `list-panes` that follows the output carries
# it. The target is explicit — inside `run-shell` the command runs as a client
# of its own, and "the current pane" there is whichever pane tmux last used,
# not this one.
_run_safe "set-option -p -t $(shquote "$TMUX_PANE") @tmuxy-pane-widget $(shquote "$COMPONENT")"

# Hand the title back on the way out, so the pane does not keep the widget's
# name once it is a shell again. Empty resets it to tmux's own default. The
# authorisation goes with it — the pane is a shell again, and a shell's output
# must not be able to bring the widget back. The shell that replaces the widget
# is the user's own: closing a widget is not a reason to land them in a bash
# they did not choose.
#
# The first thing it does is ignore another Ctrl+C: one pressed twice would
# otherwise kill the trap halfway, leaving the marker on the screen and the
# authorisation on the pane over a shell. The default is back before the
# shell starts, since an ignored signal survives `exec` — and a shell started
# with Ctrl+C ignored passes that on to everything it runs. A pane with no
# terminal to open (the CheerpX demo's) gets no new shell: the one that ran
# the widget is back at its prompt.
trap 'trap "" INT; printf "\033]2;\007"; _run_safe "set-option -p -u -t $(shquote "$TMUX_PANE") @tmuxy-pane-widget"; clear; trap - INT; if { : </dev/tty; } 2>/dev/null; then exec "${SHELL:-bash}" </dev/tty; fi' EXIT

printf '\033]2;%s\007' "$TITLE"
echo "__TMUXY_WIDGET__:${COMPONENT}"
cat
