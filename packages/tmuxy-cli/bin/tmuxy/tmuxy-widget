#!/bin/bash
# Usage: some-command | tmuxy-widget <component-name> [title]
#
# Prints the widget marker, then passes stdin through to stdout. The title,
# the component's name by default, is what the pane calls itself meanwhile.
COMPONENT="${1:?Usage: tmuxy-widget <component-name> [title]}"
TITLE="${2:-$COMPONENT}"

# shellcheck source=_lib
source "${0%/*}/_lib"

# The marker below is pane OUTPUT, and anything the pane prints can carry it —
# a crafted file, a commit message in `git log`, an ssh MOTD. This option is
# what says the widget was actually ASKED for: the client renders one only when
# the pane is tagged with the same name. Set before the marker is printed, so
# the client never sees a marker it has no authorisation for: `run-shell`
# returns only once the command has run, so the option is on the pane before
# the marker is printed and the `list-panes` that follows the output carries
# it. The target is explicit — inside `run-shell` the command runs as a client
# of its own, and "the current pane" there is whichever pane tmux last used,
# not this one.
OWN_PANE="${TMUXY_CALLER_PANE-${TMUX_PANE:-}}"
if [ -z "$OWN_PANE" ]; then
  echo "Error: run this inside a tmuxy pane" >&2
  exit 1
fi
if [ "$(verified_own_pane "$OWN_PANE")" != "$OWN_PANE" ]; then
  echo "Error: cannot run a widget on another pane ($OWN_PANE)" >&2
  exit 1
fi
TMUX_PANE="$OWN_PANE"
export TMUX_PANE
PANE="$(shquote "$TMUX_PANE")"
_run_safe "set-option -p -t $PANE $OPT_PANE_WIDGET $(shquote "$COMPONENT")"

# Hand the title back on the way out, so the pane does not keep the widget's
# name once it is a shell again. Empty resets it to tmux's own default. The
# authorisation goes with it — the pane is a shell again, and a shell's output
# must not be able to bring the widget back. The shell that replaces the widget
# is the user's own: closing a widget is not a reason to land them in a bash
# they did not choose.
#
# The first thing it does is ignore another Ctrl+C: one pressed twice would
# otherwise kill the trap halfway, leaving the marker on the screen and the
# authorisation on the pane over a shell. The default is back before the
# shell starts, since an ignored signal survives `exec` — and a shell started
# with Ctrl+C ignored passes that on to everything it runs.
#
# The title is reset from a subshell. When the pane has already closed (its
# session killed), the write fails, and bash 3.2's `printf` keeps the bytes it
# could not write: every `$( … )` forked after it flushes them into its own
# result. `_run_safe` builds its line from those, so the ESC ] 2 ; BEL ended
# the command in the middle, and its `echo $? >…status` wrote a file named
# ESC ] 2 into whatever directory the pane had started in.
#
# Before the shell, the pane's unread input is dropped: tmux types a page's
# line only while the pane is tagged (docs/SECURITY-WIDGETS.md), but one
# typed in the moment between the widget's end and the tag going is still
# waiting there, and the shell would run it. Read with no wait (`min 0 time
# 0`), so `cat` ends at once on what is there, then the terminal is put back
# the way a shell expects it.
drain_input() {
  stty -icanon min 0 time 0 </dev/tty 2>/dev/null && cat </dev/tty >/dev/null 2>&1
  stty echo icanon min 1 time 0 </dev/tty 2>/dev/null || true
}
trap 'trap "" INT; ( printf "\033]2;\007" ) 2>/dev/null; _run_safe "set-option -p -u -t $PANE $OPT_PANE_WIDGET"; clear; trap - INT; drain_input; exec "${SHELL:-bash}" </dev/tty' EXIT

# A widget's own title normally comes from the UI, but a pane PARKED in a
# group's stash streams no content, so the only thing a group's tab strip has
# for it is tmux's `pane_title`, which is otherwise whatever the shell last set.
# OSC 2 gives the parked member a name; on the visible one the widget's own
# title wins.
printf '\033]2;%s\007' "$TITLE"
echo "${WIDGET_MARKER}${COMPONENT}"
cat
