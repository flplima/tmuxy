#!/bin/bash
# A live web page in this pane, drawn as Kitty graphics from a headless Chrome
# and driven from the pane (tmuxy widget browser). The work is browser.js,
# beside this script; here is only what the shell is for: finding a node
# that can run it, and saying clearly when there is none.
#
# Usage: tmuxy widget browser [options] <url>     (tmuxy widget browser --help)

set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)"

# browser.js opens its own WebSocket to Chrome, which node has had since 22.
NODE="${TMUXY_NODE:-}"
if [ -z "$NODE" ]; then
  NODE="$(command -v node 2>/dev/null || true)"
fi
if [ -z "$NODE" ]; then
  echo "Error: node 22 or newer is required for tmuxy widget browser (set TMUXY_NODE to one)" >&2
  exit 1
fi
MAJOR="$("$NODE" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$MAJOR" -lt 22 ]; then
  echo "Error: node 22 or newer is required for tmuxy widget browser (found $("$NODE" -v 2>/dev/null || echo none))" >&2
  exit 1
fi

exec "$NODE" "$SCRIPTS_DIR/browser.js" "$@"
