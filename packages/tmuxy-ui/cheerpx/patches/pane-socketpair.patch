+/*
+ * CheerpX gives every process the same pseudo-terminal, so a pane runs on a
+ * socket pair instead, under tmuxy-pty, which plays the terminal for it: echo,
+ * line editing, Ctrl+C and newline translation.
+ */
+#define SPAWN_PANE_HELPER "/usr/bin/tmuxy-pty"
+
+/* Fork a child whose stdin, stdout and stderr are one end of a socket pair;
+ * the parent gets the other end in fd. */
+static pid_t
+spawn_fork_socketpair(int *fd)
+{
+	int	sv[2];
+	pid_t	pid;
+
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) != 0)
+		return (-1);
+	switch (pid = fork()) {
+	case -1:
+		close(sv[0]);
+		close(sv[1]);
+		return (-1);
+	case 0:
+		close(sv[0]);
+		setsid();
+		dup2(sv[1], STDIN_FILENO);
+		dup2(sv[1], STDOUT_FILENO);
+		dup2(sv[1], STDERR_FILENO);
+		if (sv[1] > STDERR_FILENO)
+			close(sv[1]);
+		return (0);
+	}
+	close(sv[1]);
+	*fd = sv[0];
+	return (pid);
+}
+
+/* Run file with argv under the helper, as execvp(file, argv) would. */
+static __dead void
+spawn_exec(const char *file, char **argv)
+{
+	char	**hargv;
+	int	  n;
+
+	for (n = 0; argv[n] != NULL; n++)
+		continue;
+	hargv = xcalloc(n + 3, sizeof *hargv);
+	hargv[0] = xstrdup(SPAWN_PANE_HELPER);
+	hargv[1] = xstrdup(file);
+	memcpy(hargv + 2, argv, (n + 1) * sizeof *hargv);
+	execv(SPAWN_PANE_HELPER, hargv);
+	_exit(1);
+}
