#!/usr/bin/env bash
#
# Bump tmuxy's version everywhere it is written down, then commit it.
#
# Usage: bump-version                 # current alpha number + 1
#        bump-version <new-version>   # explicit, e.g. 0.0.11-alpha.0
#        bump-version --dry-run       # print the plan, change nothing
#
# Touches the same 6 files as every prior release commit, so the tag is
# reproducible without a build step:
#   Cargo.toml (workspace.package.version)
#   package.json
#   packages/tmuxy-ui/package.json
#   packages/tmuxy-demo/package.json
#   packages/tmuxy-tauri-app/tauri.conf.json   (literal: Tauri 2 forbids templating)
#   Cargo.lock                                 (regenerated by cargo build)

set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

DRY=0
NEW=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY=1 ;;
    -*) echo "unknown flag: $arg" >&2; exit 2 ;;
    *) NEW="$arg" ;;
  esac
done

CUR=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)
[ -n "$CUR" ] || { echo "could not read version from Cargo.toml" >&2; exit 1; }

if [ -z "$NEW" ]; then
  case "$CUR" in
    *-alpha.*) NEW="${CUR%.*}.$(( ${CUR##*.} + 1 ))" ;;
    *) echo "'$CUR' is not an -alpha.N version; pass the new version explicitly" >&2; exit 1 ;;
  esac
fi

echo "current: $CUR"
echo "next:    $NEW"

JSON_FILES=(
  package.json
  packages/tmuxy-ui/package.json
  packages/tmuxy-demo/package.json
  packages/tmuxy-tauri-app/tauri.conf.json
)

# Every file must currently agree, or a previous bump was left half-applied.
BAD=0
grep -q "^version = \"$CUR\"$" Cargo.toml || { echo "  MISMATCH Cargo.toml"; BAD=1; }
for f in "${JSON_FILES[@]}"; do
  grep -q "^  \"version\": \"$CUR\",$" "$f" || { echo "  MISMATCH $f"; BAD=1; }
done
[ "$BAD" -eq 0 ] || { echo "refusing to bump: the 6 files disagree on the current version" >&2; exit 1; }

if [ "$DRY" -eq 1 ]; then
  echo "(dry run) would rewrite Cargo.toml + ${#JSON_FILES[@]} json files, regenerate Cargo.lock, and commit '🚀 v$NEW'"
  exit 0
fi

# Portable in-place edit (BSD and GNU sed disagree about -i).
sub() {
  local file=$1 pattern=$2 tmp
  tmp=$(mktemp)
  sed "$pattern" "$file" > "$tmp" && mv "$tmp" "$file"
}

sub Cargo.toml "s|^version = \"$CUR\"$|version = \"$NEW\"|"
for f in "${JSON_FILES[@]}"; do
  sub "$f" "s|^  \"version\": \"$CUR\",$|  \"version\": \"$NEW\",|"
done

# cargo racing the running dev-mode binary yields transient "Permission denied".
if command -v pm2 >/dev/null 2>&1; then
  pm2 stop tmuxy-dev >/dev/null 2>&1 || true
fi

echo "regenerating Cargo.lock..."
cargo build -p tmuxy-server

git add Cargo.toml Cargo.lock "${JSON_FILES[@]}"
git commit -m "🚀 v$NEW"

echo
git show --stat --oneline HEAD
echo
echo "Expected: exactly 6 files. Compare with: git show --stat v$CUR"
