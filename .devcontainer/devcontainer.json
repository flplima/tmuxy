{
  "name": "tmuxy-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}"
    }
  },
  "runArgs": [
    "--init",
    "--memory=12g",
    "--shm-size=1g",
    "--pids-limit=50000"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [9000, 9001],
  "remoteUser": "user",
  // Remap `user` to the host uid/gid on create so the bind-mounted /tmuxy is
  // writable. The bin/devcontainer path passes --user directly instead.
  "updateRemoteUserUID": true,
  "mounts": [
    "source=tmuxy-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=tmuxy-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=tmuxy-cargo-git,target=/usr/local/cargo/git,type=volume",
    // Credentials are NOT mounted from host. Log in once inside the
    // container; named volumes persist auth across rebuilds.
    // Note: this workspace currently persists Claude CLI state in ~/.claude
    // and ~/.claude.json for local multi-agent workflows.
    // Copilot cloud sessions do not use this devcontainer; they use
    // `.github/workflows/copilot-setup-steps.yml` instead.
    "source=tmuxy-gh-config,target=/home/user/.config/gh,type=volume",
    "source=tmuxy-claude-config,target=/home/user/.claude,type=volume",
    "source=tmuxy-ssh,target=/home/user/.ssh,type=volume",
    "source=tmuxy-git-config,target=/home/user/.config/git,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=2048",
    "CLAUDE_CONFIG_DIR": "/home/user/.claude",
    "CHROME_CDP_URL": "http://localhost:9222",
    "TMUX_SESSION": "dev",
    "GIT_CONFIG_GLOBAL": "/home/user/.config/git/config"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/tmuxy,type=bind,consistency=delegated",
  "workspaceFolder": "/tmuxy",
  "postCreateCommand": "npm ci && ln -sf /tmuxy/.devcontainer/.tmuxy.conf ~/.tmuxy.conf && ln -sf /tmuxy/bin/tmuxy-cli ~/.local/bin/tmuxy",
  "postStartCommand": ".devcontainer/fix-credential-ownership.sh && .devcontainer/persist-claude-login.sh && npm start"
}
