{
  "name": "tmuxy-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}"
    }
  },
  // `runArgs` is ignored by Codespaces, so nothing essential may live there.
  // --init has a first-class key; the Chromium flags that used to need
  // --shm-size=1g (--disable-dev-shm-usage) are already passed at every
  // Playwright launch site, and memory/pid limits come from the machine size.
  "init": true,
  // Matches standardLinux32gb, the largest machine this repo is offered.
  // Asking for more than an available machine provides makes codespace
  // creation fail with no eligible machine type.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [9000, 9001],
  "portsAttributes": {
    "9000": { "label": "tmuxy server" },
    "9001": { "label": "vite" }
  },
  "remoteUser": "user",
  // No workspaceMount/workspaceFolder override: Codespaces ignores a custom
  // mount (it clones into its own volume) and VS Code's default is the same
  // /workspaces/<repo> path. Every script derives the repo root from its own
  // location instead of hardcoding one, so all hosts agree.
  //
  // The credential volumes below are a LOCAL convenience — log in once inside
  // the container and the named volumes persist gh/claude/ssh/git auth across
  // rebuilds. Codespaces ignores them (it injects its own git and gh auth), and
  // the scripts that maintain them no-op when $CODESPACES is set.
  //
  // Copilot's cloud agent uses neither: it runs
  // `.github/workflows/copilot-setup-steps.yml`.
  //
  // node_modules lives in container-private volumes, NOT the bind-mounted
  // workspace: npm installs platform-specific binaries (rollup, esbuild, swc),
  // so a macOS host and a linux container need different ones and sharing the
  // directory breaks whichever did not install last. Harmless in Codespaces,
  // which has no host to clash with — `onCreateCommand` fills them either way.
  "mounts": [
    "source=tmuxy-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=tmuxy-node-modules-ui-${devcontainerId},target=${containerWorkspaceFolder}/packages/tmuxy-ui/node_modules,type=volume",
    "source=tmuxy-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=tmuxy-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=tmuxy-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=tmuxy-gh-config,target=/home/user/.config/gh,type=volume",
    "source=tmuxy-claude-config,target=/home/user/.claude,type=volume",
    "source=tmuxy-ssh,target=/home/user/.ssh,type=volume",
    "source=tmuxy-git-config,target=/home/user/.config/git,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=2048",
    "CLAUDE_CONFIG_DIR": "/home/user/.claude",
    "CHROME_CDP_URL": "http://localhost:9222",
    "TMUX_SESSION": "dev"
  },
  // Cacheable by Codespaces prebuilds — everything expensive happens here.
  "onCreateCommand": "bash .devcontainer/fix-node-modules-ownership.sh && bash bin/bootstrap",
  "postStartCommand": "bash .devcontainer/setup.sh && .devcontainer/fix-credential-ownership.sh && .devcontainer/persist-claude-login.sh"
}
