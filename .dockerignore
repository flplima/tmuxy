# Keep the build context small and free of anything a public image must not see.
# The public-demo image (deploy/public-demo/) builds from the repo root, so this
# is what decides what can possibly reach it.
node_modules
target
.git
.envrc
.envrc.local
*.log
packages/tmuxy-ui/dist
packages/tmuxy-ui/storybook-static
packages/tmuxy-ui/probe-artifacts
perf/*-report.json
