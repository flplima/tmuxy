{
  "_comment": [
    "The web E2E matrix: one runner per entry in lint-and-tests.yml, read by bin/ci/e2e-plan.mjs.",
    "`path` is the regex jest matches against each test file's path. An oversized family of files",
    "is split across runners by naming its files, so a test's describe title never decides its runner.",
    "`tier: nightly` marks a file whose every test is tagged [nightly]: it leaves the per-commit",
    "matrix rather than spend a runner on a suite that would skip everything. docs/TESTS-LAYERS.md § Tiers.",
    "`tmux` runs the entry on that tmux instead of the 3.7a every other entry builds against."
  ],
  "suites": [
    { "name": "snapshots", "path": "tests/snapshots/" },
    { "name": "1-input", "path": "tests/1-input-interaction" },
    {
      "name": "2-layout-a",
      "path": "tests/2-layout-navigation(-(float|groups|overview|panes|zoom-drag))?\\.test\\.js"
    },
    {
      "name": "2-layout-b",
      "path": "tests/2-layout-navigation-(dock|float-scope|group-drag|peek|tree|tree-drag|tree-rows)\\.test\\.js"
    },
    { "name": "3-rendering-a", "path": "tests/3-rendering-protocols-(links|unicode)\\.test\\.js" },
    { "name": "3-rendering-b", "path": "tests/3-rendering-protocols(-images)?\\.test\\.js" },
    { "name": "4-session", "path": "tests/4-session-connectivity" },
    { "name": "5-stress", "path": "tests/5-stress-stability.test.js" },
    { "name": "6-nvim", "path": "tests/6-nvim-performance.test.js", "tier": "nightly" },
    { "name": "7-regression", "path": "tests/7-regression-bugs" },
    { "name": "8-tui-group-tab", "path": "tests/8-" },
    {
      "name": "tmux-3.4",
      "path": "tests/(snapshots/|8-tui-alternate-screen|7-regression-bugs-run-shell)",
      "tmux": "3.4"
    },
    { "name": "11-webkit", "path": "tests/11-webkit.test.js", "webkit": true },
    { "name": "12-touch", "path": "tests/12-touch" },
    { "name": "13-send-permission", "path": "tests/13-send-permission.test.js" },
    { "name": "19-mcp", "path": "tests/19-mcp.test.js" },
    { "name": "20-push", "path": "tests/20-push.test.js" },
    { "name": "21-agent-states", "path": "tests/21-agent-states.test.js" },
    { "name": "22-process-icons", "path": "tests/22-process-icons.test.js" },
    { "name": "14-widget-authorisation", "path": "tests/14-widget-authorisation.test.js" },
    { "name": "14-widget-preview", "path": "tests/14-widget-preview.test.js" },
    {
      "name": "16-personalization-plugins",
      "path": "tests/1[678]-(personalization|plugin)"
    },
    {
      "name": "15-session-snapshot",
      "path": "tests/15-session-snapshot.test.js",
      "tier": "nightly"
    }
  ]
}
