#!/bin/bash
# Mock tmux binary for CLI tests
# Logs every invocation and returns canned responses

if [ -n "$MOCK_TMUX_LOG" ]; then
  args_json="["
  first=true
  for arg in "$@"; do
    if $first; then first=false; else args_json="$args_json,"; fi
    # Escape for JSON: backslash, quote, and the control characters that appear
    # in tmux -F format strings (tabs are the --json field separator).
    escaped="${arg//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    escaped="${escaped//$'\t'/\\t}"
    escaped="${escaped//$'\r'/\\r}"
    args_json="$args_json\"$escaped\""
  done
  args_json="$args_json]"
  echo "{\"args\":$args_json}" >> "$MOCK_TMUX_LOG"
fi

exit_code="${MOCK_TMUX_EXIT_CODE:-0}"

# Skip the socket flag pair (-L <name> / -S <path>) for response dispatch.
# The raw argv INCLUDING the socket flag was already logged above — the
# run-cli helper asserts its presence — but canned responses key off the
# actual subcommand.
if [ "${1:-}" = "-L" ] || [ "${1:-}" = "-S" ]; then
  shift 2
fi

# No server on the socket: what tmux says, on every command, when nothing
# listens there. The CLI turns it into exit 4.
if [ -n "${MOCK_TMUX_NO_SERVER:-}" ]; then
  echo "no server running on /tmp/tmux-1000/tmuxy" >&2
  exit 1
fi

# Handle stdin for load-buffer (`load-buffer [-b name] -`): kept in
# MOCK_TMUX_BUFFER_FILE when a test wants to read what was loaded.
if [ "${1:-}" = "load-buffer" ] && [ "${!#}" = "-" ]; then
  cat > "${MOCK_TMUX_BUFFER_FILE:-/dev/null}"
  exit "$exit_code"
fi

# What `display-message` prints for a format: each question a script asks
# of the caller's pane.
display_answer() {
  case "$1" in
    *'#{session_name}'*$'\\t'*'#{pane_id}'*|*'#{session_name}'*$'\t'*'#{pane_id}'*)
      if [ -n "${MOCK_TMUX_INFO:-}" ]; then
        printf '%b\n' "$MOCK_TMUX_INFO"
      else
        printf 'tmuxy\t%%0\t@0\t120\t40\tzsh\t0\tmain\t2\n'
      fi
      ;;
    # `verified_own_pane`: the process in the caller's pane. A test whose
    # caller runs there names an ancestor of the CLI (jest's own pid).
    *'#{pane_pid}'*) echo "${MOCK_TMUX_PANE_PID:-}" ;;
    # `pane send` names the caller after the program in front in its pane.
    *'#{pane_current_command}'*) echo "${MOCK_TMUX_PANE_COMMAND:-}" ;;
    # `pane wait` polls whether the program has exited, and how.
    *'#{pane_dead}'*) printf '%s\t%s\n' "${MOCK_TMUX_PANE_DEAD:-0}" "${MOCK_TMUX_PANE_DEAD_STATUS:-0}" ;;
    *'#{session_name}'*) echo "${MOCK_TMUX_SESSION:-}" ;;
    *'#{@tmuxy-group-id}'*) echo "${MOCK_TMUX_GROUP_ID:-}" ;;
    *'#{window_id}'*) echo "${MOCK_TMUX_WINDOW_ID:-}" ;;
    *'#{pane_id}'*) echo "${MOCK_TMUX_PANE_ID:-}" ;;
    *'#{window_height}'*) echo "${MOCK_TMUX_WINDOW_ROWS:-}" ;;
    *) ;;
  esac
}

case "${1:-}" in
  list-panes)
    # The CLI's first call from outside a pane asks which pane it should act
    # on (`-f` filter, see TMUX_PANE in packages/tmuxy-cli/bin/tmuxy-cli). Silent unless a test
    # sets MOCK_TMUX_CALLER_PANES, so no other test gains a TMUX_PANE.
    if [ "${2:-}" = "-a" ] && [ "${3:-}" = "-f" ]; then
      [ -n "${MOCK_TMUX_CALLER_PANES:-}" ] && printf '%b\n' "$MOCK_TMUX_CALLER_PANES"
      exit "$exit_code"
    fi
    # `_resolve_target` asks every pane for its label and title:
    # `id<TAB>label<TAB>title<TAB>session:index` per line (MOCK_TMUX_LABELS).
    case "$*" in
      *'#{@tmuxy-label}'*'#{pane_title}'*)
        [ -n "${MOCK_TMUX_LABELS:-}" ] && printf '%b\n' "$MOCK_TMUX_LABELS"
        exit "$exit_code"
        ;;
    esac
    if [ -n "${MOCK_TMUX_LIST_PANES:-}" ]; then
      echo "$MOCK_TMUX_LIST_PANES"
    else
      printf '%%0\t@0\t120\t40\tzsh\t1\n'
      printf '%%1\t@0\t120\t40\tvim\t0\n'
    fi
    ;;
  list-sessions)
    if [ -n "${MOCK_TMUX_LIST_SESSIONS:-}" ]; then
      printf '%b\n' "$MOCK_TMUX_LIST_SESSIONS"
    fi
    ;;
  list-windows)
    # `_resolve_tab`: `id<TAB>name<TAB>session` per line (MOCK_TMUX_TAB_NAMES).
    case "$*" in
      *'#{window_name}'*'#{session_name}'*)
        [ -n "${MOCK_TMUX_TAB_NAMES:-}" ] && printf '%b\n' "$MOCK_TMUX_TAB_NAMES"
        exit "$exit_code"
        ;;
    esac
    if [ -n "${MOCK_TMUX_LIST_WINDOWS:-}" ]; then
      echo "$MOCK_TMUX_LIST_WINDOWS"
    else
      printf '@0\t0\tmain\t2\t1\ttab\n'
      printf '@1\t1\teditor\t1\t0\ttab\n'
    fi
    ;;
  split-window)
    echo "${MOCK_TMUX_SPLIT_PANE_ID:-%99}"
    ;;
  capture-pane)
    if [ -n "${MOCK_TMUX_CAPTURE:-}" ]; then
      echo "$MOCK_TMUX_CAPTURE"
    else
      echo "mock captured content"
    fi
    ;;
  display-message)
    fmt="${*: -1}"
    # `_pane_read` asks for the pane's id first. A pane MOCK_TMUX_GONE_PANES
    # lists answers as tmux answers for a gone one: for no pane.
    if [[ "$fmt" == '#{pane_id}'$'\t'* ]]; then
      target="" prev=""
      for arg in "$@"; do
        [ "$prev" = -t ] && target=$arg
        prev=$arg
      done
      case " ${MOCK_TMUX_GONE_PANES:-} " in
        *" $target "*) printf '\t\n' ;;
        *) printf '%s\t%s\n' "$target" "$(display_answer "${fmt#*$'\t'}")" ;;
      esac
    else
      display_answer "$*"
    fi
    ;;
  show-options)
    # `pane send` reads its two switches, and the pane states it saves and
    # restores, from these.
    case "$*" in
      *@tmuxy-send-ask) echo "${MOCK_TMUX_SEND_ASK:-}"; exit 0 ;;
      *@tmuxy-send-allow) echo "${MOCK_TMUX_SEND_ALLOW:-}"; exit 0 ;;
      *@tmuxy-send-allow-into) echo "${MOCK_TMUX_SEND_ALLOW_INTO:-}"; exit 0 ;;
      # The caller's window's type (`window_type`, packages/tmuxy-cli/bin/tmuxy/_lib).
      *@tmuxy-window-type) echo "${MOCK_TMUX_WINDOW_TYPE:-}"; exit 0 ;;
      # The pane's state, played from the log once the script has written
      # one (the last write wins, an unset clears it), else
      # MOCK_TMUX_PANE_STATE: a pane marked waiting reads as waiting.
      *@tmuxy-pane-state)
        last=""
        [ -n "${MOCK_TMUX_LOG:-}" ] &&
          last=$(grep -E "set-option -p( -u|u)? -t '[^']*' @tmuxy-pane-state" "$MOCK_TMUX_LOG" | tail -1)
        case "$last" in
          "") echo "${MOCK_TMUX_PANE_STATE:-}" ;;
          *"set-option -pu "* | *"set-option -p -u "*) ;;
          *) printf '%s\n' "$last" | sed -n "s/.*@tmuxy-pane-state '\{0,1\}\([a-z-]*\).*/\1/p" ;;
        esac
        exit 0
        ;;
      # The question on the pane, played from the log: what the last write put
      # there, nothing once an unset followed it. MOCK_TMUX_PENDING_ASK plays
      # another sender's question already up, for that many reads;
      # MOCK_TMUX_ASK_REPLACED plays one asked over this sender's, from the
      # moment this sender's own write is in the log.
      *" @tmuxy-ask")
        [ -n "${MOCK_TMUX_LOG:-}" ] || exit 0
        if [ -n "${MOCK_TMUX_PENDING_ASK:-}" ]; then
          reads=$(grep -c '"show-options",.*"@tmuxy-ask"\]' "$MOCK_TMUX_LOG")
          if [ "$reads" -le "$MOCK_TMUX_PENDING_ASK" ]; then echo "b3RoZXI="; exit 0; fi
        fi
        last=$(grep -E "set-option -pu? -t '[^']*' @tmuxy-ask( |\"\]\}\$)" "$MOCK_TMUX_LOG" | tail -1)
        case "$last" in
          *" @tmuxy-ask '"*)
            if [ -n "${MOCK_TMUX_ASK_REPLACED:-}" ]; then echo "$MOCK_TMUX_ASK_REPLACED"; exit 0; fi
            printf '%s' "$last" | sed -n "s/.*@tmuxy-ask '\([A-Za-z0-9+/=]*\)'.*/\1/p"
            ;;
        esac
        exit 0
        ;;
    esac
    # Asking, it polls @tmuxy-ask-answer until a client writes one. MOCK_TMUX_ANSWER
    # (yes/no) makes this mock play that client: it recovers the token the same
    # way a real one does — from the base64 @tmuxy-ask payload the script just
    # wrote — and answers with it. Unset means no answer yet.
    if [ -n "${MOCK_TMUX_ANSWER:-}" ] && [ -n "${MOCK_TMUX_LOG:-}" ]; then
      encoded=$(sed -n "s/.*@tmuxy-ask '\([A-Za-z0-9+/=]*\)'.*/\1/p" "$MOCK_TMUX_LOG" | tail -1)
      if [ -n "$encoded" ]; then
        token=$(printf '%s' "$encoded" | base64 -d 2>/dev/null \
          | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
        [ -n "$token" ] && echo "$token:$MOCK_TMUX_ANSWER"
      fi
    fi
    ;;
  run-shell)
    # `_run_shell` names the caller's pane as the target; the command is the
    # argument after it either way.
    if [ "${2:-}" = "-t" ]; then set -- "$1" "${@:4}"; fi
    case "$*" in
      # A float's list (tmuxy-core `float`) ends in a read of the pane and
      # window it made.
      *split-window*break-pane*display-message*) response="${MOCK_TMUX_FLOAT_IDS:-%99 @98}" ;;
      # A list that ends in a `breakp -P` prints the window it made, even
      # when a `splitw` precedes it (`tab create`).
      *breakp*'-P'*) response="${MOCK_TMUX_BREAK_WINDOW_ID:-@99}" ;;
      *splitw*'-P'*) response="${MOCK_TMUX_SPLIT_PANE_ID:-%99}" ;;
      *) response="" ;;
    esac
    # `_run_shell` has the command write its output and exit status to files
    # (packages/tmuxy-cli/bin/tmuxy/_lib) rather than through run-shell. Play the command:
    # write what it would have printed, and the status, where the CLI reads
    # them; run-shell itself succeeds. A verb's own run-shell (tmuxy-core
    # `run_shell`) quotes the paths only when they need it, and a quoted one
    # may hold a space (macOS's ~/Library/Application Support).
    dir=$(printf '%s' "$2" | sed -n "s/.*>'\([^']*\)\/out' 2>.*/\1/p")
    [ -n "$dir" ] || dir=$(printf '%s' "$2" | sed -n "s/.*>\([^' ]*\)\/out 2>.*/\1/p")
    # `pane run` splits off a wrapper script that records the program's exit
    # status beside itself; MOCK_TMUX_RUN_STATUS plays the program.
    run_dir=$(printf '%s' "$2" | sed -n "s/.*bash \(\/[^ ']*tmuxy-run\.[^ ']*\)\/run\.sh.*/\1/p")
    if [ -n "$run_dir" ] && [ -n "${MOCK_TMUX_RUN_STATUS:-}" ]; then
      echo "$MOCK_TMUX_RUN_STATUS" > "$run_dir/status"
    fi
    if [ -n "$dir" ]; then
      [ -n "$response" ] && echo "$response" > "$dir/out"
      echo "$exit_code" > "$dir/status"
      exit 0
    fi
    [ -n "$response" ] && echo "$response"
    ;;
  break-pane)
    ;;
  -V)
    echo "tmux ${MOCK_TMUX_VERSION:-3.5a}"
    ;;
  *)
    ;;
esac

exit "$exit_code"
