#!/bin/bash
# Mock tmuxy-server binary for CLI tests
if [ "${1:-} ${2:-}" = "agent state" ]; then
  # What an agent event means is the real binary's (agents.rs); here it is
  # whatever the test says it is.
  cat >/dev/null
  echo "${MOCK_AGENT_STATE:-}"
  exit 0
fi
# The snapshot listing (`name<TAB>saved<TAB>state` per line), when a test names some.
if [ "${1:-} ${2:-}" = "session snapshots" ] && [ -n "${MOCK_SERVER_SNAPSHOTS:-}" ]; then
  printf '%b\n' "$MOCK_SERVER_SNAPSHOTS"
  exit 0
fi
# A float (`float-create`): its command line goes to MOCK_SERVER_LOG, a
# wrapper script it runs (`--command 'bash <wrapper>'`) is played as the
# float's pane would run it, and its pane and window ids are the answer.
if [ "${1:-}" = float ]; then
  [ -n "${MOCK_SERVER_LOG:-}" ] && printf '%s\n' "$*" >> "$MOCK_SERVER_LOG"
  while [ $# -gt 0 ]; do
    if [ "$1" = --command ] && [[ "${2:-}" == "bash /"*tmuxy-float-cmd.* ]]; then
      bash "${2#bash }" </dev/null
    fi
    shift
  done
  echo "${MOCK_FLOAT_IDS:-%99 @98}"
  exit 0
fi
echo "mock-server-started $*"
