#!/bin/bash
# Mock tmuxy-server binary for CLI tests
if [ "${1:-} ${2:-}" = "agent state" ]; then
  # What an agent event means is the real binary's (agents.rs); here it is
  # whatever the test says it is.
  cat >/dev/null
  echo "${MOCK_AGENT_STATE:-}"
  exit 0
fi
# The snapshot listing (`name<TAB>saved<TAB>state` per line), when a test names some.
if [ "${1:-} ${2:-}" = "session snapshots" ] && [ -n "${MOCK_SERVER_SNAPSHOTS:-}" ]; then
  printf '%b\n' "$MOCK_SERVER_SNAPSHOTS"
  exit 0
fi
# Whether a word is a plugin's verb: only the ones a test names.
if [ "${1:-} ${2:-}" = "plugin resolve-verb" ]; then
  case " ${MOCK_PLUGIN_VERBS:-} " in
    *" ${3:-} "*) exit 0 ;;
  esac
  exit 1
fi
echo "mock-server-started $*"
